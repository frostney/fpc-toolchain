+}
+unit optexcregvar;
+
+{ A procedure with an explicit try..except or try..finally gets no register
+  variables (tabstractvarsym.is_regvar, pi_uses_exceptions): when an exception
+  is raised in the protected block, the handler and the code after the try
+  statement are reached with the registers of the setjmp at the start of the
+  block (callee-saved ones restored, the others undefined), so a value that the
+  block wrote to a register variable would be lost.
+
+  mark_exceptsafe_regvars marks the local variables and parameters that may be
+  register variables all the same (tabstractnormalvarsym.exceptsafe_regvar).
+  A variable is safe unless, for some try statement with protected block R,
+
+  - it is written in R and referenced anywhere outside R (in a handler, a
+    finally block, before or after the try statement, or implicitly at the
+    end of the procedure like the function result), or
+  - it is written in R, the try statement can be entered again in the same
+    invocation (it is inside a loop) and R can read it before it writes it,
+    so the value of an earlier run of R (lost by the exception) would be read.
+
+  A variable that R does not write keeps its value in a callee-saved register
+  (setjmp/longjmp save and restore them) or in its spill slot. A variable
+  that only R references and that R writes before it reads is dead when R is
+  left by an exception. Procedures with labels keep the old rule. }
+
+{$i fpcdefs.inc}
+
+interface
+
+uses
+  node,symdef;
+
+procedure mark_exceptsafe_regvars(code: tnode; pd: tprocdef);
+
+implementation
+
+uses
+  cclasses,
+  globtype,globals,
+  symconst,symbase,symtype,symsym,symtable,
+  procinfo,
+  nutils,nbas,nld,nflw;
+
+type
+  tboolarray = array of boolean;
+  tlongintarray = array of longint;
+
+  pexcregvarinfo = ^texcregvarinfo;
+  texcregvarinfo = record
+    cands: TFPList;           { the candidate tabstractnormalvarsyms }
+    counts: tlongintarray;    { references, filled by count_refs }
+    written: tboolarray;      { written in the scanned tree, filled by count_refs }
+    trys: TFPList;            { try nodes, filled by collect_nodes }
+    loops: TFPList;           { loop nodes, filled by collect_nodes }
+    looptrys: TFPList;        { try nodes inside a loop }
+    { exposure walk }
+    assigned_: tboolarray;
+    exposed: tboolarray;
+  end;
+
+
+function candidx(info: pexcregvarinfo; n: tnode): longint;
+  begin
+    result:=-1;
+    if (n.nodetype=loadn) and
+       (tloadnode(n).symtableentry.typ in [localvarsym,paravarsym]) then
+      result:=info^.cands.IndexOf(tloadnode(n).symtableentry);
+  end;
+
+
+function count_refs(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pexcregvarinfo absolute arg;
+    i: longint;
+  begin
+    result:=fen_false;
+    i:=candidx(info,n);
+    if i>=0 then
+      begin
+        inc(info^.counts[i]);
+        if (n.flags*[nf_write,nf_modify])<>[] then
+          info^.written[i]:=true;
+      end;
+  end;
+
+
+function collect_nodes(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pexcregvarinfo absolute arg;
+  begin
+    result:=fen_false;
+    case n.nodetype of
+      tryexceptn:
+        info^.trys.Add(n);
+      tryfinallyn:
+        if not ttryfinallynode(n).implicitframe then
+          info^.trys.Add(n);
+      whilerepeatn,forn:
+        info^.loops.Add(n);
+      else
+        ;
+    end;
+  end;
+
+
+function collect_looptrys(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pexcregvarinfo absolute arg;
+  begin
+    result:=fen_false;
+    if (n.nodetype in [tryexceptn,tryfinallyn]) and
+       (info^.looptrys.IndexOf(n)<0) then
+      info^.looptrys.Add(n);
+  end;
+
+
+{ any load of a candidate that is not definitely assigned yet is a read that
+  can see a value from before the walked block }
+function check_reads(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pexcregvarinfo absolute arg;
+    i: longint;
+  begin
+    result:=fen_false;
+    i:=candidx(info,n);
+    if (i>=0) and not info^.assigned_[i] then
+      info^.exposed[i]:=true;
+  end;
+
+
+procedure check_reads_in(info: pexcregvarinfo; n: tnode);
+  begin
+    if assigned(n) then
+      foreachnodestatic(n,@check_reads,info);
+  end;
+
+
+procedure walk(info: pexcregvarinfo; n: tnode);
+  var
+    saved, thenset: tboolarray;
+    i: longint;
+  begin
+    if not assigned(n) then
+      exit;
+    case n.nodetype of
+      blockn:
+        walk(info,tblocknode(n).left);
+      statementn:
+        begin
+          while assigned(n) and (n.nodetype=statementn) do
+            begin
+              walk(info,tstatementnode(n).left);
+              n:=tstatementnode(n).right;
+            end;
+          walk(info,n);
+        end;
+      assignn:
+        begin
+          check_reads_in(info,tassignmentnode(n).right);
+          i:=candidx(info,tassignmentnode(n).left);
+          if (i>=0) and
+             (nf_write in tassignmentnode(n).left.flags) and
+             not(nf_modify in tassignmentnode(n).left.flags) then
+            info^.assigned_[i]:=true
+          else
+            { a partial write (field, element) also reads the variable }
+            check_reads_in(info,tassignmentnode(n).left);
+        end;
+      ifn:
+        begin
+          check_reads_in(info,tifnode(n).left);
+          saved:=copy(info^.assigned_);
+          walk(info,tifnode(n).right);
+          thenset:=info^.assigned_;
+          info^.assigned_:=copy(saved);
+          walk(info,tifnode(n).t1);
+          { definitely assigned after the if: on both paths }
+          for i:=0 to high(thenset) do
+            info^.assigned_[i]:=info^.assigned_[i] and thenset[i];
+        end;
+      whilerepeatn:
+        begin
+          { the body and condition may run zero or more times; what they
+            assign does not count afterwards }
+          saved:=copy(info^.assigned_);
+          if lnf_testatbegin in twhilerepeatnode(n).loopflags then
+            begin
+              check_reads_in(info,twhilerepeatnode(n).left);
+              walk(info,twhilerepeatnode(n).right);
+            end
+          else
+            begin
+              walk(info,twhilerepeatnode(n).right);
+              check_reads_in(info,twhilerepeatnode(n).left);
+            end;
+          info^.assigned_:=saved;
+        end;
+      tryexceptn,tryfinallyn:
+        begin
+          saved:=copy(info^.assigned_);
+          walk(info,tbinarynode(n).left);
+          info^.assigned_:=copy(saved);
+          check_reads_in(info,tbinarynode(n).right);
+          if n.nodetype=tryexceptn then
+            check_reads_in(info,ttryexceptnode(n).t1)
+          else
+            check_reads_in(info,ttryfinallynode(n).third);
+          info^.assigned_:=saved;
+        end;
+      raisen,exitn,breakn,continuen,goton:
+        begin
+          check_reads_in(info,n);
+          { the code after a jump is not reached from here: on this path
+            everything counts as assigned (neutral for the if merge) }
+          for i:=0 to high(info^.assigned_) do
+            info^.assigned_[i]:=true;
+        end;
+      else
+        { everything else: every load is a read, nothing counts as assigned }
+        check_reads_in(info,n);
+    end;
+  end;
+
+
+procedure mark_exceptsafe_regvars(code: tnode; pd: tprocdef);
+  var
+    info: texcregvarinfo;
+    unsafe: tboolarray;
+    total: tlongintarray;
+    st: tsymtable;
+    sym: tsym;
+    i,j,k: longint;
+    t: tnode;
+    inloop: boolean;
+  begin
+    info.cands:=TFPList.Create;
+    info.trys:=TFPList.Create;
+    info.loops:=TFPList.Create;
+    info.looptrys:=TFPList.Create;
+    try
+      for k:=0 to 1 do
+        begin
+          if k=0 then
+            st:=pd.parast
+          else
+            st:=pd.localst;
+          if not assigned(st) then
+            continue;
+          for i:=0 to st.SymList.Count-1 do
+            begin
+              sym:=tsym(st.SymList[i]);
+              if sym.typ in [localvarsym,paravarsym] then
+                begin
+                  tabstractnormalvarsym(sym).exceptsafe_regvar:=false;
+                  info.cands.Add(sym);
+                end;
+            end;
+        end;
+      if (info.cands.Count=0) or
+         not(pi_uses_exceptions in current_procinfo.flags) or
+         not(cs_opt_regvar in current_settings.optimizerswitches) or
+         ((current_procinfo.flags*[pi_has_label,pi_has_interproclabel,pi_has_assembler_block])<>[]) then
+        exit;
+
+      setlength(unsafe,info.cands.Count);
+      setlength(total,info.cands.Count);
+      setlength(info.counts,info.cands.Count);
+      setlength(info.written,info.cands.Count);
+      setlength(info.assigned_,info.cands.Count);
+      setlength(info.exposed,info.cands.Count);
+
+      { the function result and self are also read at the end of the procedure }
+      for i:=0 to info.cands.Count-1 do
+        if (tabstractnormalvarsym(info.cands[i]).varoptions*[vo_is_funcret,vo_is_result,vo_is_self])<>[] then
+          total[i]:=1;
+
+      foreachnodestatic(code,@count_refs,@info);
+      for i:=0 to info.cands.Count-1 do
+        inc(total[i],info.counts[i]);
+
+      foreachnodestatic(code,@collect_nodes,@info);
+      for i:=0 to info.loops.Count-1 do
+        begin
+          t:=tnode(info.loops[i]);
+          foreachnodestatic(t,@collect_looptrys,@info);
+        end;
+
+      for j:=0 to info.trys.Count-1 do
+        begin
+          t:=tnode(info.trys[j]);
+          inloop:=info.looptrys.IndexOf(t)>=0;
+          for i:=0 to info.cands.Count-1 do
+            begin
+              info.counts[i]:=0;
+              info.written[i]:=false;
+            end;
+          if assigned(tbinarynode(t).left) then
+            foreachnodestatic(tbinarynode(t).left,@count_refs,@info);
+
+          if inloop then
+            begin
+              for i:=0 to info.cands.Count-1 do
+                begin
+                  info.assigned_[i]:=false;
+                  info.exposed[i]:=false;
+                end;
+              walk(@info,tbinarynode(t).left);
+            end;
+          for i:=0 to info.cands.Count-1 do
+            if info.written[i] and
+               ((total[i]>info.counts[i]) or
+                (inloop and info.exposed[i])) then
+              unsafe[i]:=true;
+        end;
+
+      for i:=0 to info.cands.Count-1 do
+        tabstractnormalvarsym(info.cands[i]).exceptsafe_regvar:=not unsafe[i];
+    finally
+      info.cands.Free;
+      info.trys.Free;
+      info.loops.Free;
+      info.looptrys.Free;
+    end;
+  end;
+
+end.
