diff --git a/tests/test/texcregvar1.pp b/tests/test/texcregvar1.pp
new file mode 100644
index 00000000..8a589ff3
--- /dev/null
+++ b/tests/test/texcregvar1.pp
@@ -0,0 +1,235 @@
+{ %OPT=-O3 }
+{ register variables in procedures with try..except/finally: values written
+  in the protected block before an exception must be seen by the handler,
+  after the try statement, in the next loop iteration and in the result }
+program texcregvar1;
+
+{$mode objfpc}
+
+uses
+  sysutils;
+
+var
+  errors: longint = 0;
+  zero: longint = 0;
+
+procedure check(got, expected: int64; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+procedure boom(i: longint);
+begin
+  if i >= 0 then
+    raise Exception.Create('boom');
+end;
+
+{ written in the block, read in the handler }
+function inhandler(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 1;
+  try
+    for i := 1 to n do
+      x := x * 3 + i;
+    boom(0);
+  except
+    result := x;
+    exit;
+  end;
+  result := -1;
+end;
+
+{ written in the block, read after the try statement }
+function after(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  try
+    for i := 1 to n do
+      x := x + i;
+    boom(zero);
+    x := -100;
+  except
+  end;
+  result := x;
+end;
+
+{ try in a loop: the block reads the value of the previous run }
+function loopcarried(n: longint): int64;
+var
+  acc, k: int64;
+  i: longint;
+begin
+  acc := 0;
+  k := 0;
+  for i := 1 to n do
+    try
+      acc := acc + k;
+      k := k + i;
+      if i mod 3 = 0 then
+        boom(i);
+      k := k * 2;
+    except
+    end;
+  result := acc * 1000 + k;
+end;
+
+{ the result written in the block }
+function resultinblock(n: longint): int64;
+var
+  i: longint;
+begin
+  result := 0;
+  try
+    for i := 1 to n do
+      result := result + i * i;
+    boom(n);
+    result := -1;
+  except
+  end;
+end;
+
+{ a value parameter written in the block }
+function paraminblock(n: longint): int64;
+begin
+  try
+    n := n * 7;
+    boom(n);
+    n := 0;
+  except
+  end;
+  result := n;
+end;
+
+{ nested try statements }
+function nested(n: longint): int64;
+var
+  a, b: int64;
+begin
+  a := 1;
+  b := 2;
+  try
+    a := a + n;
+    try
+      b := b + a;
+      boom(0);
+      b := 0;
+    except
+      a := a * 10 + b;
+    end;
+    boom(0);
+    a := 0;
+  except
+    a := a + 1;
+  end;
+  result := a * 100 + b;
+end;
+
+{ try..finally: the finally block sees the value }
+function infinally(n: longint): int64;
+var
+  x: int64;
+  seen: int64;
+begin
+  seen := 0;
+  x := 5;
+  try
+    try
+      x := x + n;
+      boom(0);
+      x := 0;
+    finally
+      seen := x;
+    end;
+  except
+  end;
+  result := seen * 10 + x;
+end;
+
+{ only the block uses these and writes them before reading: may be registers }
+function blocklocal(n: longint): int64;
+var
+  i: longint;
+  s, t: int64;
+begin
+  result := 0;
+  for i := 1 to n do
+    try
+      s := i;
+      t := s * s;
+      if t mod 5 = 0 then
+        boom(i);
+      result := result + t;
+    except
+      result := result + 1000;
+    end;
+end;
+
+{ read-only in the block, used after }
+function readonly(n: longint): int64;
+var
+  base: int64;
+  r: int64;
+begin
+  base := n * 11;
+  r := 0;
+  try
+    r := base + 1;
+    boom(0);
+  except
+    r := r + base;
+  end;
+  result := r + base;
+end;
+
+type
+  tpair = record
+    lo, hi: longint;
+  end;
+
+{ a record field written in the block, read in the loop condition }
+function recordfield(n: longint): int64;
+var
+  p: tpair;
+begin
+  p.lo := 0;
+  p.hi := n;
+  result := 0;
+  while p.lo < p.hi do
+    try
+      inc(p.lo);
+      result := result + p.lo;
+      if p.lo mod 4 = 0 then
+        boom(0);
+    except
+      result := result + 100;
+    end;
+end;
+
+begin
+  check(inhandler(5), 422, 'inhandler');
+  check(after(10), 55, 'after');
+  check(loopcarried(10), 1068734, 'loopcarried');
+  check(resultinblock(4), 30, 'resultinblock');
+  check(paraminblock(6), 42, 'paraminblock');
+  check(nested(3), 4706, 'nested');
+  check(infinally(4), 99, 'infinally');
+  check(blocklocal(12), 2525, 'blocklocal');
+  check(readonly(2), 67, 'readonly');
+  check(recordfield(10), 255, 'recordfield');
+  if errors <> 0 then
+    begin
+      writeln(errors, ' errors');
+      halt(1);
+    end;
+  writeln('ok');
+end.
