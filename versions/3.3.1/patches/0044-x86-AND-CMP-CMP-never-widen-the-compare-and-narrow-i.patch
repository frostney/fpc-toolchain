diff --git a/tests/tbs/tb9035.pp b/tests/tbs/tb9035.pp
new file mode 100644
index 00000000..174708dc
--- /dev/null
+++ b/tests/tbs/tb9035.pp
@@ -0,0 +1,62 @@
+{ %OPT=-O2 }
+{ the AND/CMP -> CMP peephole optimisation must not widen a byte compare
+  to the AND's mask size, and must not narrow a compare that feeds a signed
+  condition: after "and $255,%reg", the value is 0..255, but a byte compare
+  sees -128..127 }
+program tb9035;
+
+{$mode objfpc}
+
+function f1(a: longint): boolean;
+begin
+  result:=(a and $ff)<100;
+end;
+
+function f2(a: longint): boolean;
+begin
+  result:=(a and $ffff)<1000;
+end;
+
+function f3(a: longint): boolean;
+begin
+  result:=longint(a and $ff)>100;
+end;
+
+function f4(a: longint): boolean;
+begin
+  result:=shortint(a and $ffff)< -100;
+end;
+
+function f5(a: longint): boolean;
+begin
+  result:=smallint(a and $ff)<100;
+end;
+
+function f6(g: shortint): boolean;
+begin
+  result:=shortint(swap(word(g)))< -116;
+end;
+
+function f7(a: longint): boolean;
+begin
+  { unsigned/equality uses may still be narrowed }
+  result:=(a and $ff)=200;
+end;
+
+begin
+  if f1(200) then
+    halt(1);
+  if f2(40000) then
+    halt(2);
+  if not f3(200) then
+    halt(3);
+  if f4($ff00) then
+    halt(4);
+  if f5(200) then
+    halt(5);
+  if f6(-5) then
+    halt(6);
+  if not f7($1c8) then
+    halt(7);
+  writeln('ok');
+end.
