-      { in instructions: the reach is 8191, the margin covers data the count does not size exactly }
-      TB_LIMIT = 7000;
+      { the reach of tbz and tbnz in bytes from the instruction itself: a signed 14-bit count of instructions }
+      TB_MIN = -32768;
+      TB_MAX = 32764;
     var
       positions: TFPHashList;
 
-    { the size of hp in instructions (four bytes each), as far as the count needs it }
+    { the bytes hp can emit at most; at least what it emits, so a distance counted with it is never too short }
     function size_of(hp: tai): longint;
       begin
         case hp.typ of
           ait_instruction:
-            result:=1;
+            result:=4;
           ait_const:
-            result:=(tai_const(hp).size+3) div 4;
+            result:=tai_const(hp).size;
           ait_realconst:
-            result:=(tai_realconst(hp).savesize+3) div 4;
+            result:=tai_realconst(hp).savesize;
+          ait_string:
+            result:=tai_string(hp).len;
           ait_align:
-            result:=tai_align(hp).aligntype div 4;
+            { the padding is less than the alignment }
+            result:=tai_align(hp).aligntype;
           else
             result:=0;
         end;
       end;
 
-    { records the position of every label; false when the code has no tbz or tbnz, or is too small for one to be
-      out of reach }
+    { records the offset of every label, plus one so that offset 0 is not nil; false when the code has no tbz
+      or tbnz, or is too small for one to be out of reach }
     function find_labels: boolean;
       var
         hp: tai;
@@ -125,25 +129,27 @@ implementation
         while assigned(hp) do
           begin
             if hp.typ=ait_label then
-              positions.add(tai_label(hp).labsym.name,pointer(ptruint(pos)))
+              positions.add(tai_label(hp).labsym.name,pointer(ptruint(pos+1)))
             else if (hp.typ=ait_instruction) and (taicpu(hp).opcode in [A_TBZ,A_TBNZ]) then
               anytb:=true;
             inc(pos,size_of(hp));
             hp:=tai(hp.next);
           end;
-        result:=anytb and (pos>TB_LIMIT);
+        result:=anytb and (pos>TB_MAX);
       end;
 
-    { rewrites every tbz and tbnz whose label is out of reach; true when it rewrote any (each one adds an
-      instruction, which moves the labels after it) }
+    { rewrites every tbz and tbnz whose label is out of reach in the layout find_labels counted; true when it
+      rewrote any. The code it adds is not counted, so that both ends of every distance come from that layout;
+      it moves the labels after it, so the caller counts again. }
     function relax: boolean;
       var
         hp: tai;
-        pos: longint;
+        pos, dist: longint;
         p: pointer;
         sym: tasmsymbol;
         near: tasmlabel;
         jump: taicpu;
+        lab: tai_label;
         ref: treference;
       begin
         result:=false;
@@ -151,6 +157,7 @@ implementation
         hp:=tai(aktproccode.first);
         while assigned(hp) do
           begin
+            inc(pos,size_of(hp));
             if (hp.typ=ait_instruction) and
                (taicpu(hp).opcode in [A_TBZ,A_TBNZ]) and
                (taicpu(hp).ops=3) and
@@ -159,7 +166,9 @@ implementation
               begin
                 sym:=taicpu(hp).oper[2]^.ref^.symbol;
                 p:=positions.find(sym.name);
-                if assigned(p) and (abs(longint(ptruint(p))-pos)>TB_LIMIT) then
+                { the label's offset less the tbz's own, which is pos-4 }
+                dist:=longint(ptruint(p))-1-(pos-4);
+                if assigned(p) and ((dist<TB_MIN) or (dist>TB_MAX)) then
                   begin
                     { tbz reg,#bit,far  ->  tbnz reg,#bit,near; b far; near: }
                     if taicpu(hp).opcode=A_TBZ then
@@ -169,17 +178,19 @@ implementation
                     current_asmdata.getjumplabel(near);
                     reference_reset_symbol(ref,near,0,0,[]);
                     ref.refaddr:=addr_full;
+                    { loadref counts the reference to near; the b takes over the one to far }
                     taicpu(hp).loadref(2,ref);
-                    near.increfs;
+                    sym.decrefs;
                     jump:=taicpu.op_sym(A_B,sym);
                     jump.is_jmp:=true;
                     jump.fileinfo:=taicpu(hp).fileinfo;
-                    aktproccode.insertafter(tai_label.create(near),hp);
+                    lab:=tai_label.create(near);
+                    aktproccode.insertafter(lab,hp);
                     aktproccode.insertafter(jump,hp);
+                    hp:=lab;
                     result:=true;
                   end;
               end;
-            inc(pos,size_of(hp));
             hp:=tai(hp.next);
           end;
       end;
