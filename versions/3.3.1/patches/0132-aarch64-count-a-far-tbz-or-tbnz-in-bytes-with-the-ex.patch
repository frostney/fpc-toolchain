 compiler/aarch64/cpupi.pas |  47 ++-
 tests/test/opt/ttbz2.pp    | 779 +++++++++++++++++++++++++++++++++++++
 2 files changed, 808 insertions(+), 18 deletions(-)
 create mode 100644 tests/test/opt/ttbz2.pp

