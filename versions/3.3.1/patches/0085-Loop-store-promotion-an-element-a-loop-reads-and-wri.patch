diff --git a/tests/test/opt/tloopstore1.pp b/tests/test/opt/tloopstore1.pp
new file mode 100644
index 00000000..9f91c8fe
--- /dev/null
+++ b/tests/test/opt/tloopstore1.pp
@@ -0,0 +1,133 @@
+{ %OPT=-O3 }
+{ loop store promotion (optloop.optimize_loop_stores): an element the loop
+  reads and writes is kept in a register, stores still go to memory }
+program tloopstore1;
+
+{$mode objfpc}
+
+type
+  tdarr = array of double;
+  plong = ^longint;
+
+var
+  errors: longint = 0;
+
+procedure check(ok: boolean; const what: string);
+begin
+  if not ok then
+    begin
+      writeln('failed: ', what);
+      inc(errors);
+    end;
+end;
+
+{ the accumulation pattern }
+procedure mulav(const v: array of double; var av: array of double);
+var
+  i, j: longint;
+begin
+  for i := low(av) to high(av) do
+    begin
+      av[i] := 0.0;
+      for j := low(v) to high(v) do
+        av[i] := av[i] + (i + 1) * v[j];
+    end;
+end;
+
+{ the loop reads the promoted element through another index }
+procedure selfread(var a: array of longint; i: longint);
+var
+  j: longint;
+begin
+  for j := 0 to high(a) do
+    a[i] := a[i] + a[j];
+end;
+
+{ zero iterations with an invalid address: no speculative load }
+function zerotrip(p: plong; n: longint): longint;
+begin
+  while n > 0 do
+    begin
+      p^ := p^ + n;
+      dec(n);
+    end;
+  result := n;
+end;
+
+{ repeat..until }
+procedure rep(p: plong; n: longint);
+begin
+  repeat
+    p^ := p^ * 2 + 1;
+    dec(n);
+  until n <= 0;
+end;
+
+{ a store through another pointer that may alias: not promoted }
+procedure twoptr(p, q: plong; n: longint);
+var
+  i: longint;
+begin
+  for i := 1 to n do
+    begin
+      p^ := p^ + 1;
+      q^ := q^ + 10;
+    end;
+end;
+
+{ the address changes in the loop: not promoted }
+function walk(p: plong; n: longint): longint;
+var
+  i: longint;
+begin
+  result := 0;
+  for i := 1 to n do
+    begin
+      p^ := p^ + i;
+      result := result + p^;
+      inc(p);
+    end;
+end;
+
+var
+  v, av: tdarr;
+  a: array[0..3] of longint;
+  x, y: longint;
+  w: array[0..4] of longint;
+  i: longint;
+begin
+  setlength(v, 5);
+  setlength(av, 3);
+  for i := 0 to 4 do
+    v[i] := i;
+  mulav(v, av);
+  check((av[0] = 10) and (av[1] = 20) and (av[2] = 30), 'mulav');
+
+  a[0] := 1; a[1] := 2; a[2] := 3; a[3] := 4;
+  selfread(a, 1);
+  { a[1]: 2 -> 3 (+a0) -> 6 (+a1) -> 9 (+a2) -> 13 (+a3) }
+  check(a[1] = 13, 'selfread');
+
+  check(zerotrip(nil, 0) = 0, 'zerotrip');
+  x := 5;
+  check((zerotrip(@x, 3) = 0) and (x = 11), 'zerotrip 3');
+
+  x := 1;
+  rep(@x, 3);
+  check(x = 15, 'repeat');
+
+  x := 0;
+  twoptr(@x, @x, 3);
+  check(x = 33, 'twoptr alias');
+  x := 0; y := 0;
+  twoptr(@x, @y, 3);
+  check((x = 3) and (y = 30), 'twoptr');
+
+  for i := 0 to 4 do
+    w[i] := 100;
+  check(walk(@w[0], 5) = 515, 'walk');
+
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
