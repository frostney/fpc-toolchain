From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Fri, 16 Oct 2026 00:26:37 +0100
Subject: [PATCH 26/75] Keep the type-checked float type when folding
 Abs/Sqr/Sqrt of a constant late

setconstrealvalue and handle_sqrt_const always created an Extended
constant. When the fold happens after type checking (inlining or constant
propagation), the parent expects the Double/Single type it was checked
with: as a parameter this gave Internal error 200312205, in a Double
comparison silent wrong code (comisd read the 10-byte 4.0 as -0.0, -O3).
Also in 3.2.x through inlining.
---
 compiler/ninl.pas | 24 ++++++++++++++++++++----
 1 file changed, 20 insertions(+), 4 deletions(-)

diff --git a/compiler/ninl.pas b/compiler/ninl.pas
index 6730dad7..17b11132 100644
--- a/compiler/ninl.pas
+++ b/compiler/ninl.pas
@@ -2151,9 +2151,25 @@ implementation
         end;
 
 
+      { the type of a folded real constant: when simplifying an already
+        type-checked tree (inlining, constant propagation), the parent nodes
+        rely on the resultdef determined by the type check, which is the
+        argument's type for abs, sqr and sqrt }
+      function constrealdef : tdef;
+        begin
+          if forinline and
+             assigned(resultdef) and
+             (resultdef.typ=floatdef) and
+             (tfloatdef(resultdef).floattype in [s32real,s64real,s80real,sc80real]) then
+            result:=resultdef
+          else
+            result:=pbestrealtype^;
+        end;
+
+
       procedure setconstrealvalue(r : bestreal);
         begin
-           result:=crealconstnode.create(r,pbestrealtype^);
+           result:=crealconstnode.create(r,constrealdef);
         end;
 
 
@@ -2182,13 +2198,13 @@ implementation
           if r<0.0 then
             if floating_point_range_check_error then
                begin
-                 result:=crealconstnode.create(0,pbestrealtype^);
+                 result:=crealconstnode.create(0,constrealdef);
                  CGMessage(type_e_wrong_math_argument)
                end
             else
-              result:=crealconstnode.create(MathQNaN.Value,pbestrealtype^)
+              result:=crealconstnode.create(MathQNaN.Value,constrealdef)
           else
-            result:=crealconstnode.create(sqrt(r),pbestrealtype^)
+            result:=crealconstnode.create(sqrt(r),constrealdef)
         end;
 
 
