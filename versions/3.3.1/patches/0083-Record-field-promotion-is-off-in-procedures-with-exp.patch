From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Sat, 7 Nov 2026 00:53:34 +0000
Subject: [PATCH 083/113] Record field promotion is off in procedures with
 explicit exception handling

optloop._optimize_record_writes keeps the fields of a local record in
register temps for the duration of a loop. With setjmp based exception
handling, an exception in a protected block inside that loop restores the
registers to their values at the start of the block, so a field written in
the block before the exception was lost (a while loop on such a field never
ended), and a handler read the stale field from the record. Skip the
promotion when pi_uses_exceptions is set; tests/test/opt/trecprom1.pp hung
at -O3 before.
---
 compiler/optloop.pas        | 11 +++++++--
 tests/test/opt/trecprom1.pp | 47 +++++++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+), 2 deletions(-)
 create mode 100644 tests/test/opt/trecprom1.pp

diff --git a/compiler/optloop.pas b/compiler/optloop.pas
index cb5cce53..416e1c3d 100644
--- a/compiler/optloop.pas
+++ b/compiler/optloop.pas
@@ -863,9 +863,16 @@ unit optloop;
         result:=fen_false;
         record_limit:=RECORD_TEMP_LIMIT;
 
-        { Record promotion }
+        { Record promotion
+          Not in procedures with explicit exception handling: a field temp
+          written in a protected block lives in a register, which the setjmp
+          based exception handling restores to its value at the start of the
+          block, so the write would be lost (the loop could even go on forever
+          when the field is its counter), and a handler would read the stale
+          field from the record }
         if (n.nodetype=whilerepeatn) and
-          not (nf_internal in n.flags) then
+          not (nf_internal in n.flags) and
+          not (pi_uses_exceptions in current_procinfo.flags) then
           begin
             if foreachnodestatic(pm_postprocess,n,@discount_temprefs,@record_limit) and
               (record_limit<=0) then
diff --git a/tests/test/opt/trecprom1.pp b/tests/test/opt/trecprom1.pp
new file mode 100644
index 00000000..bcfdd9d3
--- /dev/null
+++ b/tests/test/opt/trecprom1.pp
@@ -0,0 +1,47 @@
+{ %OPT=-O3 }
+{ record field promotion (optloop) must not keep a field in a register across
+  a try block: the field written in the protected block before an exception
+  is lost when the setjmp restores the registers, and this loop never ends }
+program trecprom1;
+
+{$mode objfpc}
+
+uses
+  sysutils;
+
+type
+  tpair = record
+    lo, hi: longint;
+  end;
+
+procedure boom;
+begin
+  raise Exception.Create('boom');
+end;
+
+function recordfield(n: longint): int64;
+var
+  p: tpair;
+begin
+  p.lo := 0;
+  p.hi := n;
+  result := 0;
+  while p.lo < p.hi do
+    try
+      inc(p.lo);
+      result := result + p.lo;
+      if p.lo mod 4 = 0 then
+        boom;
+    except
+      result := result + 100 + p.lo;
+    end;
+end;
+
+begin
+  if recordfield(10) <> 267 then
+    begin
+      writeln('got ', recordfield(10), ', expected 267');
+      halt(1);
+    end;
+  writeln('ok');
+end.
