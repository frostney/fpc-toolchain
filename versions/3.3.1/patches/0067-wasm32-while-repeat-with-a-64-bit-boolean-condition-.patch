From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Thu, 22 Oct 2026 11:59:33 +0100
Subject: [PATCH 67/75] wasm32: while/repeat with a 64-bit boolean condition
 produced an invalid module

twasmwhilerepeatnode.pass_generate_code_condition loaded the condition
and applied i32.eqz/br_if to it whatever its size, so a QWordBool or
Boolean64 condition ("while q do", "repeat ... until b64") put an i64 on
the stack where an i32 is required: the module fails validation
("type mismatch: expected i32, found i64"). Compare it with 0 first, as
twasmifnode already does.

Test: tests/test/cg/tboolloop1.pp.
---
 compiler/wasm32/nwasmflw.pas |  9 +++++++++
 tests/test/cg/tboolloop1.pp  | 23 +++++++++++++++++++++++
 2 files changed, 32 insertions(+)
 create mode 100644 tests/test/cg/tboolloop1.pp

diff --git a/compiler/wasm32/nwasmflw.pas b/compiler/wasm32/nwasmflw.pas
index b749b1e1..0eb11e27 100644
--- a/compiler/wasm32/nwasmflw.pas
+++ b/compiler/wasm32/nwasmflw.pas
@@ -117,6 +117,15 @@ implementation
         secondpass(left);
         thlcgwasm(hlcg).a_load_loc_stack(current_asmdata.CurrAsmList,left.resultdef,left.location);
 
+        { a 64-bit boolean (QWordBool, Boolean64): compare with 0 as the if
+          node does; i32.eqz/br_if need an i32 }
+        if is_64bit(left.resultdef) then
+          begin
+            thlcgwasm(hlcg).a_load_const_stack(current_asmdata.CurrAsmList,left.resultdef,0,R_INTREGISTER);
+            current_asmdata.CurrAsmList.Concat(taicpu.op_none(a_i64_ne));
+            thlcgwasm(hlcg).decstack(current_asmdata.CurrAsmList,1);
+          end;
+
         // reversing the condition
         if not (lnf_checknegate in loopflags) then
           current_asmdata.CurrAsmList.concat(taicpu.op_none(a_i32_eqz));
diff --git a/tests/test/cg/tboolloop1.pp b/tests/test/cg/tboolloop1.pp
new file mode 100644
index 00000000..6039d10e
--- /dev/null
+++ b/tests/test/cg/tboolloop1.pp
@@ -0,0 +1,23 @@
+program tboolloop1;
+{ while and repeat loops with a 64-bit boolean condition (wasm32 emitted
+  i32.eqz on the i64 value: invalid module) }
+{$mode objfpc}
+var
+  q: QWordBool;
+  b64: Boolean64;
+  i: integer;
+begin
+  q := true; i := 0;
+  while q do begin inc(i); if i = 3 then q := false; end;
+  if i <> 3 then halt(1);
+  q := true; i := 0;
+  while q and (i < 3) do inc(i);
+  if i <> 3 then halt(2);
+  i := 0;
+  repeat inc(i) until q;
+  if i <> 1 then halt(3);
+  b64 := false; i := 0;
+  repeat inc(i); b64 := i >= 4 until b64;
+  if i <> 4 then halt(4);
+  writeln('ok');
+end.
