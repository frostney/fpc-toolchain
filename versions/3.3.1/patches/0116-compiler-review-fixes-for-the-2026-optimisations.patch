+
+{ the parts of a loop body that run in every iteration that reaches them:
+  not the branches of if and case statements, the bodies of inner loops that
+  test first, the right operand of a short-circuit and/or, or anything after
+  a statement that can leave the iteration }
+function hoist_uncond_expr(var n: tnode; arg: pointer): foreachnoderesult; forward;
+
+function hoist_uncond_expr_rec(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=hoist_uncond_expr(n,arg);
+  end;
+
+
+function hoist_uncond_expr(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    hi: phoistinfo absolute arg;
+  begin
+    result:=fen_false;
+    if (n.nodetype in [andn,orn]) and is_boolean(n.resultdef) then
+      begin
+        foreachnodestatic(pm_postprocess,taddnode(n).left,@hoist_uncond_expr_rec,arg);
+        exit(fen_norecurse_false);
+      end;
+    if hi^.packs then
+      result:=hoist_find_pack(n,arg)
+    else
+      result:=hoist_find(n,arg);
+  end;
+
+
+function leaves_iteration(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=fen_false;
+    if (n.nodetype in [breakn,continuen,exitn,goton,labeln,tryexceptn,tryfinallyn,raisen]) or
+       ((n.nodetype=calln) and (cnf_call_never_returns in tcallnode(n).callnodeflags)) then
+      result:=fen_norecurse_true;
+  end;
+
+
+procedure hoist_uncond(hi: phoistinfo; n: tnode);
+  var
+    s: tnode;
+  begin
+    if not assigned(n) then
+      exit;
+    case n.nodetype of
+      blockn:
+        hoist_uncond(hi,tblocknode(n).left);
+      statementn:
+        begin
+          s:=n;
