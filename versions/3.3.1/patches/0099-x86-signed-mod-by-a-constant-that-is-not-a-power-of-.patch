From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Sat, 7 Nov 2026 00:32:48 +0000
Subject: [PATCH 099/116] x86: signed mod by a constant that is not a power of
 2 multiplies by the magic number

The signed divn by such a constant already uses calc_divconst_magic_signed;
modn fell through to idiv (20-40+ cycles on current cores, 64-bit worse).
Compute the quotient the same way and subtract quotient * divisor. Not with
-Os, where idiv is shorter.
---
 compiler/x86/nx86mat.pas     | 43 +++++++++++++++++
 tests/test/opt/tmodconst1.pp | 89 ++++++++++++++++++++++++++++++++++++
 2 files changed, 132 insertions(+)
 create mode 100644 tests/test/opt/tmodconst1.pp

diff --git a/compiler/x86/nx86mat.pas b/compiler/x86/nx86mat.pas
index 18f67d9e..8c08689a 100644
--- a/compiler/x86/nx86mat.pas
+++ b/compiler/x86/nx86mat.pas
@@ -934,6 +934,49 @@ interface
             emit_reg_reg(A_SUB,opsize,hreg2,hreg1);
             location.register:=hreg1;
           end
+        else if (nodetype=modn) and (right.nodetype=ordconstn) and is_signed(left.resultdef) and
+          (left.resultdef.size in [4,8]) and not(cs_opt_size in current_settings.optimizerswitches) then
+          begin
+            { signed modulus by a constant that is not a power of 2: the quotient
+              as for the signed divn above (multiplication by the magic number),
+              then remainder = dividend - quotient * divisor }
+            e:=tordconstnode(right).value.svalue;
+            calc_divconst_magic_signed(resultdef.size*8,e,sm,s);
+            cg.getcpuregister(current_asmdata.CurrAsmList,rega);
+            emit_const_reg(A_MOV,opsize,sm,rega);
+            cg.getcpuregister(current_asmdata.CurrAsmList,regd);
+            emit_reg(A_IMUL,opsize,hreg1);
+            cg.ungetcpuregister(current_asmdata.CurrAsmList,rega);
+            if (e>0) and (sm<0) then
+              emit_reg_reg(A_ADD,opsize,hreg1,regd)
+            else if (e<0) and (sm>0) then
+              emit_reg_reg(A_SUB,opsize,hreg1,regd);
+            if (s<>0) then
+              emit_const_reg(A_SAR,opsize,s,regd);
+            { add the sign bit (of the dividend if e>0, of the estimate if e<0);
+              unlike divn, the dividend in hreg1 must survive }
+            hreg2:=cg.getintregister(current_asmdata.CurrAsmList,cgsize);
+            if (e<0) then
+              emit_reg_reg(A_MOV,opsize,regd,hreg2)
+            else
+              emit_reg_reg(A_MOV,opsize,hreg1,hreg2);
+            emit_const_reg(A_SHR,opsize,left.resultdef.size*8-1,hreg2);
+            emit_reg_reg(A_ADD,opsize,regd,hreg2);
+            cg.ungetcpuregister(current_asmdata.CurrAsmList,regd);
+            { hreg2 = quotient }
+{$ifdef x86_64}
+            if (cgsize in [OS_64,OS_S64]) and ((e>high(longint)) or (e<low(longint))) then { Cannot use 64-bit constants in IMUL }
+              begin
+                hreg3:=cg.getintregister(current_asmdata.CurrAsmList,cgsize);
+                emit_const_reg(A_MOV,opsize,e,hreg3);
+                emit_reg_reg(A_IMUL,opsize,hreg3,hreg2);
+              end
+            else
+{$endif x86_64}
+              emit_const_reg(A_IMUL,opsize,e,hreg2);
+            emit_reg_reg(A_SUB,opsize,hreg2,hreg1);
+            location.register:=hreg1;
+          end
         else
           begin
 DefaultDiv:
diff --git a/tests/test/opt/tmodconst1.pp b/tests/test/opt/tmodconst1.pp
new file mode 100644
index 00000000..ba332c48
--- /dev/null
+++ b/tests/test/opt/tmodconst1.pp
@@ -0,0 +1,89 @@
+{ %OPT=-O2 }
+{ signed mod by a constant that is not a power of 2 (x86: multiplication by
+  the magic number instead of idiv) against mod by the same divisor in a
+  variable }
+program tmodconst1;
+
+{$mode objfpc}
+
+var
+  errors: longint = 0;
+
+procedure check64(x, r, d: int64; c: int64);
+begin
+  if r <> x mod d then
+    begin
+      writeln('int64 ', x, ' mod ', c, ': got ', r, ', expected ', x mod d);
+      inc(errors);
+    end;
+end;
+
+procedure check32(x, r, d: longint; c: longint);
+begin
+  if r <> x mod d then
+    begin
+      writeln('longint ', x, ' mod ', c, ': got ', r, ', expected ', x mod d);
+      inc(errors);
+    end;
+end;
+
+procedure test64(x: int64);
+var
+  d: int64;
+begin
+  d := 3; check64(x, x mod 3, d, 3);
+  d := -3; check64(x, x mod -3, d, -3);
+  d := 7; check64(x, x mod 7, d, 7);
+  d := 10; check64(x, x mod 10, d, 10);
+  d := -10; check64(x, x mod -10, d, -10);
+  d := 139968; check64(x, x mod 139968, d, 139968);
+  d := 1000000007; check64(x, x mod 1000000007, d, 1000000007);
+  d := 6700417; check64(x, x mod 6700417, d, 6700417);
+  d := 10000000000; check64(x, x mod 10000000000, d, 10000000000);
+  d := -10000000000; check64(x, x mod -10000000000, d, -10000000000);
+  d := high(int64); check64(x, x mod high(int64), d, high(int64));
+  d := low(int64) + 1; check64(x, x mod (low(int64) + 1), d, low(int64) + 1);
+end;
+
+procedure test32(x: longint);
+var
+  d: longint;
+begin
+  d := 3; check32(x, x mod 3, d, 3);
+  d := -3; check32(x, x mod -3, d, -3);
+  d := 7; check32(x, x mod 7, d, 7);
+  d := 10; check32(x, x mod 10, d, 10);
+  d := -10; check32(x, x mod -10, d, -10);
+  d := 139968; check32(x, x mod 139968, d, 139968);
+  d := 641; check32(x, x mod 641, d, 641);
+  d := high(longint); check32(x, x mod high(longint), d, high(longint));
+  d := low(longint) + 1; check32(x, x mod (low(longint) + 1), d, low(longint) + 1);
+end;
+
+const
+  vals64: array[0..13] of int64 = (0, 1, -1, 2, -2, 6, -7, 139967, -139969,
+    1234567890123, -987654321987, high(int64), low(int64), low(int64) + 1);
+  vals32: array[0..11] of longint = (0, 1, -1, 2, -2, 6, -7, 139967, -139969,
+    high(longint), low(longint), low(longint) + 1);
+var
+  i: longint;
+  x: int64;
+begin
+  for i := low(vals64) to high(vals64) do
+    test64(vals64[i]);
+  for i := low(vals32) to high(vals32) do
+    test32(vals32[i]);
+  x := 42;
+  for i := 1 to 100000 do
+    begin
+      x := (x * 3877 + 29573) mod 139968;
+      test64(x * 65537 - 4000000000);
+      test32(longint(x) * 15331 - 1000000000);
+    end;
+  if errors <> 0 then
+    begin
+      writeln(errors, ' errors');
+      halt(1);
+    end;
+  writeln('ok');
+end.
