 tests/test/opt/ttbz2.inc   | 180 ++++++++++
 tests/test/opt/ttbz2.pp    | 670 ++++++-------------------------------
 3 files changed, 353 insertions(+), 607 deletions(-)
 create mode 100644 tests/test/opt/ttbz2.inc

diff --git a/compiler/aarch64/cpupi.pas b/compiler/aarch64/cpupi.pas
index 5cdf8932..850cc571 100644
--- a/compiler/aarch64/cpupi.pas
+++ b/compiler/aarch64/cpupi.pas
@@ -88,9 +88,12 @@ implementation
 
   procedure tcpuprocinfo.postprocess_code;
     const
-      { the reach of tbz and tbnz in bytes from the instruction itself: a signed 14-bit count of instructions }
+      { the reach in bytes from the branch itself: tbz and tbnz have a signed 14-bit count of instructions,
+        cbz, cbnz and b.cond a signed 19-bit one }
       TB_MIN = -32768;
       TB_MAX = 32764;
+      CB_MIN = -1048576;
+      CB_MAX = 1048572;
     var
       positions: TFPHashList;
 
@@ -106,6 +109,9 @@ implementation
             result:=tai_realconst(hp).savesize;
           ait_string:
             result:=tai_string(hp).len;
+          ait_datablock:
+            { inline .lcomm and .comm; written in place as .zero on some targets }
+            result:=tai_datablock(hp).size;
           ait_align:
             { the padding is less than the alignment }
             result:=tai_align(hp).aligntype;
@@ -114,37 +120,74 @@ implementation
         end;
       end;
 
-    { records the offset of every label, plus one so that offset 0 is not nil; false when the code has no tbz
-      or tbnz, or is too small for one to be out of reach }
+    { true when hp is a conditional branch to a label: its operand and its reach }
+    function is_cond_branch(hp: tai; out opidx, lo, hi: longint): boolean;
+      begin
+        result:=false;
+        if hp.typ<>ait_instruction then
+          exit;
+        case taicpu(hp).opcode of
+          A_TBZ,A_TBNZ:
+            begin
+              opidx:=2;
+              lo:=TB_MIN;
+              hi:=TB_MAX;
+            end;
+          A_CBZ,A_CBNZ:
+            begin
+              opidx:=1;
+              lo:=CB_MIN;
+              hi:=CB_MAX;
+            end;
+          A_B:
+            begin
+              if taicpu(hp).condition in [C_None,C_AL,C_NV] then
+                exit;
+              opidx:=0;
+              lo:=CB_MIN;
+              hi:=CB_MAX;
+            end;
+          else
+            exit;
+        end;
+        result:=(taicpu(hp).ops=opidx+1) and
+          (taicpu(hp).oper[opidx]^.typ=top_ref) and
+          assigned(taicpu(hp).oper[opidx]^.ref^.symbol);
+      end;
+
+    { records the offset of every label and symbol defined in the code, plus one so that offset 0 is not nil;
+      false when the code has no conditional branch, or is too small for one to be out of reach }
     function find_labels: boolean;
       var
         hp: tai;
-        pos: longint;
-        anytb: boolean;
+        pos, opidx, lo, hi: longint;
+        anybranch: boolean;
       begin
         positions.clear;
         pos:=0;
-        anytb:=false;
+        anybranch:=false;
         hp:=tai(aktproccode.first);
         while assigned(hp) do
           begin
             if hp.typ=ait_label then
               positions.add(tai_label(hp).labsym.name,pointer(ptruint(pos+1)))
-            else if (hp.typ=ait_instruction) and (taicpu(hp).opcode in [A_TBZ,A_TBNZ]) then
-              anytb:=true;
+            else if hp.typ=ait_symbol then
+              positions.add(tai_symbol(hp).sym.name,pointer(ptruint(pos+1)))
+            else if is_cond_branch(hp,opidx,lo,hi) then
+              anybranch:=true;
             inc(pos,size_of(hp));
             hp:=tai(hp.next);
           end;
-        result:=anytb and (pos>TB_MAX);
+        result:=anybranch and (pos>TB_MAX);
       end;
 
-    { rewrites every tbz and tbnz whose label is out of reach in the layout find_labels counted; true when it
-      rewrote any. The code it adds is not counted, so that both ends of every distance come from that layout;
-      it moves the labels after it, so the caller counts again. }
+    { rewrites every conditional branch whose label is out of reach in the layout find_labels counted; true
+      when it rewrote any. The code it adds is not counted, so that both ends of every distance come from that
+      layout; it moves the code after it, so the caller counts again. }
     function relax: boolean;
       var
         hp: tai;
-        pos, dist: longint;
+        pos, dist, opidx, lo, hi: longint;
         p: pointer;
         sym: tasmsymbol;
         near: tasmlabel;
@@ -158,28 +201,32 @@ implementation
         while assigned(hp) do
           begin
             inc(pos,size_of(hp));
-            if (hp.typ=ait_instruction) and
-               (taicpu(hp).opcode in [A_TBZ,A_TBNZ]) and
-               (taicpu(hp).ops=3) and
-               (taicpu(hp).oper[2]^.typ=top_ref) and
-               assigned(taicpu(hp).oper[2]^.ref^.symbol) then
+            if is_cond_branch(hp,opidx,lo,hi) then
               begin
-                sym:=taicpu(hp).oper[2]^.ref^.symbol;
+                sym:=taicpu(hp).oper[opidx]^.ref^.symbol;
                 p:=positions.find(sym.name);
-                { the label's offset less the tbz's own, which is pos-4 }
+                { the label's offset less the branch's own, which is pos-4 }
                 dist:=longint(ptruint(p))-1-(pos-4);
-                if assigned(p) and ((dist<TB_MIN) or (dist>TB_MAX)) then
+                if assigned(p) and ((dist<lo) or (dist>hi)) then
                   begin
-                    { tbz reg,#bit,far  ->  tbnz reg,#bit,near; b far; near: }
-                    if taicpu(hp).opcode=A_TBZ then
-                      taicpu(hp).opcode:=A_TBNZ
-                    else
-                      taicpu(hp).opcode:=A_TBZ;
+                    { tbz reg,#bit,far  ->  tbnz reg,#bit,near; b far; near:  (likewise cbz, cbnz and b.cond) }
+                    case taicpu(hp).opcode of
+                      A_TBZ:
+                        taicpu(hp).opcode:=A_TBNZ;
+                      A_TBNZ:
+                        taicpu(hp).opcode:=A_TBZ;
+                      A_CBZ:
+                        taicpu(hp).opcode:=A_CBNZ;
+                      A_CBNZ:
+                        taicpu(hp).opcode:=A_CBZ;
+                      else
+                        taicpu(hp).condition:=inverse_cond(taicpu(hp).condition);
+                    end;
                     current_asmdata.getjumplabel(near);
                     reference_reset_symbol(ref,near,0,0,[]);
                     ref.refaddr:=addr_full;
                     { loadref counts the reference to near; the b takes over the one to far }
-                    taicpu(hp).loadref(2,ref);
+                    taicpu(hp).loadref(opidx,ref);
                     sym.decrefs;
                     jump:=taicpu.op_sym(A_B,sym);
                     jump.is_jmp:=true;
@@ -197,10 +244,11 @@ implementation
 
     begin
       inherited postprocess_code;
-      { tbz and tbnz reach +-32 KiB. The peephole optimizer forms them from tst (or and plus cmp) and b.eq or b.ne
-        without knowing how far the label is, so in a large procedure one can point past its reach, which the
-        assembler refuses. One whose label is out of reach becomes the opposite test over an unconditional
-        branch, which reaches +-128 MiB. }
+      { tbz and tbnz reach +-32 KiB, cbz, cbnz and b.cond +-1 MiB. The peephole optimizer forms tbz and tbnz from
+        tst (or and plus cmp) and b.eq or b.ne without knowing how far the label is, so in a large procedure one
+        can point past its reach, which the assembler refuses. A conditional branch whose label is out of reach
+        becomes the opposite test over an unconditional branch, which reaches +-128 MiB. Each rewrite moves the
+        code after it, which can put another branch out of reach, so the pass repeats until none is. }
       positions:=TFPHashList.create;
       try
         while find_labels and relax do
