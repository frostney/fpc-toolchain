From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Fri, 16 Oct 2026 15:29:42 +0100
Subject: [PATCH 61/75] vcl-compat: System.IOUtils: do not call GetLastOSError
 on WASI

The wasm32-wasip1 crossall build stops in packages/vcl-compat:

  system.ioutils.pp(2299,12) Error: Identifier not found "GetLastOSError"

The WASI SysUtils does not provide GetLastOSError (rtl/wasicommon does
not define HAS_OSERROR), but RaiseDeleteError calls it unconditionally.
Use error code 0 on WASI. Without this the wasm32-wasip1 RTL and
packages cannot be built with "make crossall" at all.
---
 packages/vcl-compat/src/system.ioutils.pp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/packages/vcl-compat/src/system.ioutils.pp b/packages/vcl-compat/src/system.ioutils.pp
index 4ce9f626..7b1eb189 100644
--- a/packages/vcl-compat/src/system.ioutils.pp
+++ b/packages/vcl-compat/src/system.ioutils.pp
@@ -2296,7 +2296,11 @@ var
   lCode: Integer;
   lError: EInOutError;
 begin
+  {$ifndef WASI}
   lCode:=GetLastOSError;
+  {$else}
+  lCode:=0; { the WASI sysutils has no GetLastOSError (HAS_OSERROR unset) }
+  {$endif}
   lError:=EInOutError.CreateFmt(SErrDeleteDir, [aPath, SysErrorMessage(lCode)]);
   lError.ErrorCode:=lCode;
   raise lError;
