diff --git a/tests/tppu/reloadhelper/reloadhelper_child.pas b/tests/tppu/reloadhelper/reloadhelper_child.pas
new file mode 100644
index 00000000..29172656
--- /dev/null
+++ b/tests/tppu/reloadhelper/reloadhelper_child.pas
@@ -0,0 +1,28 @@
+unit reloadhelper_child;
+
+{$mode objfpc}
+
+interface
+
+uses reloadhelper_base;
+
+type
+  TBaseHelper = class helper for TBase
+    function Twice: LongInt;
+  end;
+
+procedure Accept(Value: TBase);
+
+implementation
+
+function TBaseHelper.Twice: LongInt;
+begin
+  Result:=Value*2;
+end;
+
+procedure Accept(Value: TBase);
+begin
+  Value.Value:=42;
+end;
+
+end.
diff --git a/tests/tppu/reloadhelper/reloadhelper_prg.pas b/tests/tppu/reloadhelper/reloadhelper_prg.pas
new file mode 100644
index 00000000..3e52134a
--- /dev/null
+++ b/tests/tppu/reloadhelper/reloadhelper_prg.pas
@@ -0,0 +1,15 @@
+program reloadhelper_prg;
+
+{$mode objfpc}
+
+uses reloadhelper_child, reloadhelper_control, reloadhelper_base;
+
+var
+  Value: TBase;
+begin
+  Value:=TBase.Create;
+  Test(Value);
+  if Value.Twice<>84 then
+    Halt(2);
+  Value.Free;
+end.
