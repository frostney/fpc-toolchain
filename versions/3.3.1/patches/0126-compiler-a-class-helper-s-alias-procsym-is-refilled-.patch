index 9c179c98..15001c31 100644
--- a/tests/tppu/tcrecompile.pas
+++ b/tests/tppu/tcrecompile.pas
@@ -64,6 +64,7 @@ type
     procedure TestPrgNameClash1; // prg name clash with unit
     procedure TestReloadClass; // loaded class parameters and inline bodies after dependency reload
     procedure TestReloadClassIs; // "is" on a loaded subclass after its parent unit is recompiled
+    procedure TestReloadClassHelper; // a loaded unit's class helper after a dependency reload
 
     // -Ur Generate release unit files (never automatically recompile ppu)
     procedure TestUr_ignoreinclude1; // ant->bird, change bird.inc
@@ -636,6 +637,33 @@ begin
   CheckCompiled(['reloadclass_prg.pas','reloadclass_base.pas','reloadclass_control.pas']);
 end;
 
+procedure TTestRecompile.TestReloadClassHelper;
+// child defines a class helper for TBase and stays loaded while control's new
+// CRC recompiles base: the helper's synthesized alias procsym has no stored
+// dereference data and must be refilled, not dereferenced
+var
+  Dir: String;
+begin
+  Dir:='reloadhelper';
+  UnitPath:=Dir+';'+Dir+PathDelim+'src1';
+  OutDir:=Dir+PathDelim+'ppus';
+  MainSrc:=Dir+PathDelim+'reloadhelper_prg.pas';
+  MakeDateDiffer(
+    Dir+PathDelim+'src1'+PathDelim+'reloadhelper_control.pas',
+    Dir+PathDelim+'src2'+PathDelim+'reloadhelper_control.pas');
+
+  Step:='First compile';
+  CleanOutputDir;
+  Compile;
+  CheckCompiled(['reloadhelper_prg.pas','reloadhelper_base.pas',
+    'reloadhelper_child.pas','reloadhelper_control.pas']);
+
+  Step:='Second compile';
+  UnitPath:=Dir+';'+Dir+PathDelim+'src2';
+  Compile;
+  CheckCompiled(['reloadhelper_prg.pas','reloadhelper_base.pas','reloadhelper_control.pas']);
+end;
+
 procedure TTestRecompile.TestReloadClassIs;
 // child defines TChild = class(TBase). Changing control recompiles base.
 // child.ppu stays loaded, so "Value is TChild" must see the new TBase.
