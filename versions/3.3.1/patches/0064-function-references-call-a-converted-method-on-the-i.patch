diff --git a/tests/test/tfuncref57.pp b/tests/test/tfuncref57.pp
new file mode 100644
index 00000000..42408ff3
--- /dev/null
+++ b/tests/test/tfuncref57.pp
@@ -0,0 +1,194 @@
+program tfuncref57;
+{ #42006 / F57: a method assigned to a function reference must run with the
+  Self of the object expression, evaluated at the assignment (Delphi) }
+{$mode delphi}
+{$modeswitch functionreferences}
+type
+  TProc = reference to procedure;
+  TLocal = class
+    v: Integer;
+    procedure Go;
+    class procedure CGo;
+  end;
+  TOwner = class
+    FObj: TLocal;
+    procedure Run;
+    procedure RunSelf;
+    procedure Go2;
+  end;
+  IGo = interface
+    procedure Go;
+  end;
+  TIntf = class(TInterfacedObject, IGo)
+    v: Integer;
+    procedure Go;
+  end;
+  TRec = record
+    v: Integer;
+    procedure Go;
+  end;
+var
+  Acc: Integer;
+  G: TLocal;
+  Fails: Integer;
+
+procedure TLocal.Go; begin Inc(Acc, v); end;
+class procedure TLocal.CGo; begin if ClassName = 'TLocal' then Inc(Acc, 7) else Inc(Acc, 1000000); end;
+procedure TIntf.Go; begin Inc(Acc, v); end;
+procedure TRec.Go; begin Inc(Acc, v); end;
+procedure TOwner.Go2; begin if ClassName = 'TOwner' then Inc(Acc, 3); end;
+
+procedure Check(const what: string; expected: Integer);
+begin
+  if Acc <> expected then
+    begin
+      writeln('FAIL ', what, ': ', Acc, ' expected ', expected);
+      Inc(Fails);
+    end;
+  Acc := 0;
+end;
+
+procedure TOwner.Run;
+var P: TProc;
+begin
+  P := FObj.Go;          { field of an unrelated class }
+  P();
+  Check('field', 11);
+end;
+
+procedure TOwner.RunSelf;
+var P: TProc;
+begin
+  P := Go2;              { implicit Self }
+  P();
+  P := Self.Go2;         { explicit Self }
+  P();
+  Check('self', 6);
+end;
+
+procedure FromParameter(O: TLocal);
+var P: TProc;
+begin
+  P := O.Go;
+  P();
+  Check('param', 12);
+end;
+
+procedure FromVarParameter(var O: TLocal);
+var P: TProc;
+begin
+  P := O.Go;
+  P();
+  Check('var param', 12);
+end;
+
+function MakeLocal(n: Integer): TProc;
+var L: TLocal;
+begin
+  L := TLocal.Create;
+  L.v := n;
+  Result := L.Go;
+  L := nil;              { Self was taken at the assignment }
+end;
+
+function GetObj: TLocal; begin Result := G; end;
+
+procedure FromCallAndCast;
+var P: TProc; o: TObject;
+begin
+  P := GetObj.Go;
+  P();
+  o := G;
+  P := TLocal(o).Go;
+  P();
+  Check('call/cast', 26);
+end;
+
+procedure FromLocalChanged;
+var L: TLocal; P: TProc; A, B: TLocal;
+begin
+  A := TLocal.Create; A.v := 1;
+  B := TLocal.Create; B.v := 2;
+  L := A;
+  P := L.Go;
+  L := B;
+  P();
+  Check('value at assignment', 1);
+  A.Free; B.Free;
+end;
+
+procedure FromClassMethods;
+var P: TProc; L: TLocal;
+begin
+  P := TLocal.CGo;
+  P();
+  L := G;
+  P := L.CGo;
+  P();
+  Check('class methods', 14);
+end;
+
+procedure FromInterface;
+var I: IGo; P: TProc; O: TIntf;
+begin
+  O := TIntf.Create; O.v := 21;
+  I := O;
+  P := I.Go;
+  P();
+  Check('interface', 21);
+end;
+
+procedure FromRecord;
+var R: TRec; P: TProc;
+begin
+  R.v := 31;
+  P := R.Go;
+  P();
+  Check('record', 31);
+end;
+
+procedure Nested;
+var L: TLocal;
+  procedure Inner;
+  var P: TProc;
+  begin
+    P := L.Go;
+    P();
+  end;
+begin
+  L := G;
+  Inner;
+  Check('nested', 13);
+end;
+
+procedure CallIt(const P: TProc); begin P(); end;
+
+var
+  Owner: TOwner;
+  P: TProc;
+  Obj: TLocal;
+begin
+  G := TLocal.Create; G.v := 13;
+  Owner := TOwner.Create;
+  Owner.FObj := TLocal.Create; Owner.FObj.v := 11;
+  Owner.Run;
+  Owner.RunSelf;
+
+  Obj := TLocal.Create; Obj.v := 12;
+  FromParameter(Obj);
+  FromVarParameter(Obj);
+  P := MakeLocal(100);
+  CallIt(P);
+  Check('local, later', 100);
+  FromCallAndCast;
+  FromLocalChanged;
+  FromClassMethods;
+  FromInterface;
+  FromRecord;
+  Nested;
+  P := Obj.Go;           { global in the main program (tfuncref9) }
+  P();
+  CallIt(Obj.Go);
+  Check('global', 24);
+  if Fails = 0 then writeln('ok') else halt(1);
+end.
diff --git a/tests/test/tfuncref58.pp b/tests/test/tfuncref58.pp
new file mode 100644
index 00000000..8634d751
--- /dev/null
+++ b/tests/test/tfuncref58.pp
@@ -0,0 +1,25 @@
+program tfuncref58;
+
+{ two conversions of the same procvar in one routine keep their own values }
+{$mode delphi}
+{$modeswitch functionreferences}
+type
+  TProc = reference to procedure;
+  TPlain = procedure;
+var Acc: Integer;
+procedure A; begin Inc(Acc, 1); end;
+procedure B; begin Inc(Acc, 10); end;
+procedure Run;
+var V: TPlain; P, Q: TProc;
+begin
+  V := A;
+  P := V;
+  V := B;
+  Q := V;
+  P(); Q();
+end;
+begin
+  Run;
+
+  if Acc <> 11 then halt(1);
+end.
diff --git a/tests/test/tfuncref59.pp b/tests/test/tfuncref59.pp
new file mode 100644
index 00000000..1aa88932
--- /dev/null
+++ b/tests/test/tfuncref59.pp
@@ -0,0 +1,125 @@
+program tfuncref59;
+{ #42006 follow-ups: lifetime of a captured interface, conversions inside
+  anonymous functions and methods, generic routines, record fields of Self }
+{$mode delphi}
+{$modeswitch functionreferences}
+{$modeswitch anonymousfunctions}
+type
+  TProc = reference to procedure;
+  IGo = interface procedure Go; end;
+  TIntf = class(TInterfacedObject, IGo)
+    v: Integer;
+    destructor Destroy; override;
+    procedure Go;
+  end;
+  TRec = record
+    v: Integer;
+    procedure Go;
+  end;
+  THolder = class
+    R: TRec;
+    function Make: TProc;
+  end;
+  TLocal = class
+    v: Integer;
+    procedure Go;
+  end;
+var
+  Acc, Destroyed, Fails: Integer;
+
+destructor TIntf.Destroy; begin Inc(Destroyed); inherited; end;
+procedure TIntf.Go; begin Inc(Acc, v); end;
+procedure TRec.Go; begin Inc(Acc, v); end;
+procedure TLocal.Go; begin Inc(Acc, v); end;
+function THolder.Make: TProc; begin Result := R.Go; end;
+
+procedure Check(const what: string; got, expected: Integer);
+begin
+  if got <> expected then
+    begin
+      writeln('FAIL ', what, ': ', got, ' expected ', expected);
+      Inc(Fails);
+    end;
+  Acc := 0;
+end;
+
+function MakeIntf(n: Integer): TProc;
+var I: IGo; O: TIntf;
+begin
+  O := TIntf.Create; O.v := n;
+  I := O;
+  Result := I.Go;
+end;
+
+procedure IntfLife;
+var P: TProc;
+begin
+  P := MakeIntf(5);
+  P(); P();
+  Check('interface', Acc, 10);
+  Check('interface alive', Destroyed, 0);
+  P := nil;
+  Check('interface released', Destroyed, 1);
+end;
+
+function NewLocal(n: Integer): TLocal; begin Result := TLocal.Create; Result.v := n; end;
+
+function Outer(n: Integer): TProc;
+var L: TLocal;
+begin
+  L := TLocal.Create; L.v := n;
+  Result := function: TProc
+    begin
+      Result := L.Go;
+    end();
+end;
+
+function GenMake<T: TLocal>(o: T): TProc;
+begin
+  Result := o.Go;
+end;
+
+procedure Twice;
+var A, B: TLocal; P, Q: TProc;
+begin
+  A := TLocal.Create; A.v := 1;
+  B := TLocal.Create; B.v := 20;
+  P := A.Go; Q := B.Go;
+  P(); Q();
+  Check('two instances, one routine', Acc, 21);
+  A.Free; B.Free;
+end;
+
+procedure Loop;
+var L: array[0..2] of TLocal; P: array[0..2] of TProc; i: Integer;
+begin
+  for i := 0 to 2 do
+    begin
+      L[i] := TLocal.Create; L[i].v := 1 shl (i * 4);
+      P[i] := L[i].Go;
+    end;
+  for i := 0 to 2 do P[i]();
+  { one conversion site in a loop: one capturer per routine, so all three
+    share the last instance (as anonymous functions share captured locals) }
+  Check('loop', Acc, 3 * $100);
+end;
+
+var
+  P: TProc;
+  H: THolder;
+begin
+  IntfLife;
+  P := Outer(7);
+  P();
+  Check('anonymous', Acc, 7);
+  P := GenMake<TLocal>(NewLocal(4));
+  P();
+  Check('generic', Acc, 4);
+  H := THolder.Create; H.R.v := 9;
+  P := H.Make;
+  P();
+  Check('record field of Self', Acc, 9);
+  Twice;
+  Loop;
+  if Fails = 0 then writeln('ok') else halt(1);
+end.
