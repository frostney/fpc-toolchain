+{ Exp: at most 1 ulp error, results down to the smallest subnormal, and the
+  largest finite result (follow-up of issue #41837) }
+program texpacc;
+
+{$mode objfpc}{$h+}
+
+uses
+  Math;
+
+type
+  TExpCase = record
+    x: QWord;
+    ref: QWord;
+  end;
+
+const
+  { bit patterns of x and of the correctly rounded exp(x) }
+  Cases: array[1..26] of TExpCase = (
+    { arguments where the SSE2 exp of 3.3.1 (2025-2026) was 2 ulp off }
+    (x: QWord($BFB466B3933FE345); ref: QWord($3FED8C7F73C019FF)), { exp(-0.0796921) }
+    (x: QWord($BFB82F405F6BA062); ref: QWord($3FED1D866332C366)), { exp(-0.094471) }
+    (x: QWord($BF90BB3270959451); ref: QWord($3FEF7B3CD6F51C82)), { exp(-0.0163391) }
+    (x: QWord($3FDAFB3FA6DEFC7A); ref: QWord($3FF863D7DAEF5FD7)), { exp(0.421585) }
+    (x: QWord($3FE37F562174C4CE); ref: QWord($3FFD6D1636B60CBA)), { exp(0.609294) }
+    (x: QWord($BFF007A8D64D7F0F); ref: QWord($3FD78013804AD37C)), { exp(-1.00187) }
+    (x: QWord($4041EBE0DED288CE); ref: QWord($432A2D5230961325)), { exp(35.8428) }
+    (x: QWord($4015F78AB0C88A48); ref: QWord($406E55BB32BB8DD6)), { exp(5.49174) }
+    (x: QWord($402A397F62B6AE7D); ref: QWord($411E36462D8AB4D4)), { exp(13.1123) }
+    (x: QWord($C0303E425AEE6320); ref: QWord($3E77AFD6F9B61FDB)), { exp(-16.2432) }
+    (x: QWord($C03E90AA64C2F838); ref: QWord($3D2DEFFFF211F84F)), { exp(-30.5651) }
+    (x: QWord($C036F2B6AE7D566D); ref: QWord($3DDDB5D46B138B67)), { exp(-22.9481) }
+    (x: QWord($4069F7D70A3D70A4); ref: QWord($52AA38B7BF22A8D3)), { exp(207.745) }
+    (x: QWord($4084BAA5E353F7CF); ref: QWord($7BBFA7952BC60034)), { exp(663.331) }
+    (x: QWord($407F1A147AE147AE); ref: QWord($6CCE72FFD90BB673)), { exp(497.63) }
+    (x: QWord($C07822083126E979); ref: QWord($1D1E9F34E8D626BF)), { exp(-386.127) }
+    (x: QWord($C0819EA9FBE76C8B); ref: QWord($0D179A7CF3DA776F)), { exp(-563.833) }
+    (x: QWord($C06603CED916872B); ref: QWord($300E25E5A8541AF2)), { exp(-176.119) }
+    { subnormal results; the SSE2 exp returned 0 below -709.09 }
+    (x: QWord($C0862C0000000000); ref: QWord($00054E90C99FB878)), { exp(-709.5) }
+    (x: QWord($C086820000000000); ref: QWord($000000077564144F)), { exp(-720.25) }
+    (x: QWord($C087200000000000); ref: QWord($0000000000000055)), { exp(-740.0) }
+    (x: QWord($C087480000000000); ref: QWord($0000000000000001)), { exp(-745.0) }
+    (x: QWord($C0874910D52D3051); ref: QWord($0000000000000001)), { exp(-745.1332191019411) }
+    (x: QWord($C0874910D52D3052); ref: QWord($0000000000000000)), { exp(-745.1332191019412) }
+    { largest finite result; the SSE2 exp returned +Inf }
+    (x: QWord($40862E42FEFA39EF); ref: QWord($7FEFFFFFFFFFFF2A)), { exp(709.782712893384) }
+    (x: QWord($40862E42FEFA39F0); ref: QWord($7FF0000000000000))  { exp(709.7827128933841) }
+  );
+
+  MaxUlp = 1;
+
+function BitsToDouble(aBits: QWord): Double;
+begin
+  Move(aBits,Result,SizeOf(Result));
+end;
+
+function DoubleToBits(aValue: Double): QWord;
+begin
+  Move(aValue,Result,SizeOf(Result));
+end;
+
+var
+  i: Integer;
+  lValue: Double;
+  lGot, lDiff: QWord;
+  lFailed: Boolean;
+
+begin
+  SetExceptionMask([exInvalidOp,exDenormalized,exZeroDivide,exOverflow,exUnderflow,exPrecision]);
+  lFailed:=false;
+  for i:=Low(Cases) to High(Cases) do
+    begin
+    lValue:=Exp(BitsToDouble(Cases[i].x));
+    lGot:=DoubleToBits(lValue);
+    if lGot>Cases[i].ref then
+      lDiff:=lGot-Cases[i].ref
+    else
+      lDiff:=Cases[i].ref-lGot;
+    { a nonzero result must not become zero, a finite one not infinite }
+    if (lDiff>MaxUlp) or ((Cases[i].ref<>0) and (lGot=0)) or
+       ((Cases[i].ref<>QWord($7FF0000000000000)) and (lGot=QWord($7FF0000000000000))) then
+      begin
+      writeln('exp(',BitsToDouble(Cases[i].x),'): got ',HexStr(lGot,16),', expected ',HexStr(Cases[i].ref,16));
+      lFailed:=true;
+      end;
+    end;
+  if lFailed then
+    halt(1);
+  writeln('ok');
+end.
