From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Thu, 22 Oct 2026 03:11:48 +0100
Subject: [PATCH 58/75] x86 OptPass2SETcc: turn IMUL by 2,3,4,5,8,9 into a
 valid 2-operand LEA only

---
 compiler/x86/aoptx86.pas | 12 +++++++++--
 tests/tbs/tb9054.pp      | 45 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 55 insertions(+), 2 deletions(-)
 create mode 100644 tests/tbs/tb9054.pp

diff --git a/compiler/x86/aoptx86.pas b/compiler/x86/aoptx86.pas
index 5efeff13..940c3446 100644
--- a/compiler/x86/aoptx86.pas
+++ b/compiler/x86/aoptx86.pas
@@ -13411,11 +13411,15 @@ unit aoptx86;
                               A_IMUL:
                                 begin
                                   if (taicpu(next).ops <> 3) or
+                                    { LEA doesn't support 8-bit in general and 16-bit on x86-64 operands }
+                                    (taicpu(next).opsize in [S_B{$ifdef x86_64},S_W{$endif x86_64}]) or
+                                    (taicpu(next).oper[0]^.typ <> top_const) or
                                     (taicpu(next).oper[1]^.typ <> top_reg) or
                                     { Must write to a register }
-                                    (taicpu(next).oper[2]^.val in [2,3,4,5,8,9]) then
+                                    (taicpu(next).oper[2]^.typ <> top_reg) or
+                                    not (taicpu(next).oper[0]^.val in [2,3,4,5,8,9]) then
                                     { We can convert "imul x,%reg1,%reg2" (where x = 2, 4 or 8)
-                                      to "lea (%reg1,x),%reg2".  If x = 3, 5  or 9, we can
+                                      to "lea (,%reg1,x),%reg2".  If x = 3, 5  or 9, we can
                                       change this to "lea (%reg1,%reg1,(x-1)),%reg2" }
                                     Exit
                                   else
@@ -13500,7 +13504,11 @@ unit aoptx86;
                                     end;
                                 end;
 
+                                { imul x,%reg1,%reg2 -> lea ref,%reg2 }
                                 InstrList[Index].loadref(0, NewRef);
+                                InstrList[Index].loadreg(1, InstrList[Index].oper[2]^.reg);
+                                InstrList[Index].ops := 2;
+                                InstrList[Index].clearop(2);
                               end;
                             else
                               InternalError(2021051710);
diff --git a/tests/tbs/tb9054.pp b/tests/tbs/tb9054.pp
new file mode 100644
index 00000000..6b8eb0de
--- /dev/null
+++ b/tests/tbs/tb9054.pp
@@ -0,0 +1,45 @@
+{ %OPT=-O3 }
+{ x86 OptPass2SETcc: an IMUL between SETcc and TEST/Jcc was turned into a
+  three-operand LEA with the constant as scale factor ("leal
+  (%reg,%reg,231),%reg,%reg"), which the assembler rejects }
+program tb9054;
+
+{$mode objfpc}
+
+function g(a: smallint; p: longint): longint; noinline;
+var
+  b: boolean;
+  t: longint;
+begin
+  b:=a=0;
+  t:=p*1000;
+  if b then
+    g:=7
+  else
+    g:=t;
+end;
+
+function h(a: smallint; p: longint): longint; noinline;
+var
+  b: boolean;
+  t: longint;
+begin
+  b:=a=0;
+  t:=p*9;
+  if b then
+    h:=7
+  else
+    h:=t;
+end;
+
+begin
+  if g(0,3)<>7 then
+    halt(1);
+  if g(1,3)<>3000 then
+    halt(2);
+  if h(0,3)<>7 then
+    halt(3);
+  if h(1,3)<>27 then
+    halt(4);
+  writeln('ok');
+end.
