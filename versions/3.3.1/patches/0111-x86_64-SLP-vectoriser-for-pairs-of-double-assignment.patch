+unit optslp;
+
+{ Two consecutive statements
+
+    m1 := e1;
+    m2 := e2;
+
+  where m1 and m2 are adjacent doubles in memory (m2 at the address of m1
+  plus 8, through the same pointer or array element) and e1 and e2 have the
+  same shape (the same +, -, *, / operations) become one statement on a
+  two-element double vector (in_vec2d_* intrinsics, SSE2 packed operations):
+  pairs of adjacent loads become a vector load, equal operands a broadcast,
+  other operand pairs are packed.
+
+  The vector statement reads everything before it writes m1 and m2, so e2
+  must not read memory that may be m1. Memory accesses are compared as a
+  base (a pointer variable or temp, dereferenced, or an array element) plus
+  a field offset: with the same base, the offsets decide. With two pointer
+  variables whose every assignment is the address of an element of one array
+  of records (@a[i]), a copy of such a pointer, or inc/dec of it, both point
+  at whole elements of that array, so fields at different offsets do not
+  overlap (provenance). Anything else may alias, and the pair stays scalar.
+
+  Floating-point exceptions: with unmasked exceptions, an exception of the
+  second lane is raised before the first result is stored, where the scalar
+  code would have stored it. The optimisation is a separate optimizer
+  switch (SLP, on at -O4) for this reason. }
+
+{$i fpcdefs.inc}
+
+interface
+
+uses
+  node;
+
+function do_slp_vectorize(var code: tnode): boolean;
+
+implementation
+
+uses
+  cclasses,
+  globtype,globals,verbose,
+  symconst,symtype,symdef,symsym,symtable,
+  defutil,defcmp,compinnr,
+  nutils,nbas,nld,ncon,nflw,nmem,nadd,ncnv,ninl,ncal,
+  pass_1,procinfo,paramgr;
+
+
+function paramanager_push_addr(sym: tparavarsym): boolean;
+  begin
+    result:=paramanager.push_addr_param(sym.varspez,sym.vardef,current_procinfo.procdef.proccalloption);
+  end;
+
+type
+  tprovkind = (pk_unknown, pk_array);
+
+  pprovinfo = ^tprovinfo;
+  tprovinfo = record
+    { a pointer variable (sym) or temp (temp) }
+    sym: tabstractvarsym;
+    temp: ptempinfo;
+    kind: tprovkind;
+    arr: tabstractvarsym;   { the array the pointer points into }
+    copies: TFPList;        { pprovinfo of the pointers copied into this one }
+    bad: boolean;
+  end;
+
+  tslpctx = record
+    provs: TFPList;
+    changed: boolean;
+    vec2def: tdef;
+    pvec2def: tdef;
+  end;
+  pslpctx = ^tslpctx;
+
+  { a memory access: base node (deref of a pointer load/temp, or an array
+    element) plus a byte offset }
+  taccess = record
+    valid: boolean;
+    base: tnode;      { the derefn or vecn node (not owned) }
+    offset: asizeint;
+    size: asizeint;
+    recdef: tdef;     { the record type the offset is relative to }
+  end;
+
+
+{*****************************************************************************
+                           Pointer provenance
+*****************************************************************************}
+
+function findprov(ctx: pslpctx; n: tnode; create: boolean): pprovinfo;
+  var
+    i: longint;
+    sym: tabstractvarsym;
+    temp: ptempinfo;
+  begin
+    result:=nil;
+    sym:=nil;
+    temp:=nil;
+    if (n.nodetype=loadn) and
+       (tloadnode(n).symtableentry.typ in [localvarsym,paravarsym]) and
+       not assigned(tloadnode(n).left) then
+      sym:=tabstractvarsym(tloadnode(n).symtableentry)
+    else if n.nodetype=temprefn then
+      temp:=ttemprefnode(n).tempinfo
+    else
+      exit;
+    for i:=0 to ctx^.provs.Count-1 do
+      if (pprovinfo(ctx^.provs[i])^.sym=sym) and (pprovinfo(ctx^.provs[i])^.temp=temp) then
+        exit(pprovinfo(ctx^.provs[i]));
+    if not create then
+      exit;
+    new(result);
+    result^.sym:=sym;
+    result^.temp:=temp;
+    result^.kind:=pk_unknown;
+    result^.arr:=nil;
+    result^.copies:=TFPList.Create;
+    result^.bad:=false;
+    if assigned(sym) then
+      begin
+        if not(sym.vardef.typ=pointerdef) or
+           (vo_volatile in sym.varoptions) or
+           ((sym.varsymaccess*[vsa_addr_taken,vsa_different_scope])<>[]) or
+           ((sym.typ=paravarsym) and not(tparavarsym(sym).varspez in [vs_value,vs_const])) then
+          result^.bad:=true;
+      end
+    else if not assigned(temp^.typedef) or (temp^.typedef.typ<>pointerdef) then
+      result^.bad:=true;
+    ctx^.provs.Add(result);
+  end;
+
+
+function strip_conv(n: tnode): tnode;
+  begin
+    result:=n;
+    while (result.nodetype=typeconvn) and
+          (ttypeconvnode(result).convtype=tc_equal) do
+      result:=ttypeconvnode(result).left;
+  end;
+
+
+{ rhs assigned to the pointer p }
+procedure prov_assign(ctx: pslpctx; p: pprovinfo; rhs: tnode);
+  var
+    n: tnode;
+    q: pprovinfo;
+    arrsym: tabstractvarsym;
+  begin
+    n:=strip_conv(rhs);
+    { p + c, p - c, pointer arithmetic in elements }
+    if (n.nodetype in [addn,subn]) and
+       (taddnode(n).left.resultdef.typ=pointerdef) and
+       is_integer(taddnode(n).right.resultdef) then
+      n:=strip_conv(taddnode(n).left);
+    case n.nodetype of
+      addrn:
+        begin
+          n:=taddrnode(n).left;
+          { an element of an array variable (static, open or dynamic: the
+            elements are contiguous) }
+          if (n.nodetype=vecn) and
+             (tvecnode(n).left.nodetype=loadn) and
+             not assigned(tloadnode(tvecnode(n).left).left) and
+             (tloadnode(tvecnode(n).left).symtableentry.typ in [localvarsym,staticvarsym,paravarsym]) and
+             (tvecnode(n).left.resultdef.typ=arraydef) and
+             not is_packed_array(tvecnode(n).left.resultdef) and
+             equal_defs(tarraydef(tvecnode(n).left.resultdef).elementdef,tpointerdef(p^.sym.vardef).pointeddef) then
+            begin
+              arrsym:=tabstractvarsym(tloadnode(tvecnode(n).left).symtableentry);
+              if (p^.kind=pk_array) and (p^.arr<>arrsym) then
+                p^.bad:=true;
+              p^.kind:=pk_array;
+              p^.arr:=arrsym;
+            end
+          else
+            p^.bad:=true;
+        end;
+      loadn,temprefn:
+        begin
+          q:=findprov(ctx,n,true);
+          if assigned(q) then
+            p^.copies.Add(q)
+          else
+            p^.bad:=true;
+        end;
+      else
+        p^.bad:=true;
+    end;
+  end;
+
+
+function prov_collect(var n: tnode; arg: pointer): foreachnoderesult; forward;
+
+function prov_collect_rec(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=prov_collect(n,arg);
+  end;
+
+
+function prov_collect(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    ctx: pslpctx absolute arg;
+    p: pprovinfo;
+    para: tnode;
+  begin
+    result:=fen_false;
+    case n.nodetype of
+      assignn:
+        if tassignmentnode(n).left.nodetype in [loadn,temprefn] then
+          begin
+            p:=findprov(ctx,tassignmentnode(n).left,true);
+            if assigned(p) and assigned(p^.sym) or assigned(p) and assigned(p^.temp) then
+              begin
+                if (p^.sym=nil) or (p^.sym.vardef.typ=pointerdef) then
+                  begin
+                    if assigned(p^.temp) then
+                      begin
+                        { a temp gets the provenance of what it holds }
+                        if tassignmentnode(n).right.nodetype in [loadn,temprefn] then
+                          begin
+                            p^.copies.Add(findprov(ctx,tassignmentnode(n).right,true));
+                            if not assigned(p^.copies.Last) then
+                              p^.bad:=true;
+                          end
+                        else
+                          p^.bad:=true;
+                      end
+                    else
+                      prov_assign(ctx,p,tassignmentnode(n).right);
+                  end;
+              end;
+            foreachnodestatic(tassignmentnode(n).right,@prov_collect_rec,arg);
+            result:=fen_norecurse_false;
+          end;
+      inlinen:
+        if (tinlinenode(n).inlinenumber in [in_inc_x,in_dec_x]) and
+           assigned(tinlinenode(n).left) then
+          begin
+            para:=tcallparanode(tinlinenode(n).left).left;
+            if para.nodetype in [loadn,temprefn] then
+              begin
+                { inc/dec of a pointer keeps it on the array's elements }
+                findprov(ctx,para,true);
+                if assigned(tcallparanode(tinlinenode(n).left).right) then
+                  foreachnodestatic(tcallparanode(tcallparanode(tinlinenode(n).left).right).left,@prov_collect_rec,arg);
+                result:=fen_norecurse_false;
+              end;
+          end;
+      loadn,temprefn:
+        { any other write }
+        if (n.flags*[nf_write,nf_modify])<>[] then
+          begin
+            p:=findprov(ctx,n,true);
+            if assigned(p) then
+              p^.bad:=true;
+          end;
+      addrn:
+        if taddrnode(n).left.nodetype in [loadn,temprefn] then
+          begin
+            p:=findprov(ctx,taddrnode(n).left,true);
+            if assigned(p) then
+              p^.bad:=true;
+          end;
+      tempcreaten:
+        if assigned(ttempcreatenode(n).tempinfo^.tempinitcode) then
+          begin
+            { the init code is an assignment to the temp: handled there }
+          end;
+      else
+        ;
+    end;
+  end;
+
+
+{ resolve copies: a pointer is on array a if all its sources are }
+function prov_array(p: pprovinfo; depth: longint): tabstractvarsym;
+  var
+    i: longint;
+    a: tabstractvarsym;
+  begin
+    result:=nil;
+    if (p=nil) or p^.bad or (depth>8) then
+      exit;
+    if p^.kind=pk_array then
+      result:=p^.arr;
+    for i:=0 to p^.copies.Count-1 do
+      begin
+        if pprovinfo(p^.copies[i])=p then
+          continue;
+        a:=prov_array(pprovinfo(p^.copies[i]),depth+1);
+        if not assigned(a) then
+          exit(nil);
+        if assigned(result) and (result<>a) then
+          exit(nil);
+        result:=a;
+      end;
+  end;
+
+
+{*****************************************************************************
+                              Memory accesses
+*****************************************************************************}
+
+function get_access(n: tnode): taccess;
+  var
+    off: asizeint;
+  begin
+    result.valid:=false;
+    result.base:=nil;
+    result.offset:=0;
+    result.size:=0;
+    result.recdef:=nil;
+    if not assigned(n.resultdef) then
+      exit;
+    result.size:=n.resultdef.size;
+    off:=0;
+    while n.nodetype=subscriptn do
+      begin
+        if not(tsubscriptnode(n).left.resultdef.typ=recorddef) or
+           (tabstractrecordsymtable(trecorddef(tsubscriptnode(n).left.resultdef).symtable).usefieldalignment=bit_alignment) or
+           trecorddef(tsubscriptnode(n).left.resultdef).isunion and false then
+          exit;
+        inc(off,tsubscriptnode(n).vs.fieldoffset);
+        result.recdef:=tsubscriptnode(n).left.resultdef;
+        n:=tsubscriptnode(n).left;
+      end;
+    if not assigned(result.recdef) then
+      exit;
+    case n.nodetype of
+      derefn:
+        if strip_conv(tderefnode(n).left).nodetype in [loadn,temprefn] then
+          begin
+            result.base:=n;
+            result.offset:=off;
+            result.valid:=true;
+          end;
+      vecn:
+        if (tvecnode(n).left.nodetype=loadn) and
+           (tvecnode(n).left.resultdef.typ=arraydef) and
+           not is_packed_array(tvecnode(n).left.resultdef) then
+          begin
+            result.base:=n;
+            result.offset:=off;
+            result.valid:=true;
+          end;
+      else
+        ;
+    end;
+  end;
+
+
+function same_base(const a, b: taccess): boolean;
+  begin
+    result:=a.valid and b.valid and (a.recdef=b.recdef) and a.base.isequal(b.base);
+  end;
+
+
+{ the array a base points into, nil if unknown }
+function base_array(ctx: pslpctx; const a: taccess): tabstractvarsym;
+  var
+    p: tnode;
+  begin
+    result:=nil;
+    case a.base.nodetype of
+      derefn:
+        begin
+          p:=strip_conv(tderefnode(a.base).left);
+          result:=prov_array(findprov(ctx,p,false),0);
+          if assigned(result) and
+             not equal_defs(tarraydef(result.vardef).elementdef,a.recdef) then
+            result:=nil;
+        end;
+      vecn:
+        if equal_defs(tarraydef(tvecnode(a.base).left.resultdef).elementdef,a.recdef) then
+          result:=tabstractvarsym(tloadnode(tvecnode(a.base).left).symtableentry);
+      else
+        ;
+    end;
+  end;
+
+
+function overlap(const a, b: taccess): boolean;
+  begin
+    result:=(a.offset<b.offset+b.size) and (b.offset<a.offset+a.size);
+  end;
+
+
+function may_alias(ctx: pslpctx; const a, b: taccess): boolean;
+  var
+    arra, arrb: tabstractvarsym;
+  begin
+    result:=true;
+    if not a.valid or not b.valid then
+      exit;
+    if same_base(a,b) then
+      exit(overlap(a,b));
+    { whole elements of the same array of records }
+    if a.recdef=b.recdef then
+      begin
+        arra:=base_array(ctx,a);
+        arrb:=base_array(ctx,b);
+        if assigned(arra) and (arra=arrb) then
+          exit(overlap(a,b));
+      end;
+  end;
+
+
+type
+  treadcheck = record
+    ctx: pslpctx;
+    target: taccess;
+    alias: boolean;   { check the reads against target }
+    ok: boolean;
+  end;
+  preadcheck = ^treadcheck;
+
+
+{ a read of a variable that is not reached through memory: a local or value
+  parameter whose address is never taken, or (when target is reached through
+  a pointer known to point into an array a) a global other than a }
+function var_ok(rc: preadcheck; n: tloadnode): boolean;
+  var
+    sym: tabstractvarsym;
+  begin
+    result:=false;
+    if assigned(n.left) or not(n.symtableentry.typ in [localvarsym,paravarsym,staticvarsym]) then
+      exit;
+    sym:=tabstractvarsym(n.symtableentry);
+    if (vo_volatile in sym.varoptions) or
+       (sym.typ=paravarsym) and not(tparavarsym(sym).varspez in [vs_value,vs_const]) or
+       (sym.typ=paravarsym) and paramanager_push_addr(tparavarsym(sym)) then
+      exit;
+    if not rc^.alias then
+      exit(true);
+    if (sym.typ in [localvarsym,paravarsym]) and
+       ((sym.varsymaccess*[vsa_addr_taken,vsa_different_scope])=[]) then
+      exit(true);
+    { globals: only if the target is an element of a known array }
+    result:=(sym.typ=staticvarsym) and
+      (base_array(rc^.ctx,rc^.target)<>nil) and
+      (base_array(rc^.ctx,rc^.target)<>sym);
+  end;
+
+
+function check_reads(var n: tnode; arg: pointer): foreachnoderesult; forward;
+
+function check_reads_rec(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=check_reads(n,arg);
+  end;
+
+
+function check_reads(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    rc: preadcheck absolute arg;
+    acc: taccess;
+    p: tnode;
+  begin
+    result:=fen_false;
+    case n.nodetype of
+      addn,subn,muln,slashn:
+        if nf_swapped in n.flags then
+          rc^.ok:=rc^.ok and (n.nodetype in [addn,muln]);
+      typeconvn,realconstn,ordconstn,temprefn:
+        ;
+      loadn:
+        if not var_ok(rc,tloadnode(n)) then
+          rc^.ok:=false;
+      subscriptn,derefn,vecn:
+        begin
+          acc:=get_access(n);
+          if not acc.valid or (rc^.alias and may_alias(rc^.ctx,acc,rc^.target)) then
+            rc^.ok:=false
+          else
+            begin
+              { the base pointer and the index }
+              case acc.base.nodetype of
+                derefn:
+                  begin
+                    p:=strip_conv(tderefnode(acc.base).left);
+                    if (p.nodetype=loadn) and assigned(tloadnode(p).left) then
+                      rc^.ok:=false;
+                  end;
+                vecn:
+                  foreachnodestatic(tvecnode(acc.base).right,@check_reads_rec,arg);
+                else
+                  ;
+              end;
+            end;
+          result:=fen_norecurse_false;
+        end;
+      else
+        rc^.ok:=false;
+    end;
+    if not rc^.ok then
+      result:=fen_norecurse_true;
+  end;
+
+
+{ e has no side effects; with alias, it also reads nothing that may be target }
+function reads_ok(ctx: pslpctx; e: tnode; const target: taccess; alias: boolean): boolean;
+  var
+    rc: treadcheck;
+  begin
+    rc.ctx:=ctx;
+    rc.target:=target;
+    rc.alias:=alias;
+    rc.ok:=true;
+    foreachnodestatic(e,@check_reads,@rc);
+    result:=rc.ok;
+  end;
+
+
+{*****************************************************************************
+                              Vector trees
+*****************************************************************************}
+
+type
+  { a vector temp holding [lane0, lane1] of plain values (variables, temps,
+    constants), valid until one of them is written }
+  pcacheentry = ^tcacheentry;
+  tcacheentry = record
+    lane0, lane1: tnode;      { copies, owned }
+    temp: ttempcreatenode;
+  end;
+
+  tlistctx = record
+    ctx: pslpctx;
+    cache: TFPList;           { pcacheentry }
+    pre: tstatementnode;      { statements to put before the vector statement }
+    preblock: tblocknode;
+  end;
+  plistctx = ^tlistctx;
+
+
+function pure_double(n: tnode): boolean;
+  begin
+    result:=assigned(n.resultdef) and is_double(n.resultdef);
+  end;
+
+
+{ a value that a vector temp can hold for later statements }
+function plain_value(n: tnode): boolean;
+  begin
+    case n.nodetype of
+      realconstn,temprefn:
+        result:=true;
+      loadn:
+        result:=not assigned(tloadnode(n).left) and
+          (tloadnode(n).symtableentry.typ in [localvarsym,paravarsym]) and
+          ((tabstractvarsym(tloadnode(n).symtableentry).varsymaccess*[vsa_addr_taken,vsa_different_scope])=[]) and
+          not(vo_volatile in tabstractvarsym(tloadnode(n).symtableentry).varoptions) and
+          ((tloadnode(n).symtableentry.typ=localvarsym) or
+           (tparavarsym(tloadnode(n).symtableentry).varspez in [vs_value,vs_const]) and
+           not paramanager_push_addr(tparavarsym(tloadnode(n).symtableentry)));
+      else
+        result:=false;
+    end;
+  end;
+
+
+{ cost estimate: scalar instructions of e }
+function scalar_cost(n: tnode): longint;
+  begin
+    case n.nodetype of
+      addn,subn,muln,slashn:
+        result:=1+scalar_cost(taddnode(n).left)+scalar_cost(taddnode(n).right);
+      subscriptn,derefn,vecn:
+        result:=1;
+      else
+        result:=0;
+    end;
+  end;
+
+
+function vecload(ctx: pslpctx; n: tnode): tnode;
+  var
+    hp: tnode;
+  begin
+    hp:=caddrnode.create_internal(n.getcopy);
+    hp:=ctypeconvnode.create_internal(hp,ctx^.pvec2def);
+    hp:=cderefnode.create(hp);
+    include(tderefnode(hp).derefnodeflags,drnf_unaligned);
+    result:=hp;
+  end;
+
+
+function mkintrinsic(nr: tinlinenumber; a, b: tnode): tnode;
+  begin
+    if assigned(b) then
+      result:=geninlinenode(nr,false,ccallparanode.create(b,ccallparanode.create(a,nil)))
+    else
+      result:=geninlinenode(nr,false,ccallparanode.create(a,nil));
+  end;
+
+
+function cache_lookup(lc: plistctx; a, b: tnode): ttempcreatenode;
+  var
+    i: longint;
+    e: pcacheentry;
+  begin
+    result:=nil;
+    for i:=0 to lc^.cache.Count-1 do
+      begin
+        e:=pcacheentry(lc^.cache[i]);
+        if e^.lane0.isequal(a) and e^.lane1.isequal(b) then
+          exit(e^.temp);
+      end;
+  end;
+
+
+procedure cache_add(lc: plistctx; a, b: tnode; temp: ttempcreatenode);
+  var
+    e: pcacheentry;
+  begin
+    new(e);
+    e^.lane0:=a.getcopy;
+    e^.lane1:=b.getcopy;
+    { the copies are compared with reads }
+    node_reset_flags(e^.lane0,[nf_write,nf_modify],[]);
+    node_reset_flags(e^.lane1,[nf_write,nf_modify],[]);
+    e^.temp:=temp;
+    lc^.cache.Add(e);
+  end;
+
+
+procedure cache_clear(lc: plistctx);
+  var
+    i: longint;
+  begin
+    for i:=0 to lc^.cache.Count-1 do
+      begin
+        pcacheentry(lc^.cache[i])^.lane0.free;
+        pcacheentry(lc^.cache[i])^.lane1.free;
+        dispose(pcacheentry(lc^.cache[i]));
+      end;
+    lc^.cache.Clear;
+  end;
+
+
+function new_vectemp(lc: plistctx; value: tnode): ttempcreatenode;
+  begin
+    result:=ctempcreatenode.create(lc^.ctx^.vec2def,16,tt_persistent,true);
+    if not assigned(lc^.preblock) then
+      lc^.preblock:=internalstatements(lc^.pre);
+    addstatement(lc^.pre,result);
+    addstatement(lc^.pre,cassignmentnode.create_internal(ctemprefnode.create(result),value));
+  end;
+
+
+{ the vector of (a, b), nil if the shapes differ; cost counts the vector
+  instructions, loads the vector loads }
+function build(lc: plistctx; a, b: tnode; var cost: longint; var loads: longint): tnode;
+  var
+    l, r: tnode;
+    acca, accb: taccess;
+    nr: tinlinenumber;
+    t: ttempcreatenode;
+  begin
+    result:=nil;
+    if not pure_double(a) or not pure_double(b) then
+      exit;
+    { a value an earlier vector statement made }
+    t:=cache_lookup(lc,a,b);
+    if assigned(t) then
+      exit(ctemprefnode.create(t));
+    if (a.nodetype=b.nodetype) and (a.nodetype in [addn,subn,muln,slashn]) and
+       ((a.nodetype in [addn,muln]) or
+        (((nf_swapped in a.flags)=false) and ((nf_swapped in b.flags)=false))) then
+      begin
+        l:=build(lc,taddnode(a).left,taddnode(b).left,cost,loads);
+        if not assigned(l) then
+          exit;
+        r:=build(lc,taddnode(a).right,taddnode(b).right,cost,loads);
+        if not assigned(r) then
+          begin
+            l.free;
+            exit;
+          end;
+        case a.nodetype of
+          addn: nr:=in_vec2d_add;
+          subn: nr:=in_vec2d_sub;
+          muln: nr:=in_vec2d_mul;
+          else nr:=in_vec2d_div;
+        end;
+        inc(cost);
+        exit(mkintrinsic(nr,l,r));
+      end;
+    { adjacent loads }
+    acca:=get_access(a);
+    accb:=get_access(b);
+    if acca.valid and accb.valid and same_base(acca,accb) and
+       (acca.size=8) and (accb.size=8) and (accb.offset=acca.offset+8) then
+      begin
+        inc(cost);
+        inc(loads);
+        exit(vecload(lc^.ctx,a));
+      end;
+    { a broadcast or a pack of two values }
+    if not (a.nodetype in [loadn,temprefn,realconstn,subscriptn,derefn,vecn,typeconvn,
+                           addn,subn,muln,slashn]) or
+       not (b.nodetype in [loadn,temprefn,realconstn,subscriptn,derefn,vecn,typeconvn,
+                           addn,subn,muln,slashn]) then
+      exit;
+    inc(cost,2+scalar_cost(a)+scalar_cost(b));
+    if a.isequal(b) then
+      begin
+        if scalar_cost(b)>0 then
+          dec(cost,scalar_cost(b));
+        result:=mkintrinsic(in_vec2d_dup,a.getcopy,nil);
+      end
+    else
+      result:=mkintrinsic(in_vec2d_pack,a.getcopy,b.getcopy);
+    { kept in a temp for later statements }
+    if plain_value(a) and plain_value(b) then
+      begin
+        t:=new_vectemp(lc,result);
+        cache_add(lc,a,b,t);
+        result:=ctemprefnode.create(t);
+      end;
+  end;
+
+
+function wrap_pre(lc: plistctx; st: tnode): tnode;
+  begin
+    if assigned(lc^.preblock) then
+      begin
+        addstatement(lc^.pre,st);
+        result:=lc^.preblock;
+        lc^.preblock:=nil;
+        lc^.pre:=nil;
+      end
+    else
+      result:=st;
+  end;
+
+
+procedure drop_pre(lc: plistctx);
+  begin
+    { the temps of a failed attempt: forget them and their cache entries }
+    if assigned(lc^.preblock) then
+      begin
+        lc^.preblock.free;
+        lc^.preblock:=nil;
+        lc^.pre:=nil;
+      end;
+  end;
+
+
+type
+  twritecheck = record
+    e: pcacheentry;
+    hit: boolean;
+  end;
+  pwritecheck = ^twritecheck;
+
+
+function writes_lane(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    wc: pwritecheck absolute arg;
+  begin
+    result:=fen_false;
+    case n.nodetype of
+      loadn,temprefn:
+        if ((n.flags*[nf_write,nf_modify])<>[]) and
+           (n.isequal(wc^.e^.lane0) or n.isequal(wc^.e^.lane1)) then
+          wc^.hit:=true;
+      calln,asmn:
+        wc^.hit:=true;
+      addrn:
+        if taddrnode(n).left.isequal(wc^.e^.lane0) or taddrnode(n).left.isequal(wc^.e^.lane1) then
+          wc^.hit:=true;
+      else
+        ;
+    end;
+    if wc^.hit then
+      result:=fen_norecurse_true;
+  end;
+
+
+{ drop the cache entries whose values statement st may change }
+procedure invalidate(lc: plistctx; st: tnode);
+  var
+    i: longint;
+    wc: twritecheck;
+  begin
+    if not assigned(st) then
+      exit;
+    for i:=lc^.cache.Count-1 downto 0 do
+      begin
+        wc.e:=pcacheentry(lc^.cache[i]);
+        wc.hit:=false;
+        foreachnodestatic(st,@writes_lane,@wc);
+        if wc.hit then
+          begin
+            pcacheentry(lc^.cache[i])^.lane0.free;
+            pcacheentry(lc^.cache[i])^.lane1.free;
+            dispose(pcacheentry(lc^.cache[i]));
+            lc^.cache.Delete(i);
+          end;
+      end;
+  end;
+
+
+procedure finish_statement(st: tnode);
+  begin
+    typecheckpass(st);
+    do_firstpass(st);
+  end;
+
+
+function try_pair(lc: plistctx; s1, s2: tstatementnode): boolean;
+  var
+    a1, a2: tassignmentnode;
+    m1, m2: taccess;
+    v, st: tnode;
+    cost, loads, scost, ncache: longint;
+  begin
+    result:=false;
+    if not assigned(s1.left) or not assigned(s2.left) or
+       (s1.left.nodetype<>assignn) or (s2.left.nodetype<>assignn) then
+      exit;
+    a1:=tassignmentnode(s1.left);
+    a2:=tassignmentnode(s2.left);
+    if not assigned(a1.left.resultdef) or not is_double(a1.left.resultdef) or
+       not assigned(a2.left.resultdef) or not is_double(a2.left.resultdef) or
+       (a1.assignmentnodeflags<>[]) or (a2.assignmentnodeflags<>[]) then
+      exit;
+    m1:=get_access(a1.left);
+    m2:=get_access(a2.left);
+    if not m1.valid or not same_base(m1,m2) or (m1.size<>8) or (m2.size<>8) or
+       (m2.offset<>m1.offset+8) then
+      exit;
+    { e2 is evaluated before m1 is written: it must not read m1; neither
+      side may have side effects }
+    if not reads_ok(lc^.ctx,a2.right,m1,true) or
+       not reads_ok(lc^.ctx,a1.right,m1,false) or
+       not reads_ok(lc^.ctx,a1.left,m1,false) then
+      exit;
+    cost:=0;
+    loads:=0;
+    ncache:=lc^.cache.Count;
+    v:=build(lc,a1.right,a2.right,cost,loads);
+    if not assigned(v) then
+      begin
+        drop_pre(lc);
+        while lc^.cache.Count>ncache do
+          begin
+            pcacheentry(lc^.cache.Last)^.lane0.free;
+            pcacheentry(lc^.cache.Last)^.lane1.free;
+            dispose(pcacheentry(lc^.cache.Last));
+            lc^.cache.Delete(lc^.cache.Count-1);
+          end;
+        exit;
+      end;
+    { scalar: the operations and loads of both, two stores; vector: the
+      vector operations, loads and packs, one store }
+    scost:=scalar_cost(a1.right)+scalar_cost(a2.right)+2;
+    if (cost+1>=scost) or (loads=0) then
+      begin
+        v.free;
+        drop_pre(lc);
+        while lc^.cache.Count>ncache do
+          begin
+            pcacheentry(lc^.cache.Last)^.lane0.free;
+            pcacheentry(lc^.cache.Last)^.lane1.free;
+            dispose(pcacheentry(lc^.cache.Last));
+            lc^.cache.Delete(lc^.cache.Count-1);
+          end;
+        exit;
+      end;
+    st:=cassignmentnode.create_internal(vecload(lc^.ctx,a1.left),v);
+    st.fileinfo:=a1.fileinfo;
+    st:=wrap_pre(lc,st);
+    finish_statement(st);
+    s1.left.free;
+    s1.left:=st;
+    s2.left.free;
+    s2.left:=cnothingnode.create;
+    finish_statement(s2.left);
+    result:=true;
+  end;
+
+
+type
+  trefcheck = record
+    target: tnode;
+    hit: boolean;
+  end;
+
+
+function refers_to(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=fen_false;
+    if (n.nodetype in [loadn,temprefn]) and n.isequal(trefcheck(arg^).target) then
+      begin
+        trefcheck(arg^).hit:=true;
+        result:=fen_norecurse_true;
+      end;
+  end;
+
+
+function refers(n, target: tnode): boolean;
+  var
+    rc: trefcheck;
+  begin
+    rc.target:=target;
+    rc.hit:=false;
+    if assigned(n) then
+      foreachnodestatic(n,@refers_to,@rc);
+    result:=rc.hit;
+  end;
+
+
+{ x := e1; y := e2 with local doubles x, y that later statements use as a
+  pair: v := vector(e1,e2); x := lo(v); y := hi(v), and [x,y] is v }
+function try_local_pair(lc: plistctx; s1, s2: tstatementnode): boolean;
+  var
+    a1, a2: tassignmentnode;
+    x, y, v, st: tnode;
+    cost, loads, scost, ncache: longint;
+    later: tstatementnode;
+    used: boolean;
+    t: ttempcreatenode;
+    dummy: taccess;
+  begin
+    result:=false;
+    if not assigned(s1.left) or not assigned(s2.left) or
+       (s1.left.nodetype<>assignn) or (s2.left.nodetype<>assignn) then
+      exit;
+    a1:=tassignmentnode(s1.left);
+    a2:=tassignmentnode(s2.left);
+    x:=a1.left;
+    y:=a2.left;
+    if not plain_value(x) or not plain_value(y) or (x.nodetype<>loadn) or (y.nodetype<>loadn) or
+       x.isequal(y) or
+       not is_double(x.resultdef) or not is_double(y.resultdef) or
+       (a1.assignmentnodeflags<>[]) or (a2.assignmentnodeflags<>[]) then
+      exit;
+    { e2 runs after x is written }
+    if refers(a2.right,x) then
+      exit;
+    dummy.valid:=false;
+    if not reads_ok(lc^.ctx,a1.right,dummy,false) or
+       not reads_ok(lc^.ctx,a2.right,dummy,false) then
+      exit;
+    { worth it only if a later statement pair uses x and y together }
+    used:=false;
+    later:=tstatementnode(s2.right);
+    while assigned(later) and (later.nodetype=statementn) and assigned(later.right) and
+          (later.right.nodetype=statementn) do
+      begin
+        if refers(later.left,x) and refers(tstatementnode(later.right).left,y) then
+          begin
+            used:=true;
+            break;
+          end;
+        later:=tstatementnode(later.right);
+      end;
+    if not used then
+      exit;
+    cost:=0;
+    loads:=0;
+    ncache:=lc^.cache.Count;
+    v:=build(lc,a1.right,a2.right,cost,loads);
+    scost:=scalar_cost(a1.right)+scalar_cost(a2.right);
+    { the extraction costs 3, a pack saved later 2 }
+    if not assigned(v) or (loads=0) or (cost+3>scost+2) then
+      begin
+        v.free;
+        drop_pre(lc);
+        while lc^.cache.Count>ncache do
+          begin
+            pcacheentry(lc^.cache.Last)^.lane0.free;
+            pcacheentry(lc^.cache.Last)^.lane1.free;
+            dispose(pcacheentry(lc^.cache.Last));
+            lc^.cache.Delete(lc^.cache.Count-1);
+          end;
+        exit;
+      end;
+    { x and y belong to the statements that are replaced below }
+    x:=x.getcopy;
+    y:=y.getcopy;
+    t:=ctempcreatenode.create(lc^.ctx^.vec2def,16,tt_persistent,true);
+    if not assigned(lc^.preblock) then
+      lc^.preblock:=internalstatements(lc^.pre);
+    addstatement(lc^.pre,t);
+    addstatement(lc^.pre,cassignmentnode.create_internal(ctemprefnode.create(t),v));
+    st:=cassignmentnode.create(x.getcopy,mkintrinsic(in_vec2d_lo,ctemprefnode.create(t),nil));
+    st.fileinfo:=a1.fileinfo;
+    st:=wrap_pre(lc,st);
+    finish_statement(st);
+    s1.left.free;
+    s1.left:=st;
+    st:=cassignmentnode.create(y.getcopy,mkintrinsic(in_vec2d_hi,ctemprefnode.create(t),nil));
+    st.fileinfo:=a2.fileinfo;
+    finish_statement(st);
+    s2.left.free;
+    s2.left:=st;
+    invalidate(lc,s1.left);
+    invalidate(lc,s2.left);
+    cache_add(lc,x,y,t);
+    x.free;
+    y.free;
+    result:=true;
+  end;
+
+
+function slp_statements(var n: tnode; arg: pointer): foreachnoderesult; forward;
+
+function slp_statements_rec(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=slp_statements(n,arg);
+  end;
+
+
+function slp_statements(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    ctx: pslpctx absolute arg;
+    s, nxt: tstatementnode;
+    lc: tlistctx;
+  begin
+    result:=fen_false;
+    if n.nodetype<>statementn then
+      exit;
+    lc.ctx:=ctx;
+    lc.cache:=TFPList.Create;
+    lc.pre:=nil;
+    lc.preblock:=nil;
+    try
+      s:=tstatementnode(n);
+      while assigned(s) do
+        begin
+          if assigned(s.right) and (s.right.nodetype=statementn) then
+            nxt:=tstatementnode(s.right)
+          else
+            nxt:=nil;
+          if assigned(nxt) and try_local_pair(@lc,s,nxt) then
+            begin
+              ctx^.changed:=true;
+              s:=nxt;
+            end
+          else if assigned(nxt) and try_pair(@lc,s,nxt) then
+            begin
+              ctx^.changed:=true;
+              s:=nxt;
+            end
+          else
+            invalidate(@lc,s.left);
+          if assigned(s.right) and (s.right.nodetype=statementn) then
+            s:=tstatementnode(s.right)
+          else
+            break;
+        end;
+    finally
+      cache_clear(@lc);
+      lc.cache.Free;
+    end;
+    { nested statement lists }
+    s:=tstatementnode(n);
+    while assigned(s) do
+      begin
+        if assigned(s.left) then
+          foreachnodestatic(pm_postprocess,s.left,@slp_statements_rec,arg);
+        if assigned(s.right) and (s.right.nodetype=statementn) then
+          s:=tstatementnode(s.right)
+        else
+          break;
+      end;
+    result:=fen_norecurse_false;
+  end;
+
+
+function do_slp_vectorize(var code: tnode): boolean;
+  var
+    ctx: tslpctx;
+    i: longint;
+  begin
+    result:=false;
+{$ifndef x86_64}
+    exit;
+{$endif x86_64}
+    ctx.provs:=TFPList.Create;
+    ctx.changed:=false;
+    ctx.vec2def:=carraydef.getreusable_vector(s64floattype,2);
+    ctx.pvec2def:=cpointerdef.getreusable(ctx.vec2def);
+    try
+      foreachnodestatic(pm_postprocess,code,@prov_collect,@ctx);
+      foreachnodestatic(pm_postprocess,code,@slp_statements,@ctx);
+    finally
+      for i:=0 to ctx.provs.Count-1 do
+        begin
+          pprovinfo(ctx.provs[i])^.copies.Free;
+          dispose(pprovinfo(ctx.provs[i]));
+        end;
+      ctx.provs.Free;
+    end;
+    result:=ctx.changed;
+  end;
+
+end.
