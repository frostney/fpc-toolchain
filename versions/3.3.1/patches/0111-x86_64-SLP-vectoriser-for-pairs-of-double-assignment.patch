+                emit_reg_reg(A_MOVAPD,S_NO,newreg(R_MMREGISTER,getsupreg(ra),getsubreg(res)),res);
+                if inlinenumber=in_vec2d_hi then
+                  emit_reg_reg(A_UNPCKHPD,S_NO,res,res);
+              end;
+            location.register:=res;
+            exit;
+          end;
+        a:=tcallparanode(tcallparanode(parameters).nextpara).paravalue;
+        b:=tcallparanode(parameters).paravalue;
+        secondpass(a);
+        secondpass(b);
+        location_reset(location,LOC_MMREGISTER,OS_M128);
+        if inlinenumber=in_vec2d_pack then
+          begin
+            hlcg.location_force_mmregscalar(current_asmdata.CurrAsmList,a.location,a.resultdef,true);
