+                ra:=newreg(R_MMREGISTER,getsupreg(a.location.register),R_SUBMMWHOLE);
+                if a.location.loc=LOC_MMREGISTER then
+                  res:=ra
+                else
+                  begin
+                    res:=cg.getmmregister(current_asmdata.CurrAsmList,OS_M128);
+                    emit_reg_reg(A_MOVAPD,S_NO,ra,res);
+                  end;
+                emit_reg_reg(A_UNPCKLPD,S_NO,res,res);
+              end
+            else
+              begin
+                location_reset(location,LOC_MMREGISTER,OS_F64);
+                location_force_mmreg(current_asmdata.CurrAsmList,a.location,true);
+                ra:=a.location.register;
