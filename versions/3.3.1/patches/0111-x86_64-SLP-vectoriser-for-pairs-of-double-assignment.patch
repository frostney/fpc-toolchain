diff --git a/tests/test/opt/tslp1.pp b/tests/test/opt/tslp1.pp
new file mode 100644
index 00000000..a2bb77eb
--- /dev/null
+++ b/tests/test/opt/tslp1.pp
@@ -0,0 +1,245 @@
+{ %CPU=x86_64 }
+{ %OPT=-O4 -OoNOFASTMATH }
+{ SLP vectoriser (optslp): pairs of double assignments to adjacent memory;
+  every routine is compared with the same statements kept apart by a call }
+program tslp1;
+
+{$mode objfpc}
+
+type
+  TBody = record
+    x, y, z, vx, vy, vz, mass: double;
+  end;
+  PBody = ^TBody;
+
+var
+  errors: longint = 0;
+  b, r: array[1..6] of TBody;
+  g: double = 3.0;
+
+procedure barrier; noinline;
+begin
+end;
+
+procedure check(got, expected: double; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+procedure init(var a: array of TBody);
+var
+  i: longint;
+begin
+  for i := 0 to high(a) do
+    with a[i] do
+      begin
+        x := i + 0.5; y := i * 2 + 0.25; z := i * 3;
+        vx := i * 0.1; vy := i * 0.2; vz := 0; mass := i + 1;
+      end;
+end;
+
+procedure compare(const what: string);
+var
+  i: longint;
+begin
+  for i := 1 to 6 do
+    begin
+      check(b[i].x, r[i].x, what + ' x');
+      check(b[i].y, r[i].y, what + ' y');
+      check(b[i].vx, r[i].vx, what + ' vx');
+      check(b[i].vy, r[i].vy, what + ' vy');
+      check(b[i].mass, r[i].mass, what + ' mass');
+    end;
+end;
+
+{ the nbody inner loop: pointers on whole elements of one array }
+procedure advance(var a: array of TBody; dt: double; sep: boolean);
+var
+  bi, bj: PBody;
+  i, j: longint;
+  dx, dy, mag: double;
+begin
+  bi := @a[0];
+  for i := 0 to high(a) - 1 do
+    begin
+      bj := bi;
+      for j := i + 1 to high(a) do
+        begin
+          inc(bj);
+          dx := bi^.x - bj^.x;
+          dy := bi^.y - bj^.y;
+          mag := dt / (dx * dx + dy * dy + 1);
+          bi^.vx := bi^.vx - dx * bj^.mass * mag;
+          bi^.vy := bi^.vy - dy * bj^.mass * mag;
+          bj^.vx := bj^.vx + dx * bi^.mass * mag;
+          bj^.vy := bj^.vy + dy * bi^.mass * mag;
+        end;
+      inc(bi);
+    end;
+  bi := @a[0];
+  for i := 0 to high(a) do
+    begin
+      with bi^ do
+        begin
+          x := x + dt * vx;
+          y := y + dt * vy;
+        end;
+      inc(bi);
+    end;
+end;
+
+procedure advance_ref(var a: array of TBody; dt: double; sep: boolean);
+var
+  bi, bj: PBody;
+  i, j: longint;
+  dx, dy, mag: double;
+begin
+  bi := @a[0];
+  for i := 0 to high(a) - 1 do
+    begin
+      bj := bi;
+      for j := i + 1 to high(a) do
+        begin
+          inc(bj);
+          dx := bi^.x - bj^.x;
+          barrier;
+          dy := bi^.y - bj^.y;
+          mag := dt / (dx * dx + dy * dy + 1);
+          bi^.vx := bi^.vx - dx * bj^.mass * mag;
+          barrier;
+          bi^.vy := bi^.vy - dy * bj^.mass * mag;
+          bj^.vx := bj^.vx + dx * bi^.mass * mag;
+          barrier;
+          bj^.vy := bj^.vy + dy * bi^.mass * mag;
+        end;
+      inc(bi);
+    end;
+  bi := @a[0];
+  for i := 0 to high(a) do
+    begin
+      with bi^ do
+        begin
+          x := x + dt * vx;
+          barrier;
+          y := y + dt * vy;
+        end;
+      inc(bi);
+    end;
+end;
+
+{ bj = bi: the same element }
+procedure same(p: PBody; sep: boolean);
+var
+  q: PBody;
+begin
+  q := p;
+  p^.vx := p^.vx - q^.mass * 2.0;
+  p^.vy := p^.vy - q^.mass * 3.0;
+end;
+
+procedure same_ref(p: PBody; sep: boolean);
+var
+  q: PBody;
+begin
+  q := p;
+  p^.vx := p^.vx - q^.mass * 2.0;
+  barrier;
+  p^.vy := p^.vy - q^.mass * 3.0;
+end;
+
+{ the second statement reads what the first writes }
+procedure dep(p: PBody; sep: boolean);
+begin
+  p^.x := p^.y * 2.0 + p^.vx;
+  p^.y := p^.x * 3.0 + p^.vy;
+end;
+
+procedure dep_ref(p: PBody; sep: boolean);
+begin
+  p^.x := p^.y * 2.0 + p^.vx;
+  barrier;
+  p^.y := p^.x * 3.0 + p^.vy;
+end;
+
+{ q^.mass overlaps p^.vx (no provenance) }
+procedure overlap(p, q: PBody; sep: boolean);
+begin
+  p^.vx := p^.vx + q^.mass * 2.0;
+  p^.vy := p^.vy + q^.mass * 2.0;
+end;
+
+procedure overlap_ref(p, q: PBody; sep: boolean);
+begin
+  p^.vx := p^.vx + q^.mass * 2.0;
+  barrier;
+  p^.vy := p^.vy + q^.mass * 2.0;
+end;
+
+{ a global read by the second statement }
+procedure global(p: PBody; sep: boolean);
+begin
+  p^.x := p^.x * g + 1.0;
+  p^.y := p^.y * g + 2.0;
+end;
+
+procedure global_ref(p: PBody; sep: boolean);
+begin
+  p^.x := p^.x * g + 1.0;
+  barrier;
+  p^.y := p^.y * g + 2.0;
+end;
+
+{ dx changes between the local pair and its use }
+procedure reuse(p, q: PBody; sep: boolean);
+var
+  dx, dy: double;
+begin
+  dx := p^.x - q^.x;
+  dy := p^.y - q^.y;
+  dx := dx * 0.5;
+  p^.vx := p^.vx + dx * 2.0;
+  p^.vy := p^.vy + dy * 2.0;
+end;
+
+procedure reuse_ref(p, q: PBody; sep: boolean);
+var
+  dx, dy: double;
+begin
+  dx := p^.x - q^.x;
+  barrier;
+  dy := p^.y - q^.y;
+  dx := dx * 0.5;
+  p^.vx := p^.vx + dx * 2.0;
+  barrier;
+  p^.vy := p^.vy + dy * 2.0;
+end;
+
+var
+  i: longint;
+begin
+  init(b); init(r);
+  for i := 1 to 20 do
+    begin
+      advance(b, 0.01, false);
+      advance_ref(r, 0.01, true);
+    end;
+  compare('advance');
+  init(b); init(r);
+  same(@b[2], false); same_ref(@r[2], true);
+  dep(@b[3], false); dep_ref(@r[3], true);
+  global(@b[4], false); global_ref(@r[4], true);
+  reuse(@b[5], @b[1], false); reuse_ref(@r[5], @r[1], true);
+  compare('small');
+  init(b); init(r);
+  { q^.mass is p^.vx }
+  overlap(@b[2], PBody(PByte(@b[2].vx) - PtrUInt(@PBody(nil)^.mass)), false);
+  overlap_ref(@r[2], PBody(PByte(@r[2].vx) - PtrUInt(@PBody(nil)^.mass)), true);
+  compare('overlap');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
