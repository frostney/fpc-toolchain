 7 files changed, 200 insertions(+), 13 deletions(-)

diff --git a/compiler/wasm32/aasmcpu.pas b/compiler/wasm32/aasmcpu.pas
index f21ed36f..8de3f1b0 100644
--- a/compiler/wasm32/aasmcpu.pas
+++ b/compiler/wasm32/aasmcpu.pas
@@ -152,6 +152,9 @@ uses
       public
          is_br_generated_by_goto: boolean;
          try_table_catch_clauses: tasmlist;
+         { a_br_table: one a_br per target (label or resolved depth), the last
+           one is the default target }
+         br_table_targets: tasmlist;
 
          constructor Create(op : tasmop);override;
          destructor Destroy;override;
@@ -1157,6 +1160,11 @@ uses
               PopVals(label_types(FCtrlStack[n]));
               PushVals(label_types(FCtrlStack[n]));
             end;
+          a_br_table:
+            begin
+              PopVal(wbt_i32);
+              Unreachable;
+            end;
           a_legacy_throw:
             Unreachable;
           a_legacy_rethrow:
@@ -2023,12 +2031,15 @@ uses
           internalerror(2024070701);
         if op=a_try_table then
           try_table_catch_clauses:=TAsmList.Create;
+        if op=a_br_table then
+          br_table_targets:=TAsmList.Create;
       end;
 
 
     destructor taicpu.Destroy;
       begin
         FreeAndNil(try_table_catch_clauses);
+        FreeAndNil(br_table_targets);
         inherited;
       end;
 
@@ -2736,6 +2747,20 @@ uses
                     internalerror(2021092611);
                 end;
             end;
+          a_br_table:
+            begin
+              if not assigned(br_table_targets) or (br_table_targets.Count<1) then
+                internalerror(2026101601);
+              result:=1+UlebSize(br_table_targets.Count-1);
+              hp:=taicpu(br_table_targets.First);
+              while assigned(hp) do
+                begin
+                  if (hp.ops<>1) or (hp.oper[0]^.typ<>top_const) then
+                    internalerror(2026101602);
+                  Inc(result,UlebSize(hp.oper[0]^.val));
+                  hp:=taicpu(hp.Next);
+                end;
+            end;
           a_br,
           a_br_if,
           a_legacy_rethrow,
@@ -3783,6 +3808,19 @@ uses
                     internalerror(2021092611);
                 end;
             end;
+          a_br_table:
+            begin
+              WriteByte($0E);
+              WriteUleb(br_table_targets.Count-1);
+              hp:=taicpu(br_table_targets.First);
+              while assigned(hp) do
+                begin
+                  if (hp.ops<>1) or (hp.oper[0]^.typ<>top_const) then
+                    internalerror(2026101603);
+                  WriteUleb(hp.oper[0]^.val);
+                  hp:=taicpu(hp.Next);
+                end;
+            end;
           a_br,
           a_br_if,
           a_legacy_rethrow,
diff --git a/compiler/wasm32/agllvmmc.pas b/compiler/wasm32/agllvmmc.pas
index 195f43e2..96349e6f 100644
--- a/compiler/wasm32/agllvmmc.pas
+++ b/compiler/wasm32/agllvmmc.pas
@@ -421,7 +421,7 @@ implementation
       end;
 
     var
-      cpu : taicpu;
+      cpu, hpt : taicpu;
       i   : integer;
       writer: TExternalAssemblerOutputFile;
     begin
@@ -458,6 +458,20 @@ implementation
       if Assigned(cpu.try_table_catch_clauses) then
         WriteCatchClauses(writer,cpu.try_table_catch_clauses);
 
+      if Assigned(cpu.br_table_targets) then
+        begin
+          writer.AsmWrite(#9'{');
+          hpt:=taicpu(cpu.br_table_targets.First);
+          while Assigned(hpt) do
+            begin
+              writer.AsmWrite(getopstr(hpt.oper[0]^));
+              hpt:=taicpu(hpt.Next);
+              if Assigned(hpt) then
+                writer.AsmWrite(', ');
+            end;
+          writer.AsmWrite('}');
+        end;
+
       writer.AsmLn;
     end;
 
diff --git a/compiler/wasm32/cpupi.pas b/compiler/wasm32/cpupi.pas
index fbdf9b8c..d88b7271 100644
--- a/compiler/wasm32/cpupi.pas
+++ b/compiler/wasm32/cpupi.pas
@@ -771,6 +771,29 @@ implementation
                           Message1(parser_f_unsupported_feature,'negative nesting level');
                       end;
 
+                    a_br_table:
+                      begin
+                        catchinstr:=taicpu(instr.br_table_targets.First);
+                        while assigned(catchinstr) do
