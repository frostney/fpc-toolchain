       end;
@@ -59,7 +60,7 @@ implementation
       aasmdata,aasmcpu,
       hlcgobj,hlcgcpu,
       nbas,
-      symtype,
+      symtype,symdef,procinfo,
       pass_2,defutil,verbose,constexp;
 
 {*****************************************************************************
@@ -291,11 +292,53 @@ implementation
       end;
 
 
+    procedure twasmcasenode.genjumptable(hp : pcaselabel;min_,max_ : int64);
+      var
+        targets: array of tasmlabel;
+        i: int64;
+        brtable: taicpu;
+        idxreg: tregister;
+
+      procedure fill(t : pcaselabel);
+        var
+          v: int64;
+        begin
+          if assigned(t^.less) then
+            fill(t^.less);
+          for v:=t^._low.svalue to t^._high.svalue do
+            targets[v-min_]:=blocklabel(t^.blockid);
+          if assigned(t^.greater) then
+            fill(t^.greater);
+        end;
+
+      begin
+        SetLength(targets,max_-min_+1);
+        for i:=0 to high(targets) do
+          targets[i]:=elselabel;
+        fill(hp);
+        { index = value-min_ as an unsigned 32-bit number: every value outside
+          min_..max_ (also below min_, and for signed values) becomes >= the
+          table length and takes the default target }
+        idxreg:=hlcg.getintregister(current_asmdata.CurrAsmList,u32inttype);
+        hlcg.a_load_reg_reg(current_asmdata.CurrAsmList,opsize,u32inttype,hregister,idxreg);
+        thlcgwasm(hlcg).a_load_reg_stack(current_asmdata.CurrAsmList,u32inttype,idxreg);
+        if min_<>0 then
+          thlcgwasm(hlcg).a_op_const_stack(current_asmdata.CurrAsmList,OP_SUB,u32inttype,tcgint(min_));
+        brtable:=taicpu.op_none(a_br_table);
+        for i:=0 to high(targets) do
+          brtable.br_table_targets.Concat(taicpu.op_sym(a_br,targets[i]));
+        brtable.br_table_targets.Concat(taicpu.op_sym(a_br,elselabel));
+        current_asmdata.CurrAsmList.concat(brtable);
+        thlcgwasm(hlcg).decstack(current_asmdata.CurrAsmList,1);
+      end;
+
+
     procedure twasmcasenode.pass_generate_code;
       var
         oldflowcontrol: tflowcontrol;
         ShortcutElse: Boolean;
         i: Integer;
+        max_label: tconstexprint;
       begin
         location_reset(location,LOC_VOID,OS_NO);
 
@@ -435,6 +478,22 @@ implementation
             //      end;
             //  end
             //else
+            { br_table: a single indirect branch instead of a compare chain.
+              Not in procedures with labels: goto lowering (cpupi
+              resolve_labels_complex) does not handle br_table targets.
+              Only for selectors of up to 32 bits: the index is computed as
+              an i32 (wasm32 has cpu64bitalu, so 64-bit selectors get here
+              too, and truncating them would map e.g. $100000002 to 2). }
+            max_label:=case_get_max(labels);
+            if (cs_opt_level1 in current_settings.optimizerswitches) and
+               (opsize.size<=4) and
+               not(pi_has_label in current_procinfo.flags) and
+               (labelcnt>=4) and
+               (max_label.svalue>=min_label.svalue) and
+               ((max_label-min_label).uvalue<=8192) and
+               ((max_label-min_label).uvalue<=8*labelcoverage) then
+              genjumptable(labels,min_label.svalue,max_label.svalue)
+            else
               { it's always not bad }
               genlinearlist(labels);
           end;
