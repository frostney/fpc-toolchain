+                            if (catchinstr.ops<>1) then
+                              Message1(parser_f_unsupported_feature,'a_br_table target with wrong operand count');
+                            if catchinstr.oper[0]^.typ=top_ref then
+                              begin
+                                if (catchinstr.oper[0]^.ref^.symbol.nestingdepth<>-1) and
+                                   (cur_nesting_depth>=catchinstr.oper[0]^.ref^.symbol.nestingdepth) then
+                                  catchinstr.loadconst(0,cur_nesting_depth-catchinstr.oper[0]^.ref^.symbol.nestingdepth)
+                                else
+                                  begin
+                                    result:=false;
+                                    hlabel:=tasmsymbol(catchinstr.oper[0]^.ref^.symbol);
+                                    asmlist.insertafter(tai_comment.create(strpnew('Unable to find destination of label '+hlabel.name)),hp);
+                                  end;
+                              end;
+                            catchinstr:=taicpu(catchinstr.Next);
+                          end;
+                      end;
+
                     a_br,
                     a_br_if:
                       begin
@@ -821,7 +844,7 @@ implementation
           hp, hpnext: tai;
           block_nr, machine_state, target_block_index, catch_nr: Integer;
           state_machine_loop_start_label, state_machine_exit: TAsmLabel;
-          catchinstr: taicpu;
+          catchinstr, brtable: taicpu;
         begin
           blocks:=TFPHashObjectList.Create;
           curr_block:=TAsmList.Create;
@@ -856,15 +879,14 @@ implementation
           current_asmdata.getjumplabel(state_machine_exit);
           for block_nr:=0 to blocks.Count-1 do
             asmlist.Concat(taicpu.op_none(a_block));
+          { one br_table instead of a compare chain over all blocks }
+          asmlist.Concat(taicpu.op_const(a_local_get,machine_state));
+          brtable:=taicpu.op_none(a_br_table);
           for block_nr:=0 to blocks.Count-1 do
-            begin
-              { TODO: this sequence can be replaced with a single br_table instruction }
-              asmlist.Concat(taicpu.op_const(a_local_get,machine_state));
-              asmlist.Concat(taicpu.op_const(a_i32_const,block_nr));
-              asmlist.Concat(taicpu.op_none(a_i32_eq));
-              asmlist.Concat(taicpu.op_const(a_br_if,block_nr));
-            end;
-          asmlist.Concat(taicpu.op_none(a_unreachable));
+            brtable.br_table_targets.Concat(taicpu.op_const(a_br,block_nr));
+          { default: never taken, the state is always a block number }
+          brtable.br_table_targets.Concat(taicpu.op_const(a_br,0));
+          asmlist.Concat(brtable);
           tmplist:=TAsmList.Create;
           for block_nr:=0 to blocks.Count-1 do
             begin
@@ -875,6 +897,9 @@ implementation
               while assigned(hp) do
                 begin
                   hpnext:=tai(hp.next);
+                  if (hp.typ=ait_instruction) and (taicpu(hp).opcode=a_br_table) then
+                    { twasmcasenode only emits br_table in procedures without labels }
+                    internalerror(2026101604);
                   if (hp.typ=ait_instruction) and (taicpu(hp).opcode in [a_br,a_br_if]) and
                      (taicpu(hp).ops=1) and
                      (taicpu(hp).oper[0]^.typ=top_ref) and
diff --git a/compiler/wasm32/hlcgcpu.pas b/compiler/wasm32/hlcgcpu.pas
index bd22623f..3b7b91ad 100644
--- a/compiler/wasm32/hlcgcpu.pas
+++ b/compiler/wasm32/hlcgcpu.pas
@@ -2108,6 +2108,9 @@ implementation
 
   procedure thlcgwasm.g_concatcopy(list: TAsmList; size: tdef; const source, dest: treference);
     var
+      ofs: asizeint;
+      chunkdef: tdef;
+      srcref, dstref: treference;
       pd: tprocdef;
       cgpara1,cgpara2,cgpara3 : TCGPara;
     begin
@@ -2117,6 +2120,30 @@ implementation
          (dest.index=NR_EVAL_STACK_BASE) or (dest.index=NR_LOCAL_STACK_POINTER_REG) or
          (size.size in [1,2,4,8]) then
         inherited
+      else if (size.size>0) and (size.size<=64) then
+        begin
+          { small fixed-size copy (records, short arrays): inline loads and
+            stores instead of a call to Move, which ends in memory.copy (an
+            out-of-line libcall in most engines) }
+          ofs:=0;
+          while ofs<size.size do
+            begin
+              if size.size-ofs>=8 then
+                chunkdef:=u64inttype
+              else if size.size-ofs>=4 then
+                chunkdef:=u32inttype
+              else if size.size-ofs>=2 then
+                chunkdef:=u16inttype
+              else
+                chunkdef:=u8inttype;
+              srcref:=source;
+              inc(srcref.offset,ofs);
+              dstref:=dest;
+              inc(dstref.offset,ofs);
+              a_load_ref_ref(list,chunkdef,chunkdef,srcref,dstref);
+              inc(ofs,chunkdef.size);
+            end;
+        end
       else
         begin
           pd:=search_system_proc('MOVE');
@@ -2563,11 +2590,24 @@ implementation
   procedure thlcgwasm.g_maybe_checkforexceptions(list: TasmList);
     var
       pd: tprocdef;
+      ref: treference;
+      extra_slots: longint;
     begin
       if ts_wasm_bf_exceptions in current_settings.targetswitches then
         begin
-          pd:=search_system_proc('fpc_raised_exception_flag');
-          g_call_system_proc(list,pd,[],nil).resetiftemp;
+          if not (ts_wasm_threads in current_settings.targetswitches) then
+            begin
+              { a plain global without threads: load it instead of calling
+                fpc_raised_exception_flag after every call }
+              reference_reset_symbol(ref,current_asmdata.RefAsmSymbol('FPC_RAISEDEXCEPTION',AT_DATA),0,1,[]);
+              extra_slots:=prepare_stack_for_ref(list,ref,false);
+              a_load_ref_stack(list,u8inttype,ref,extra_slots);
+            end
+          else
+            begin
+              pd:=search_system_proc('fpc_raised_exception_flag');
+              g_call_system_proc(list,pd,[],nil).resetiftemp;
+            end;
 
           decstack(current_asmdata.CurrAsmList,1);
 
diff --git a/compiler/wasm32/nwasmset.pas b/compiler/wasm32/nwasmset.pas
index ec0123cc..60b8940e 100644
--- a/compiler/wasm32/nwasmset.pas
+++ b/compiler/wasm32/nwasmset.pas
@@ -46,6 +46,7 @@ interface
       protected
         procedure genlinearlist(hp : pcaselabel);override;
         procedure genlinearcmplist(hp : pcaselabel);override;
+        procedure genjumptable(hp : pcaselabel;min_,max_ : int64);override;
       public
