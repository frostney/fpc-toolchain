 end;
 
-{ a negated while condition }
+{ a negated while condition: the type check keeps "not done" as done and
+  lnf_checknegate (it folds "not (i >= n)" into i < n instead) }
 function sum9(p: PRec; n: longint): double; noinline;
 var
   i: longint;
   s: double;
+  done: boolean;
 begin
   s := 0;
   i := 0;
-  while not (i >= n) do
+  done := i >= n;
+  while not done do
     begin
       s := s + p^.x;
       inc(i);
+      done := i >= n;
     end;
   result := s;
 end;
diff --git a/tests/test/opt/tslp3.pp b/tests/test/opt/tslp3.pp
new file mode 100644
index 00000000..bd3421de
--- /dev/null
+++ b/tests/test/opt/tslp3.pp
@@ -0,0 +1,159 @@
+{ %CPU=x86_64 }
+{ %OPT=-O4 -OoNOFASTMATH }
+{ loads through a pointer that a loop does not change go before the loop
+  (optslp, do_hoist_invariant_loads) only when nothing can tell: not when an
+  inline routine such as include writes them, not when a goto can enter the
+  loop body, and not when the first iteration can raise an exception before
+  it reaches the load }
+program tslp3;
+
+{$mode objfpc}{$goto on}
+
+uses
+  sysutils;
+
+type
+  PRec = ^TRec;
+  TRec = record
+    s: set of 0..31;
+    k: longint;
+    x: double;
+  end;
+
+var
+  errors: longint;
+
+procedure check(ok: boolean; const what: string);
+  begin
+    if not ok then
+      begin
+        writeln('wrong: ', what);
+        inc(errors);
+      end;
+  end;
+
+procedure mark(q: PRec; n: longint); noinline;
+var
+  i: longint;
+begin
+  i := 0;
+  while i < n do
+    begin
+      include(q^.s, i);
+      inc(i);
+    end;
+end;
+
+procedure unmark(q: PRec; n: longint); noinline;
+var
+  i: longint;
+begin
+  i := 0;
+  while i < n do
+    begin
+      exclude(q^.s, i);
+      inc(i);
+    end;
+end;
+
+procedure markfor(q: PRec; n: longint); noinline;
+var
+  i: longint;
+begin
+  for i := 0 to n - 1 do
+    include(q^.s, i);
+end;
+
+{ the goto skips the first load of p^.x }
+function sumgoto(p: PRec; n: longint; skip: boolean): double; noinline;
+label
+  L;
+var
+  i: longint;
+  s: double;
+begin
+  s := 0;
+  i := 0;
+  if skip then
+    goto L;
+  while i < n do
+    begin
+      s := s + p^.x;
+    L:
+      inc(i);
+    end;
+  result := s;
+end;
+
+{ the division raises before the first iteration loads p^.x }
+function sumdiv(p: PRec; n, d: longint): double; noinline;
+var
+  i, k: longint;
+  s: double;
+begin
+  s := 0;
+  i := 0;
+  k := 0;
+  while i < n do
+    begin
+      k := k + 100 div d;
+      s := s + p^.x;
+      inc(i);
+    end;
+  result := s + k;
+end;
+
+{ a guard: the store is done before the first iteration loads p^.x, and the
+  exception handler reads it }
+function sumstore(p: PRec; n: longint): longint; noinline;
+var
+  i, k: longint;
+  s: double;
+begin
+  k := 0;
+  s := 0;
+  try
+    i := 0;
+    while i < n do
+      begin
+        k := i + 1;
+        s := s + p^.x;
+        inc(i);
+      end;
+  except
+    exit(k);
+  end;
+  result := trunc(s);
+end;
+
+var
+  r: TRec;
+  what: string;
+begin
+  r.s := [];
+  mark(@r, 3);
+  check(r.s = [0, 1, 2], 'include');
+  r.s := [0..31];
+  unmark(@r, 3);
+  check(r.s = [3..31], 'exclude');
+  r.s := [];
+  markfor(@r, 3);
+  check(r.s = [0, 1, 2], 'include in a for loop');
+  r.x := 2;
+  check(sumgoto(@r, 3, true) = 4, 'goto');
+  check(sumgoto(@r, 3, false) = 6, 'goto b');
+  what := '';
+  try
+    sumdiv(nil, 3, 0);
+  except
+    on e: Exception do
+      what := e.ClassName;
+  end;
+  check(what = 'EDivByZero', 'div before the load: ' + what);
+  check(sumdiv(@r, 3, 50) = 12, 'div b');
+  check(sumstore(nil, 3) = 1, 'store before the load');
+  check(sumstore(@r, 3) = 6, 'store b');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
