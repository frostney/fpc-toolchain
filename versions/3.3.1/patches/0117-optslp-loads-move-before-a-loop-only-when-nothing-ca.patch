 tests/test/opt/tslp2.pp |   8 +-
 tests/test/opt/tslp3.pp | 159 +++++++++++++++++++++++++++++++++
 3 files changed, 351 insertions(+), 4 deletions(-)
 create mode 100644 tests/test/opt/tslp3.pp

diff --git a/compiler/optslp.pas b/compiler/optslp.pas
