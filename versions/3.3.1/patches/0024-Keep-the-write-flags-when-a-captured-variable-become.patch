From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Fri, 16 Oct 2026 00:24:51 +0100
Subject: [PATCH 24/75] Keep the write flags when a captured variable becomes a
 closure field access (#41828)

convert_captured_sym replaces a captured variable by Self.field but drops
nf_write/nf_modify/nf_address_taken. Common subexpression elimination only
skips nodes with those flags, so it merged both sides of n := n + 1 into a
temp and the store went to the temp: the #41828 program prints 5 5 at
-O3/-O4, -O2 -OoUSELOADMODIFYSTORE and -O1 -OoCSE; n := n * 3 and passing
the captured variable as a var parameter already fail at -O2.
---
 compiler/procdefutil.pas | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/compiler/procdefutil.pas b/compiler/procdefutil.pas
index 866c4bc2..542820b6 100644
--- a/compiler/procdefutil.pas
+++ b/compiler/procdefutil.pas
@@ -1481,6 +1481,7 @@ implementation
       i : longint;
       old_filepos : tfileposinfo;
       loadprocvar : boolean;
+      accessflags : tnodeflags;
       paras: tnode;
       cnf : tcallnodeflags;
       paraold,
@@ -1500,6 +1501,11 @@ implementation
                 old_filepos:=current_filepos;
                 current_filepos:=n.fileinfo;
                 loadprocvar:=nf_load_procvar in n.flags;
+                { keep the write/modify/address-taken information of the
+                  original load (set by mark_write, set_varstate and
+                  make_not_regable during the type check), the node
+                  optimizers (CSE, DFA, LMS, ...) rely on it }
+                accessflags:=n.flags*[nf_write,nf_modify,nf_address_taken];
                 n.free;
                 n:=csubscriptnode.create(mapping^.newsym,mapping^.selfnode.getcopy);
                 if loadprocvar then
@@ -1508,6 +1514,7 @@ implementation
                     (vo_is_self in tparavarsym(mapping^.oldsym).varoptions) and
                     not is_implicit_pointer_object_type(tparavarsym(mapping^.oldsym).vardef) then
                   n:=cderefnode.create(n);
+                n.flags:=n.flags+accessflags;
                 typecheckpass(n);
                 current_filepos:=old_filepos;
                 break;
