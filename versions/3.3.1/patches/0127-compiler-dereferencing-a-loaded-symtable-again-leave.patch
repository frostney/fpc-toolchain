+procedure TTestRecompile.TestReloadCopy;
+// child (copied enum, object and record types, a generic with an interface
+// constraint, an overriding indexed property) stays loaded while control's
+// new CRC recompiles base: dereferencing child's symtable again must leave
+// what one dereference leaves
+var
+  Dir: String;
+begin
+  Dir:='reloadcopy';
+  UnitPath:=Dir+';'+Dir+PathDelim+'src1';
+  OutDir:=Dir+PathDelim+'ppus';
+  MainSrc:=Dir+PathDelim+'reloadcopy_prg.pas';
+  MakeDateDiffer(
+    Dir+PathDelim+'src1'+PathDelim+'reloadcopy_control.pas',
+    Dir+PathDelim+'src2'+PathDelim+'reloadcopy_control.pas');
+
+  Step:='First compile';
+  CleanOutputDir;
+  Compile;
+  CheckCompiled(['reloadcopy_prg.pas','reloadcopy_base.pas',
+    'reloadcopy_child.pas','reloadcopy_control.pas']);
+
+  Step:='Second compile';
+  UnitPath:=Dir+';'+Dir+PathDelim+'src2';
+  Compile;
+  CheckCompiled(['reloadcopy_prg.pas','reloadcopy_base.pas','reloadcopy_control.pas']);
+end;
+
 procedure TTestRecompile.TestReloadClassIs;
 // child defines TChild = class(TBase). Changing control recompiles base.
 // child.ppu stays loaded, so "Value is TChild" must see the new TBase.
