diff --git a/compiler/symbase.pas b/compiler/symbase.pas
index 219baa8f..19865c58 100644
--- a/compiler/symbase.pas
+++ b/compiler/symbase.pas
@@ -164,6 +164,14 @@ interface
 {$endif MEMDEBUG}
 
 
+
+    { st takes a counted reference to source, the symtable a copied def or an
+      overriding property shares (getcopy). Dereferencing such a def again
+      (when a used unit is recompiled) keeps the reference it holds for the
+      same table and gives back one it holds for another; a table that owner
+      made for itself is left as it is }
+    procedure replace_copied_symtable(var st:TSymtable;source:TSymtable;owner:TDefEntry);
+
 implementation
 
     uses
@@ -295,6 +303,17 @@ implementation
       end;
 
 
+    procedure replace_copied_symtable(var st:TSymtable;source:TSymtable;owner:TDefEntry);
+      begin
+        if st=source then
+          exit;
+        if assigned(st) and
+           (not assigned(owner) or (st.defowner<>owner)) then
+          st.free;
+        st:=source.getcopy;
+      end;
+
+
     function TSymtable.getcopy:TSymtable;
       begin
         inc(refcount);
diff --git a/compiler/symdef.pas b/compiler/symdef.pas
index 2e4fe9e3..5faeee3f 100644
--- a/compiler/symdef.pas
+++ b/compiler/symdef.pas
@@ -2034,7 +2034,10 @@ implementation
       var
         i : longint;
       begin
-        interfaces.capacity:=interfaces.count+interfacesderef.count;
+        { a loaded symtable can be dereferenced again (when a used unit is
+          recompiled): the list is rebuilt, not appended to }
+        interfaces.clear;
+        interfaces.capacity:=interfacesderef.count;
         for i:=0 to interfacesderef.count-1 do
           interfaces.add(pderef(interfacesderef[i])^.resolve);
       end;
@@ -3241,7 +3244,7 @@ implementation
         if df_copied_def in defoptions then
           begin
             basedef:=tenumdef(basedefderef.resolve);
-            symtable:=basedef.symtable.getcopy;
+            replace_copied_symtable(symtable,basedef.symtable,self);
           end
         else
           tenumsymtable(symtable).deref(false);
@@ -5610,7 +5613,7 @@ implementation
          if df_copied_def in defoptions then
            begin
              cloneddef:=trecorddef(cloneddefderef.resolve);
-             symtable:=cloneddef.symtable.getcopy;
+             replace_copied_symtable(symtable,cloneddef.symtable,self);
            end
          else
            tstoredsymtable(symtable).deref(false);
@@ -8285,7 +8288,7 @@ implementation
          if df_copied_def in defoptions then
            begin
              cloneddef:=tobjectdef(cloneddefderef.resolve);
-             symtable:=cloneddef.symtable.getcopy;
+             replace_copied_symtable(symtable,cloneddef.symtable,self);
            end
          else
            tstoredsymtable(symtable).deref(false);
@@ -8339,8 +8342,10 @@ implementation
           end
         else if (psym.typ<>procsym) then
           internalerror(2009111501);
-        { add ourselves to this special procsym }
-        tprocsym(psym).procdeflist.add(def);
+        { add ourselves to this special procsym, once: the helper's derefimpl
+          runs again when its symtable is dereferenced again }
+        if tprocsym(psym).procdeflist.indexof(def)<0 then
+          tprocsym(psym).procdeflist.add(def);
       end;
 
 
