+unit reloadcopy_control;
+
+{$mode objfpc}
+
+interface
+
+uses reloadcopy_base, reloadcopy_child;
+
+const Factor = 2; // changes the interface CRC, forcing base to be recompiled
+
+function Check: LongInt;
+
+implementation
+
+function Check: LongInt;
+var
+  Other: TOther;
+  R: TRecCopy;
+  L: TList1;
+begin
+  Result:=0;
+  if Warm<>cGreen then
+    Exit(1);
+  Other:=TOther.Create;
+  Other.Value:=5;
+  if Other.Value<>5 then
+    Exit(2);
+  Other.Free;
+  R.A:=9;
+  if R.A<>9 then
+    Exit(3);
+  L:=TList1.Create;
+  if L[4]<>12 then
+    Exit(5);
+  L.Free;
+end;
+
+end.
