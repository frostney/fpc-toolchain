diff --git a/tests/tppu/reloadcopy/reloadcopy_child.pas b/tests/tppu/reloadcopy/reloadcopy_child.pas
new file mode 100644
index 00000000..4121bcd9
--- /dev/null
+++ b/tests/tppu/reloadcopy/reloadcopy_child.pas
@@ -0,0 +1,60 @@
+unit reloadcopy_child;
+
+{$mode objfpc}
+
+interface
+
+uses reloadcopy_base;
+
+type
+  TColor = (cRed, cGreen, cBlue);
+  TWarm = cRed..cGreen;
+  TOther = type TBase;
+  TRec = record
+    A: LongInt;
+  end;
+  TRecCopy = type TRec;
+  IFoo = interface
+    ['{4E5A7F0C-8D1B-4C2E-9A3F-6B7C8D9E0F11}']
+    function Foo: LongInt;
+  end;
+  TFoo = class(TInterfacedObject, IFoo)
+    function Foo: LongInt;
+  end;
+  generic TBox<T: class, IFoo> = class
+    function Get(Item: T): LongInt;
+  end;
+  TList0 = class
+    function GetItem(Index: LongInt): LongInt;
+    property Items[Index: LongInt]: LongInt read GetItem; default;
+  end;
+  TList1 = class(TList0)
+  public
+    property Items; default;
+  end;
+
+function Warm: TWarm;
+
+implementation
+
+function TFoo.Foo: LongInt;
+begin
+  Result:=7;
+end;
+
+function TBox.Get(Item: T): LongInt;
+begin
+  Result:=(Item as IFoo).Foo;
+end;
+
+function TList0.GetItem(Index: LongInt): LongInt;
+begin
+  Result:=Index*3;
+end;
+
+function Warm: TWarm;
+begin
+  Result:=cGreen;
+end;
+
+end.
diff --git a/tests/tppu/reloadcopy/reloadcopy_prg.pas b/tests/tppu/reloadcopy/reloadcopy_prg.pas
new file mode 100644
index 00000000..fa985f39
--- /dev/null
+++ b/tests/tppu/reloadcopy/reloadcopy_prg.pas
@@ -0,0 +1,23 @@
+program reloadcopy_prg;
+
+{$mode objfpc}
+
+uses reloadcopy_child, reloadcopy_control, reloadcopy_base;
+
+type
+  TFooBox = specialize TBox<TFoo>;
+
+var
+  Foo: TFoo;
+  Keep: IFoo;
+  Box: TFooBox;
+begin
+  if Check<>0 then
+    Halt(Check);
+  Foo:=TFoo.Create;
+  Keep:=Foo;
+  Box:=TFooBox.Create;
+  if Box.Get(Foo)<>7 then
+    Halt(4);
+  Box.Free;
+end.
