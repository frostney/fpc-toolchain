+procedure check(got, expected: boolean; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+{ registers }
+function r_lt_double(a, b: double): boolean; noinline;
+begin
+  r_lt_double := a < b;
+end;
+
+{ jump }
+function j_lt_double(a, b: double): longint; noinline;
+begin
+  if a < b then j_lt_double := 1 else j_lt_double := 0;
+end;
+
+{ memory operand on either side }
+function m1_lt_double(a: double; p: PDouble): boolean; noinline;
+begin
+  if a < p^ then m1_lt_double := true else m1_lt_double := false;
+end;
+
+function m2_lt_double(p: PDouble; b: double): boolean; noinline;
+begin
+  m2_lt_double := p^ < b;
+end;
+
+{ loop condition with and/or }
+function w_lt_double(a, b: double): longint; noinline;
+var
+  n: longint;
+begin
+  n := 0;
+  while (n < 3) and (a < b) do
+    inc(n);
+  w_lt_double := n;
+end;
+
+function o_lt_double(a, b: double; c: boolean): boolean; noinline;
+begin
+  o_lt_double := c or (a < b);
+end;
+
+{ constant on the right }
+function c_lt_double(a: double): boolean; noinline;
+begin
+  c_lt_double := a < 1.5;
