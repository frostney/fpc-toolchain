From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Sat, 7 Nov 2026 15:05:51 +0000
Subject: [PATCH 105/116] x86: allocate the flags for floating-point compares

second_cmpfloatvector ((v)comiss/(v)comisd) and the x87 compare
(fcomip, fnstsw/sahf) did not allocate NR_DEFAULTFLAGS, so the peephole
optimiser saw the flags as unused between the compare and their use. The
J(c)Mov1Jmp/Mov0Jmp -> SETcc optimisation inserts mov $0,%reg before the
SETcc, and PostPeepholeOptMov then turned it into xor %reg,%reg, clobbering
the flags: at -O2 and up, "if a <> b then r := 1 else r := 0" with single
operands gave 0 for 0.0 <> 1.0. Wrong code in the base as well;
tests/test/tfpcmpnan1.pp (all comparison operators with NaN, signed zeros
and ordinary values, single/double/extended, registers, memory, constants,
loops).
---
 compiler/x86/nx86add.pas |   14 +-
 tests/test/tfpcmpnan1.pp | 3650 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 3662 insertions(+), 2 deletions(-)
 create mode 100644 tests/test/tfpcmpnan1.pp

diff --git a/compiler/x86/nx86add.pas b/compiler/x86/nx86add.pas
index ca2ca332..4ba3b26c 100644
--- a/compiler/x86/nx86add.pas
+++ b/compiler/x86/nx86add.pas
@@ -1631,10 +1631,15 @@ unit nx86add;
 
         if (right.location.loc in [LOC_MMREGISTER,LOC_CMMREGISTER]) then
           begin
+            { the flags are live from the compare to their use: without the
+              allocation, the peephole optimiser may put a flag-changing
+              instruction in between (mov $0,%reg -> xor %reg,%reg) }
+            if left.location.loc in [LOC_REFERENCE,LOC_CREFERENCE] then
+              tcgx86(cg).make_simple_ref(current_asmdata.CurrAsmList,left.location.reference);
+            cg.a_reg_alloc(current_asmdata.CurrAsmList,NR_DEFAULTFLAGS);
             case left.location.loc of
               LOC_REFERENCE,LOC_CREFERENCE:
                 begin
-                  tcgx86(cg).make_simple_ref(current_asmdata.CurrAsmList,left.location.reference);
                   current_asmdata.CurrAsmList.concat(taicpu.op_ref_reg(op,S_NO,left.location.reference,right.location.register));
                 end;
               LOC_MMREGISTER,LOC_CMMREGISTER:
@@ -1647,10 +1652,12 @@ unit nx86add;
         else
           begin
             hlcg.location_force_mmregscalar(current_asmdata.CurrAsmList,left.location,left.resultdef,true);
+            if right.location.loc in [LOC_REFERENCE,LOC_CREFERENCE] then
+              tcgx86(cg).make_simple_ref(current_asmdata.CurrAsmList,right.location.reference);
+            cg.a_reg_alloc(current_asmdata.CurrAsmList,NR_DEFAULTFLAGS);
             case right.location.loc of
               LOC_REFERENCE,LOC_CREFERENCE:
                 begin
-                  tcgx86(cg).make_simple_ref(current_asmdata.CurrAsmList,right.location.reference);
                   current_asmdata.CurrAsmList.concat(taicpu.op_ref_reg(op,S_NO,right.location.reference,left.location.register));
                 end;
               LOC_MMREGISTER,LOC_CMMREGISTER:
@@ -1840,6 +1847,7 @@ unit nx86add;
                 inc(tmpref.offset);
                 emit_ref_reg(A_MOV,S_B,tmpref,NR_AH);
                 dec(tmpref.offset);
+                cg.a_reg_alloc(current_asmdata.CurrAsmList,NR_DEFAULTFLAGS);
                 emit_none(A_SAHF,S_NO);
                 cg.ungetcpuregister(current_asmdata.CurrAsmList,NR_AX);
                 tg.ungettemp(current_asmdata.CurrAsmList,tmpref);
@@ -1849,6 +1857,7 @@ unit nx86add;
               begin
                 cg.getcpuregister(current_asmdata.CurrAsmList,NR_AX);
                 emit_reg(A_FNSTSW,S_NO,NR_AX);
+                cg.a_reg_alloc(current_asmdata.CurrAsmList,NR_DEFAULTFLAGS);
                 emit_none(A_SAHF,S_NO);
                 cg.ungetcpuregister(current_asmdata.CurrAsmList,NR_AX);
               end;
@@ -1858,6 +1867,7 @@ unit nx86add;
         else
 {$endif x86_64}
           begin
+            cg.a_reg_alloc(current_asmdata.CurrAsmList,NR_DEFAULTFLAGS);
             current_asmdata.CurrAsmList.concat(taicpu.op_reg_reg(A_FCOMIP,S_NO,NR_ST1,NR_ST0));
             { fcomip pops only one fpu register }
             current_asmdata.CurrAsmList.concat(taicpu.op_reg(A_FSTP,S_NO,NR_ST0));
