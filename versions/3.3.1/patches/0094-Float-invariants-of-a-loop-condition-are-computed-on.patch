diff --git a/tests/test/opt/tloopinv2.pp b/tests/test/opt/tloopinv2.pp
new file mode 100644
index 00000000..0c27a541
--- /dev/null
+++ b/tests/test/opt/tloopinv2.pp
@@ -0,0 +1,100 @@
+{ %OPT=-O3 }
+{ float invariants of a loop condition (optloop.optimize_loop_invariants):
+  computed before the loop only where the first test evaluates them }
+program tloopinv2;
+
+{$mode objfpc}
+
+uses
+  sysutils, math;
+
+var
+  errors: longint = 0;
+  limit: double;
+  big: double;
+  g: double;
+
+procedure check(ok: boolean; const what: string);
+begin
+  if not ok then
+    begin
+      writeln('failed: ', what);
+      inc(errors);
+    end;
+end;
+
+{ the classic escape test }
+function iterations(cr: double): longint;
+var
+  zr, tr: double;
+  i: longint;
+begin
+  zr := 0; tr := 0; i := 0;
+  while (i < 50) and (tr <= limit * limit) do
+    begin
+      zr := tr + cr;
+      tr := zr * zr;
+      inc(i);
+    end;
+  result := i;
+end;
+
+{ n = 0: big * big would overflow, but the first operand is false so the
+  original never evaluates it }
+function guarded(n: longint): longint;
+var
+  i: longint;
+begin
+  i := 0;
+  while (i < n) and (i < big * big) do
+    inc(i);
+  result := i;
+end;
+
+{ below "or": not hoisted (would be evaluated speculatively) }
+function viaor(n: longint): longint;
+var
+  i: longint;
+begin
+  i := 0;
+  while (i < n) or (i < limit * limit) do
+    inc(i);
+  result := i;
+end;
+
+{ g is written in the loop: g * 2 is not invariant }
+function written(n: longint): longint;
+var
+  i: longint;
+begin
+  i := 0;
+  g := 1;
+  while (i < n) and (g * 2 < 1000) do
+    begin
+      g := g * 2;
+      inc(i);
+    end;
+  result := i;
+end;
+
+begin
+  SetExceptionMask([exDenormalized, exUnderflow, exPrecision]);
+  limit := 2.0;
+  big := 1e300;
+  check(iterations(0.25) = 50, 'iterations 0.25');
+  check(iterations(1.0) = 3, 'iterations 1.0');
+  try
+    check(guarded(0) = 0, 'guarded');
+  except
+    on e: exception do
+      begin
+        writeln('guarded raised ', e.classname);
+        inc(errors);
+      end;
+  end;
+  check(viaor(5) = 5, 'viaor');
+  check(written(100) = 9, 'written');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
