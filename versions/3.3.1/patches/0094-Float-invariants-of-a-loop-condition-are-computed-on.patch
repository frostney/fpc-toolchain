+    { a float expression of constants and float variables the loop does not
+      write: unaliased locals and by-value parameters, or globals of the main
+      program whose address is never taken when no store in the loop goes
+      through a pointer }
+    function loopinv_floatpure(info: ploopinvinfo; n: tnode): boolean;
+      var
+        sym: tabstractvarsym;
+      begin
+        result:=false;
+        case n.nodetype of
+          realconstn:
+            result:=true;
+          loadn:
+            begin
+              if not(tloadnode(n).symtableentry.typ in [localvarsym,paravarsym,staticvarsym]) or
+                 assigned(tloadnode(n).left) then
+                exit;
+              sym:=tabstractvarsym(tloadnode(n).symtableentry);
+              if (sym.vardef.typ<>floatdef) or
+                 not(tfloatdef(sym.vardef).floattype in [s32real,s64real]) or
+                 (info^.direct.IndexOf(sym)>=0) then
+                exit;
+              if sym.typ=staticvarsym then
+                result:=not info^.badstore and
+                  assigned(current_module) and
+                  (sym.owner=current_module.localsymtable) and
+                  (current_module.globalsymtable=nil) and
+                  not sym.addr_taken and
+                  not(vo_volatile in sym.varoptions)
+              else
+                result:=assigned(local_store_base(n));
+            end;
+          addn,subn,muln:
+            result:=(n.resultdef.typ=floatdef) and
+              loopinv_floatpure(info,tbinarynode(n).left) and
+              loopinv_floatpure(info,tbinarynode(n).right);
+          { x*x is turned into sqr(x) }
+          inlinen:
+            result:=(tinlinenode(n).inlinenumber=in_sqr_real) and
+              (n.resultdef.typ=floatdef) and
+              assigned(tinlinenode(n).left) and
+              loopinv_floatpure(info,tinlinenode(n).left);
+          else
+            ;
+        end;
+      end;
+
+
+    procedure loopinv_condscan(info: ploopinvinfo; m: tnode; prefix: TFPList);
+      var
+        j, k: longint;
+        hp: tnode;
+      begin
+        if not assigned(m) then
+          exit;
+        case m.nodetype of
+          addn,subn,muln,inlinen:
+            if (m.resultdef.typ=floatdef) and loopinv_floatpure(info,m) then
+              begin
+                for j:=0 to info^.found.Count-1 do
+                  if tnode(info^.found[j]).isequal(m) then
+                    exit;
+                info^.found.Add(m);
+                if prefix.Count=0 then
+                  info^.guards.Add(nil)
+                else
+                  begin
+                    hp:=tnode(prefix[0]).getcopy;
+                    for k:=1 to prefix.Count-1 do
+                      hp:=caddnode.create(andn,hp,tnode(prefix[k]).getcopy);
+                    info^.guards.Add(hp);
+                  end;
+                exit;
+              end;
+          orn,xorn,andn,notn,ifn,calln:
+            exit;
+          else
+            ;
+        end;
+        if m.nodetype=inlinen then
+          exit;
+        if m is tbinarynode then
+          begin
+            loopinv_condscan(info,tbinarynode(m).left,prefix);
+            loopinv_condscan(info,tbinarynode(m).right,prefix);
+          end
+        else if m is tunarynode then
+          loopinv_condscan(info,tunarynode(m).left,prefix);
+      end;
+
+
+    { searches the loop condition for float invariants: only through the
+      operands of short-circuit "and" (the guard is the conjunction of the
+      operands before), never below "or", "not" or anything conditional }
+    procedure loopinv_condfloat(info: ploopinvinfo; n: tnode; prefix: TFPList);
+      var
+        i: longint;
+        p2: TFPList;
+      begin
+        if (n.nodetype=andn) and is_boolean(n.resultdef) then
+          begin
+            loopinv_condfloat(info,taddnode(n).left,prefix);
+            p2:=TFPList.Create;
+            for i:=0 to prefix.Count-1 do
+              p2.Add(prefix[i]);
+            p2.Add(taddnode(n).left);
+            loopinv_condfloat(info,taddnode(n).right,p2);
+            p2.Free;
+          end
+        else
+          loopinv_condscan(info,n,prefix);
+      end;
+
