--- a/compiler/optslp.pas
+++ b/compiler/optslp.pas
@@ -56,6 +56,10 @@ uses
 
 function do_slp_vectorize(var code: tnode): boolean;
 
+{ loads through a pointer that a loop does not change, from memory that no
