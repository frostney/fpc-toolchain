diff --git a/tests/test/opt/tslp2.pp b/tests/test/opt/tslp2.pp
new file mode 100644
index 00000000..81b9f59e
--- /dev/null
+++ b/tests/test/opt/tslp2.pp
@@ -0,0 +1,141 @@
+{ %CPU=x86_64 }
+{ %OPT=-O4 -OoNOFASTMATH }
+{ loads through a pointer that a loop does not change go before the loop
+  (optslp, do_hoist_invariant_loads) only when no store of the loop can
+  change them, and only when the loop body runs }
+program tslp2;
+
+{$mode objfpc}
+
+type
+  TRec = record
+    x, y, z, w: double;
+  end;
+  PRec = ^TRec;
+
+var
+  errors: longint = 0;
+  a: array[0..9] of TRec;
+  gsum: double;
+
+procedure check(got, expected: double; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+procedure init;
+var
+  i: longint;
+begin
+  for i := 0 to 9 do
+    begin
+      a[i].x := i; a[i].y := i * 2; a[i].z := i * 3; a[i].w := 1;
+    end;
+end;
+
+{ p^.x is invariant: q^.w stores cannot change it }
+function sum1(p: PRec; n: longint): double;
+var
+  q: PRec;
+  i: longint;
+begin
+  result := 0;
+  q := p;
+  for i := 1 to n do
+    begin
+      inc(q);
+      q^.w := q^.w + p^.x;
+      result := result + p^.x * q^.y;
+    end;
+end;
+
+{ the loop writes p^.x through q (q = p in the first iteration) }
+function sum2(p: PRec; n: longint): double;
+var
+  q: PRec;
+  i: longint;
+begin
+  result := 0;
+  q := p;
+  for i := 1 to n do
+    begin
+      q^.x := q^.x + 1;
+      result := result + p^.x;
+      inc(q);
+    end;
+end;
+
+{ written through the same pointer }
+function sum3(p: PRec; n: longint): double;
+var
+  i: longint;
+begin
+  result := 0;
+  for i := 1 to n do
+    begin
+      result := result + p^.y;
+      p^.y := p^.y * 2;
+    end;
+end;
+
+{ no iteration: p is nil and must not be dereferenced }
+function sum4(p: PRec; n: longint): double;
+var
+  i: longint;
+begin
+  result := 0;
+  for i := 1 to n do
+    result := result + p^.z;
+end;
+
+{ a while loop, the guard }
+function sum5(p: PRec; n: longint): double;
+var
+  i: longint;
+begin
+  result := 0;
+  i := 0;
+  while i < n do
+    begin
+      result := result + p^.z * i;
+      inc(i);
+    end;
+end;
+
+{ a global written in the loop }
+function sum6(p: PRec; n: longint): double;
+var
+  i: longint;
+begin
+  result := 0;
+  for i := 1 to n do
+    begin
+      gsum := gsum + p^.y;
+      result := result + p^.y;
+    end;
+end;
+
+begin
+  init;
+  check(sum1(@a[0], 5), 0, 'sum1 a');
+  check(sum1(@a[2], 5), 2 * (6 + 8 + 10 + 12 + 14), 'sum1 b');
+  check(a[3].w, 1 + 2, 'sum1 w');
+  init;
+  check(sum2(@a[1], 3), 6, 'sum2');
+  init;
+  check(sum3(@a[3], 4), 6 + 12 + 24 + 48, 'sum3');
+  check(sum4(nil, 0), 0, 'sum4');
+  check(sum4(@a[2], 2), 12, 'sum4 b');
+  check(sum5(nil, 0), 0, 'sum5');
+  check(sum5(@a[1], 4), 3 * 6, 'sum5 b');
+  gsum := 0;
+  check(sum6(@a[2], 3), 12, 'sum6');
+  check(gsum, 12, 'sum6 g');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
