-        if (right.location.loc in [LOC_MMREGISTER,LOC_CMMREGISTER]) then
+        { (u)comis sets ZF, PF and CF for unordered operands: "above" and
+          "above or equal" are false then without a parity check, "below"
+          and "below or equal" need one (a second jump or setcc). Compare
+          in the order that gives an "above" condition, also when that
+          needs the other operand in a register }
+        if (nodetype in [ltn,lten,gtn,gten]) then
+          begin
+            toggleflag(nf_swapped);
+            rightdst:=getfpuresflags in [F_FA,F_FAE];
+            toggleflag(nf_swapped);
+            if rightdst and
+               not(right.location.loc in [LOC_MMREGISTER,LOC_CMMREGISTER]) then
+              hlcg.location_force_mmregscalar(current_asmdata.CurrAsmList,right.location,right.resultdef,true)
+            else if not(rightdst) and
+               (right.location.loc in [LOC_MMREGISTER,LOC_CMMREGISTER]) and
+               not(left.location.loc in [LOC_MMREGISTER,LOC_CMMREGISTER]) then
+              hlcg.location_force_mmregscalar(current_asmdata.CurrAsmList,left.location,left.resultdef,true);
+          end
+        else
+          rightdst:=right.location.loc in [LOC_MMREGISTER,LOC_CMMREGISTER];
+        if rightdst and
+           not(left.location.loc in [LOC_REFERENCE,LOC_CREFERENCE,LOC_MMREGISTER,LOC_CMMREGISTER]) then
+          hlcg.location_force_mmregscalar(current_asmdata.CurrAsmList,left.location,left.resultdef,true);
+
+        if rightdst then
           begin
             { the flags are live from the compare to their use: without the
               allocation, the peephole optimiser may put a flag-changing
