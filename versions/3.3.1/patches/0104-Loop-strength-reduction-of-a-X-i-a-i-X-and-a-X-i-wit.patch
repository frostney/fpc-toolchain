+    function toptimizeinductionvariablescontext.is_linear_index_access(n: tnode; out sign: longint): boolean;
+      var
+        idx: tnode;
+      begin
+        result:=false;
+        sign:=0;
+        if (cs_check_range in n.localswitches) or
+           (tvecnode(n).left.nodetype<>loadn) or
+           assigned(tloadnode(tvecnode(n).left).left) or
+           (tvecnode(n).left.resultdef.typ<>arraydef) or
+           is_special_array(tvecnode(n).left.resultdef) or
+           is_packed_array(tvecnode(n).left.resultdef) or
+           not(tloadnode(tvecnode(n).left).symtableentry.typ in [localvarsym,paravarsym,staticvarsym]) or
+           ((tvecnode(n).left.flags*[nf_modify])<>[]) then
+          exit;
+        idx:=tvecnode(n).right;
+        if (idx.nodetype=typeconvn) and
+           (ttypeconvnode(idx).convtype in [tc_int_2_int,tc_equal]) then
+          idx:=ttypeconvnode(idx).left;
+        if not(idx.nodetype in [addn,subn]) or
+           (nf_internal in idx.flags) then
+          exit;
+        if is_counter(taddnode(idx).right) and
+           is_simple_invariant(taddnode(idx).left) then
+          begin
+            if idx.nodetype=addn then
+              sign:=1
+            else
+              sign:=-1;
+          end
+        else if (idx.nodetype=addn) and
+           is_counter(taddnode(idx).left) and
+           is_simple_invariant(taddnode(idx).right) then
+          sign:=1
+        else
+          exit;
+        result:=true;
+      end;
