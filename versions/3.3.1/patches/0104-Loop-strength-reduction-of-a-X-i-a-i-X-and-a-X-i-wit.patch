+++ b/tests/test/opt/tivlinear1.pp
@@ -0,0 +1,163 @@
+{ %OPT=-O3 }
+{ for loop strength reduction of a[X+i], a[i+X] and a[X-i] (X invariant):
+  every routine is compared with the same computation in a while loop }
+program tivlinear1;
+
+{$mode objfpc}
+
+type
+  tarr = array[0..63] of longint;
+  tarr8 = array[-5..40] of int64;
+
+var
+  errors: longint = 0;
+
+procedure check(got, expected: int64; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+procedure init(var a: tarr);
+var
+  i: longint;
+begin
+  for i := low(a) to high(a) do
+    a[i] := i * 7 + 3;
+end;
+
+function sum(const a: tarr): int64;
+var
+  i: longint;
+begin
+  result := 0;
+  for i := low(a) to high(a) do
+    result := result * 31 + a[i];
+end;
+
+{ the fannkuch flip }
+procedure flip(var a: tarr; k: longint);
+var
+  i, t: longint;
+begin
+  for i := 0 to (k + 1) shr 1 - 1 do
+    begin
+      t := a[i]; a[i] := a[k - i]; a[k - i] := t;
+    end;
+end;
+
+procedure flipw(var a: tarr; k: longint);
+var
+  i, t: longint;
+begin
+  i := 0;
+  while i <= (k + 1) shr 1 - 1 do
+    begin
+      t := a[i]; a[i] := a[k - i]; a[k - i] := t;
+      inc(i);
+    end;
+end;
+
+{ X+i and i+X, a start value that is not constant, downto, continue }
+procedure mix(var a: tarr; lo, hi, x: longint);
+var
+  i: longint;
+begin
+  for i := lo to hi do
+    begin
+      if i = lo + 2 then
+        continue;
+      a[x + i] := a[x + i] + a[i + x + 1] * 2 - a[x - i + 40];
+    end;
+  for i := hi downto lo do
+    a[i + x] := a[x - i + 40] - i;
+end;
+
+procedure mixw(var a: tarr; lo, hi, x: longint);
+var
+  i: longint;
+begin
+  i := lo;
+  while i <= hi do
+    begin
+      if i <> lo + 2 then
+        a[x + i] := a[x + i] + a[i + x + 1] * 2 - a[x - i + 40];
+      inc(i);
+    end;
+  i := hi;
+  while i >= lo do
+    begin
+      a[i + x] := a[x - i + 40] - i;
+      dec(i);
+    end;
+end;
+
+{ break, an array with a lower bound <> 0 and 8 byte elements }
+function brk(var b: tarr8; n, x: longint): int64;
+var
+  i: longint;
+begin
+  result := 0;
+  for i := 1 to n do
+    begin
+      if b[x - i] < 0 then
+        break;
+      result := result + b[x - i] * i;
+      b[x - i + 1] := result;
+    end;
+end;
+
+function brkw(var b: tarr8; n, x: longint): int64;
+var
+  i: longint;
+begin
+  result := 0;
+  i := 1;
+  while i <= n do
+    begin
+      if b[x - i] < 0 then
+        break;
+      result := result + b[x - i] * i;
+      b[x - i + 1] := result;
+      inc(i);
+    end;
+end;
+
+var
+  a1, a2: tarr;
+  b1, b2: tarr8;
+  k, i: longint;
+begin
+  for k := 0 to 40 do
+    begin
+      init(a1); init(a2);
+      flip(a1, k); flipw(a2, k);
+      check(sum(a1), sum(a2), 'flip');
+    end;
+  for k := -1 to 6 do
+    begin
+      init(a1); init(a2);
+      mix(a1, k, k + 9, 10); mixw(a2, k, k + 9, 10);
+      check(sum(a1), sum(a2), 'mix');
+      { no iterations }
+      mix(a1, k + 9, k, 10); mixw(a2, k + 9, k, 10);
+      check(sum(a1), sum(a2), 'mix empty');
+    end;
+  for k := 0 to 30 do
+    begin
+      for i := low(b1) to high(b1) do
+        begin
+          b1[i] := i * 3 - 20;
+          b2[i] := b1[i];
+        end;
+      check(brk(b1, k, 35), brkw(b2, k, 35), 'brk');
+      for i := low(b1) to high(b1) do
+        check(b1[i], b2[i], 'brk array');
+    end;
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
