From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Johannes Stein <johannesstein@freeze-dev.com>
Date: Fri, 16 Oct 2026 00:06:20 +0100
Subject: [PATCH 20/75] x86 GetIntRegisterBetween: do not hand out a register
 that is allocated at the start

The CMOV block optimisation (TryCMOVConst) takes a scratch register for a
constant through GetIntRegisterBetween, which trusts the tracked used-register
set. That set can lag behind the allocation markers after earlier
transformations in the same pass: for
  GW := SelU16(c1, SelU16(c2, GW, GW), ...)   { SelU16 inline, nested with SelU16(GB, 5335, 5335) }
it took %cx while %cx held the result of the first CMOV block, so GW got
5335 instead of 8 at -O3/-O4. Also require that the last allocation marker
of the register before the start is not an allocation.
---
 compiler/x86/aoptx86.pas | 24 +++++++++++++++++++++++-
 1 file changed, 23 insertions(+), 1 deletion(-)

diff --git a/compiler/x86/aoptx86.pas b/compiler/x86/aoptx86.pas
index cab25823..615915e3 100644
--- a/compiler/x86/aoptx86.pas
+++ b/compiler/x86/aoptx86.pas
@@ -1559,6 +1559,27 @@ unit aoptx86;
         CurrentReg: TRegister;
         Currentp: tai;
         Breakout: Boolean;
+
+      { True if the last allocation marker of Reg's super register before APos is
+        an allocation, i.e. Reg holds a live value at APos. AUsedRegs can lag
+        behind the markers after earlier transformations in the same pass. }
+      function AllocatedByMarkers(Reg: TRegister; APos: tai): Boolean;
+        var
+          hp2: tai;
+        begin
+          Result := False;
+          hp2 := APos;
+          while Assigned(hp2) do
+            begin
+              if (hp2.typ = ait_regalloc) and SuperRegistersEqual(tai_regalloc(hp2).reg, Reg) then
+                begin
+                  Result := (tai_regalloc(hp2).ratype <> ra_dealloc);
+                  Exit;
+                end;
+              hp2 := tai(hp2.Previous);
+            end;
+        end;
+
       begin
         Result := NR_NO;
         RegSet :=
@@ -1572,7 +1593,8 @@ unit aoptx86;
         for CurrentSuperReg in RegSet do
           begin
             CurrentReg := newreg(R_INTREGISTER, TSuperRegister(CurrentSuperReg), RegSize);
-            if not AUsedRegs[R_INTREGISTER].IsUsed(CurrentReg)
+            if not AUsedRegs[R_INTREGISTER].IsUsed(CurrentReg) and
+              not AllocatedByMarkers(CurrentReg, p)
 {$if defined(i386) or defined(i8086)}
               { If the target size is 8-bit, make sure we can actually encode it }
               and (
