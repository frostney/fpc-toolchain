diff --git a/tests/tppu/reloadclass/reloadclass_child.pas b/tests/tppu/reloadclass/reloadclass_child.pas
new file mode 100644
index 00000000..1d086c03
--- /dev/null
+++ b/tests/tppu/reloadclass/reloadclass_child.pas
@@ -0,0 +1,31 @@
+unit reloadclass_child;
+
+{$mode objfpc}
+{$inline on}
+
+interface
+
+uses reloadclass_base;
+
+procedure Accept(Value: TBase);
+function Inlined(Value: TBase): TBase; inline;
+
+implementation
+
+function Identity(Value: TBase): TBase;
+begin
+  Result:=Value;
+end;
+
+procedure Accept(Value: TBase);
+begin
+  Value.Value:=42;
+end;
+
+function Inlined(Value: TBase): TBase;
+begin
+  Result:=Identity(Value);
+  Accept(Result);
+end;
+
+end.
\ No newline at end of file
