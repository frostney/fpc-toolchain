 compiler/htypechk.pas        |  9 +++++---
 compiler/symsym.pas          | 16 +++++++++++++
 compiler/wasm32/cpuinfo.pas  |  4 ++--
 compiler/wasm32/nwasmflw.pas |  6 +++++
 compiler/wasm32/rgcpu.pas    | 10 ++++++++
 6 files changed, 84 insertions(+), 5 deletions(-)

diff --git a/compiler/hlcgobj.pas b/compiler/hlcgobj.pas
index e4dc80d3..9e77513e 100644
--- a/compiler/hlcgobj.pas
+++ b/compiler/hlcgobj.pas
@@ -5480,6 +5480,26 @@ implementation
           { don't use currpara.vardef, as this will be wrong in case of
             call-by-reference parameters (it won't contain the pointer) }
           gen_load_cgpara_loc(list,currpara.paraloc[calleeside].def,currpara.paraloc[calleeside],currpara.initialloc,paramanager.param_use_paraloc(currpara.paraloc[calleeside]));
+          { a register variable parameter: gen_load_cgpara_loc allocated its
+            register, make it the variable's location (as thlcg2ll does) }
+          if currpara.initialloc.loc in [LOC_CREGISTER,LOC_CFPUREGISTER] then
+            begin
+{$ifdef wasm32}
+              { callers pass unsigned 8/16-bit values sign-extended (the
+                parameter location's def is the signed type), normalise
+                to the variable's type (a memory copy does this through its
+                narrow store and load) }
+              if (currpara.initialloc.loc=LOC_CREGISTER) and
+                 (currpara.paraloc[calleeside].def<>currpara.vardef) and
+                 is_ordinal(currpara.vardef) and
+                 (currpara.paraloc[calleeside].def.size=currpara.vardef.size) and
+                 (currpara.vardef.size<4) then
+                a_load_reg_reg(list,currpara.paraloc[calleeside].def,currpara.vardef,
+                  currpara.initialloc.register,currpara.initialloc.register);
+{$endif wasm32}
+              gen_alloc_regvar(list,currpara,false);
+              varsym_set_localloc(list,currpara);
+            end;
         end;
 
       { generate copies of call by value parameters, must be done before
@@ -5777,6 +5797,30 @@ implementation
                 end;
               end;
           end;
+        LOC_CREGISTER,
+        LOC_CFPUREGISTER:
+          begin
+            { a parameter that is a register variable (cs_opt_regvar on
+              high level code generator targets such as wasm32) }
+            case para.location^.loc of
+              LOC_REFERENCE,LOC_CREFERENCE:
+                begin
+                  reference_reset_base(href,voidstackpointertype,para.location^.reference.index,para.location^.reference.offset,ctempposinvalid,para.alignment,[]);
+                  if destloc.loc=LOC_CFPUREGISTER then
+                    begin
+                      destloc.register:=getfpuregister(list,vardef);
+                      a_loadfpu_ref_reg(list,para.def,vardef,href,destloc.register);
+                    end
+                  else
+                    begin
+                      destloc.register:=getregisterfordef(list,vardef);
+                      a_load_ref_reg(list,para.def,vardef,href,destloc.register);
+                    end;
+                end;
+              else
+                internalerror(2026101605);
+            end;
+          end;
         { TODO other possible locations }
         else
           internalerror(2011010308);
