diff --git a/tests/test/opt/tnonnegdiv1.pp b/tests/test/opt/tnonnegdiv1.pp
new file mode 100644
index 00000000..84f10675
--- /dev/null
+++ b/tests/test/opt/tnonnegdiv1.pp
@@ -0,0 +1,95 @@
+{ %OPT=-O3 }
+{ signed div/mod by powers of 2 become shr/and when the dividend is known to
+  be non-negative (for loop counters, constants, type ranges, temps); every
+  result is compared with the same operation on an opaque value }
+program tnonnegdiv1;
+
+{$mode objfpc}
+
+var
+  errors: longint = 0;
+
+procedure check(got, expected: int64; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+function opaque(x: int64): int64; noinline;
+begin
+  opaque := x;
+end;
+
+function a(i, j: smallint): int64; inline;
+begin
+  a := (i + j) * (i + j + 1) div 2 + i + 1;
+end;
+
+procedure counters(lo, hi: smallint);
+var
+  i, j: smallint;
+  x: int64;
+begin
+  for i := lo to hi do
+    for j := 0 to 5 do
+      begin
+        x := a(i, j);
+        check(x, (opaque(i + j) * opaque(i + j + 1)) div 2 + i + 1, 'a');
+        check((i + j) div 4, opaque(i + j) div 4, 'div4');
+        check((i + j) mod 8, opaque(i + j) mod 8, 'mod8');
+        check((i * j) div 2, opaque(i * j) div 2, 'mul div2');
+      end;
+end;
+
+procedure downto_(hi: longint);
+var
+  i: longint;
+begin
+  for i := hi downto 0 do
+    check((i - 3) div 2, opaque(i - 3) div 2, 'downto');
+  for i := hi downto -5 do
+    check(i div 2, opaque(i) div 2, 'downto neg');
+end;
+
+procedure types_(b: byte; w: word; s: shortint);
+var
+  i: longint;
+begin
+  check(b div 4, opaque(b) div 4, 'byte');
+  check((w * w) div 8, opaque(w * w) div 8, 'word sq');
+  check(s div 2, opaque(s) div 2, 'shortint');
+  check((b - 200) div 2, opaque(b - 200) div 2, 'byte sub');
+  for i := 0 to 3 do
+    check(longint(i * 1000000000 * 3) div 2, opaque(longint(i * 1000000000 * 3)) div 2, 'narrowed');
+end;
+
+procedure big;
+var
+  i: longint;
+  x: int64;
+begin
+  for i := 2147483600 to 2147483647 do
+    begin
+      x := int64(i) * i;
+      check(x div 2, opaque(x) div 2, 'big');
+      check((int64(i) * i * 4) div 2, opaque(int64(i) * i * 4) div 2, 'overflow');
+    end;
+end;
+
+var
+  b: byte;
+begin
+  counters(0, 30);
+  counters(-20, 5);
+  counters(32760, 32767);
+  downto_(10);
+  for b := 0 to 255 do
+    types_(b, b * 257, shortint(b));
+  big;
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
