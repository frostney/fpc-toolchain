diff --git a/compiler/optbitcast.pas b/compiler/optbitcast.pas
new file mode 100644
index 00000000..ff15f49a
--- /dev/null
+++ b/compiler/optbitcast.pas
@@ -0,0 +1,238 @@
+{
+    Copyright (c) 2026 by the fpc-toolchain contributors
+
+    Reading a variable's bits through a typed pointer to it
+
+    This program is free software; you can redistribute it and/or modify
+    it under the terms of the GNU General Public License as published by
+    the Free Software Foundation; either version 2 of the License, or
+    (at your option) any later version.
+
+    This program is distributed in the hope that it will be useful,
+    but WITHOUT ANY WARRANTY; without even the implied warranty of
+    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+    GNU General Public License for more details.
+
+    You should have received a copy of the GNU General Public License
+    along with this program; if not, write to the Free Software
+    Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+
+ ****************************************************************************
+}
+unit optbitcast;
+
+{ "PInt64(@d)^" (or PUInt64, PDouble, ... of a local variable or by-value
+  parameter of the same size) is the usual way to read the bits of a Double.
+  Taking the address forces d into memory for the whole routine, so every
+  value stored to it goes through a store and a reload.
+
+  taddrnode.pass_typecheck marks @v of such a variable pending
+  (anf_bitcast_pending, see mark_bitcast_pending) instead of making it
+  non-regable. Once the routine is parsed (before its
+  inline info is copied), resolve_pending_bitcasts looks at every marked
+  address node: in PT(@v)^ with a scalar T of v's size that is read, it becomes an internal tc_equal type conversion
+  of the variable itself (second_nothing moves an xmm register to an integer
+  register for it); where it is written or its address is needed (assignment
+  target, argument other than a value parameter, inline node argument,
+  operand of @), the variable is made non-regable as before. }
+
+{$i fpcdefs.inc}
+
+interface
+
+uses
+  node,symtype;
+
+{ called by taddrnode.pass_typecheck for @v: true when v is a scalar local
+  variable or by-value parameter of the current routine; the address node is
+  then marked pending instead of making v non-regable }
+function mark_bitcast_pending(addr: tnode): boolean;
+
+procedure resolve_pending_bitcasts(var code: tnode);
+
+implementation
+
+uses
+  cclasses,
+  globtype,globals,
+  symconst,symdef,symsym,
+  defutil,defcmp,htypechk,procinfo,
+  nutils,nbas,ncal,ncnv,ninl,nld,nmem,
+  pass_1;
+
+
+function is_bitcast_scalar(def: tdef): boolean;
+  begin
+    result:=(def.typ in [orddef,enumdef,pointerdef]) or
+      ((def.typ=floatdef) and (tfloatdef(def).floattype in [s32real,s64real]));
+    result:=result and (def.size in [4,8]);
+  end;
+
+
+{ deref(typeconv*(addr(load v))) with a pointer type of the same size }
+function pattern_addr(deref: tnode): taddrnode;
+  var
+    n: tnode;
+  begin
+    result:=nil;
+    if deref.nodetype<>derefn then
+      exit;
+    n:=tderefnode(deref).left;
+    while assigned(n) and (n.nodetype=typeconvn) do
+      n:=ttypeconvnode(n).left;
+    if assigned(n) and (n.nodetype=addrn) then
+      result:=taddrnode(n);
+  end;
+
+
+function bitcast_var(addr: taddrnode): tabstractvarsym;
+  begin
+    result:=nil;
+    if not assigned(addr.left) or
+       (addr.left.nodetype<>loadn) or
+       assigned(tloadnode(addr.left).left) or
+       not(tloadnode(addr.left).symtableentry.typ in [localvarsym,paravarsym]) then
+      exit;
+    result:=tabstractvarsym(tloadnode(addr.left).symtableentry);
+  end;
+
+
+function mark_bitcast_pending(addr: tnode): boolean;
+  var
+    vs: tabstractvarsym;
+  begin
+    result:=false;
+    if not(cs_opt_regvar in current_settings.optimizerswitches) or
+       not assigned(current_procinfo) or
+       (addr.nodetype<>addrn) or
+       (taddrnode(addr).addrnodeflags*[anf_ofs]<>[]) then
+      exit;
+    vs:=bitcast_var(taddrnode(addr));
+    if not assigned(vs) or
+       not assigned(vs.vardef) or
+       ((vs.owner<>current_procinfo.procdef.localst) and
+        (vs.owner<>current_procinfo.procdef.parast)) or
+       (vo_volatile in vs.varoptions) or
+       not is_bitcast_scalar(vs.vardef) then
+      exit;
+    if (vs.typ=paravarsym) and not(vs.varspez in [vs_value,vs_const]) then
+      exit;
+    include(taddrnode(addr).addrnodeflags,anf_bitcast_pending);
+    result:=true;
+  end;
+
+
+type
+  tbitcastinfo = record
+    written: TFPList;   { derefn nodes in a write or address position }
+  end;
+  pbitcastinfo = ^tbitcastinfo;
+
+
+{ the root of an l-value or of an address: through fields, elements and casts }
+procedure mark_spine(info: pbitcastinfo; n: tnode);
+  begin
+    while assigned(n) and (n.nodetype in [subscriptn,vecn,typeconvn]) do
+      n:=tunarynode(n).left;
+    if assigned(n) and (n.nodetype=derefn) and assigned(pattern_addr(n)) then
+      info^.written.Add(n);
+  end;
+
+
+function find_writes(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pbitcastinfo absolute arg;
+    p: tnode;
+  begin
+    result:=fen_false;
+    case n.nodetype of
+      assignn:
+        mark_spine(info,tassignmentnode(n).left);
+      addrn:
+        if not(anf_bitcast_pending in taddrnode(n).addrnodeflags) then
+          mark_spine(info,taddrnode(n).left);
+      callparan:
+        if not assigned(tcallparanode(n).parasym) or
+           (tcallparanode(n).parasym.varspez<>vs_value) or
+           (tcallparanode(n).parasym.vardef.typ=formaldef) then
+          mark_spine(info,tcallparanode(n).left);
+      inlinen:
+        begin
+          p:=tinlinenode(n).left;
+          if assigned(p) and (p.nodetype=callparan) then
+            while assigned(p) do
+              begin
+                mark_spine(info,tcallparanode(p).left);
+                p:=tcallparanode(p).right;
+              end
+          else
+            mark_spine(info,p);
+        end;
+      else
+        ;
+    end;
+  end;
+
+
+function rewrite_reads(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pbitcastinfo absolute arg;
+    addr: taddrnode;
+    hp: tnode;
+  begin
+    result:=fen_false;
+    if n.nodetype<>derefn then
+      exit;
+    addr:=pattern_addr(n);
+    if not assigned(addr) or
+       not(anf_bitcast_pending in addr.addrnodeflags) or
+       (info^.written.IndexOf(n)>=0) or
+       not assigned(n.resultdef) or
+       not assigned(addr.left.resultdef) or
+       not is_bitcast_scalar(n.resultdef) or
+       (n.resultdef.size<>addr.left.resultdef.size) then
+      exit;
+    hp:=ctypeconvnode.create_internal(addr.left.getcopy,n.resultdef);
+    ttypeconvnode(hp).convtype:=tc_equal;
+    { not explicit: ttypeconvnode.pass_1 makes the operand of an explicit
+      float to non-float cast non-regable }
+    exclude(hp.flags,nf_explicit);
+    hp.fileinfo:=n.fileinfo;
+    typecheckpass(hp);
+    set_varstate(ttypeconvnode(hp).left,vs_read,[vsf_must_be_valid]);
+    n.free;
+    n:=hp;
+    result:=fen_norecurse_true;
+  end;
+
+
+{ what was not rewritten keeps the old meaning: the variable is in memory }
+function finish_pending(var n: tnode; arg: pointer): foreachnoderesult;
+  begin
+    result:=fen_false;
+    if (n.nodetype=addrn) and
+       (anf_bitcast_pending in taddrnode(n).addrnodeflags) then
+      begin
+        exclude(taddrnode(n).addrnodeflags,anf_bitcast_pending);
+        make_not_regable(taddrnode(n).left,[ra_addr_regable,ra_addr_taken]);
+      end;
+  end;
+
+
+procedure resolve_pending_bitcasts(var code: tnode);
+  var
+    info: tbitcastinfo;
+  begin
+    if not assigned(code) then
+      exit;
+    info.written:=TFPList.Create;
+    try
+      foreachnodestatic(pm_postprocess,code,@find_writes,@info);
+      foreachnodestatic(pm_postprocess,code,@rewrite_reads,@info);
+      foreachnodestatic(pm_postprocess,code,@finish_pending,nil);
+    finally
+      info.written.Free;
+    end;
+  end;
+
+end.
diff --git a/compiler/psub.pas b/compiler/psub.pas
index 60201e06..d18c1428 100644
--- a/compiler/psub.pas
+++ b/compiler/psub.pas
@@ -144,7 +144,7 @@ implementation
        fmodule,
        { pass 1 }
        ngenutil,nld,ncal,ncon,nflw,nadd,ncnv,nmem,
-       optexcregvar,
+       optexcregvar,optbitcast,
        pass_1,
     {$ifdef state_tracking}
        nstate,
@@ -2641,6 +2641,10 @@ implementation
                end;
            end;
 
+         { PT(@v)^ that only reads v's bits does not need v in memory; before
+           the inline info is copied }
+         resolve_pending_bitcasts(code);
+
          if (po_inline in procdef.procoptions) and
            { Can we inline this procedure? }
            checknodeinlining(procdef) then
diff --git a/tests/test/opt/tbitcast1.pp b/tests/test/opt/tbitcast1.pp
new file mode 100644
index 00000000..4c8c0a22
--- /dev/null
+++ b/tests/test/opt/tbitcast1.pp
@@ -0,0 +1,114 @@
+{ %OPT=-O2 }
+{ reading a variable's bits through PT(@v)^ without forcing v into memory
+  (optbitcast), and the uses that still need the address }
+program tbitcast1;
+
+{$mode objfpc}
+
+var
+  errors: longint = 0;
+
+procedure check(ok: boolean; const what: string);
+begin
+  if not ok then
+    begin
+      writeln('failed: ', what);
+      inc(errors);
+    end;
+end;
+
+function bits(d: double): int64; inline;
+begin
+  result := PInt64(@d)^;
+end;
+
+function isnegzero(const d: double): boolean; inline;
+begin
+  result := (d = 0) and (PInt64(@d)^ < 0);
+end;
+
+function ubits(d: double): qword;
+begin
+  result := PQWord(@d)^;
+end;
+
+function frombits(i: int64): double;
+begin
+  result := PDouble(@i)^;
+end;
+
+function sbits(s: single): longint;
+begin
+  sbits := PLongint(@s)^;
+end;
+
+function fromsbits(l: longint): single;
+begin
+  fromsbits := PSingle(@l)^;
+end;
+
+{ written through the pattern: d must stay in memory }
+function writethrough(d: double): double;
+begin
+  PInt64(@d)^ := PInt64(@d)^ xor int64($8000000000000000);
+  result := d;
+end;
+
+procedure incit(var x: int64);
+begin
+  inc(x);
+end;
+
+{ the pattern as a var argument and in inc }
+function varuse(d: double): double;
+begin
+  incit(PInt64(@d)^);
+  inc(PInt64(@d)^);
+  result := d;
+end;
+
+{ the address of the pattern }
+function addrofit(d: double): int64;
+var
+  p: pint64;
+begin
+  p := @PInt64(@d)^;
+  p^ := p^ + 1;
+  result := PInt64(@d)^;
+end;
+
+function loopsum(n: longint): int64;
+var
+  i: longint;
+  d: double;
+begin
+  result := 0;
+  for i := 1 to n do
+    begin
+      d := i * 0.5;
+      result := result + (PInt64(@d)^ shr 52);
+    end;
+end;
+
+var
+  d, z: double;
+begin
+  d := 1.0;
+  check(bits(d) = $3FF0000000000000, 'bits');
+  check(ubits(-2.0) = qword($C000000000000000), 'ubits');
+  check(frombits($4008000000000000) = 3.0, 'frombits');
+  check(sbits(1.0) = $3F800000, 'sbits');
+  check(fromsbits($40000000) = 2.0, 'fromsbits');
+  z := 0.0;
+  z := -z;
+  check(isnegzero(z) and not isnegzero(0.0) and not isnegzero(1.0), 'isnegzero');
+  check(writethrough(1.5) = -1.5, 'writethrough');
+  check(PInt64(@d)^ = $3FF0000000000000, 'main');
+  check(bits(varuse(1.0)) = $3FF0000000000002, 'varuse');
+  check(addrofit(1.0) = $3FF0000000000001, 'addrofit');
+  { exponents of 0.5 .. 5.0 }
+  check(loopsum(10) = 1022 + 1023 * 2 + 1024 * 4 + 1025 * 3, 'loopsum');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
