+    function cold_forbidden(var n: tnode; arg: pointer): foreachnoderesult;
+      begin
+        { an internal label (the address of a raise statement) is not a
+          jump target from outside }
+        if (n.nodetype in [exitn,breakn,continuen,goton]) or
+           ((n.nodetype=labeln) and not(nf_internal in n.flags)) then
+          result:=fen_norecurse_true
+        else
+          result:=fen_false;
+      end;
+
+
+    { a branch that ends in a call that never returns (raise, halt) and
+      cannot jump elsewhere: it can be placed after the body, so that its
+      code does not lie between the hot parts of the routine (which would
+      lengthen the live ranges of the register allocator across its calls) }
+    function is_cold_branch(n: tnode): boolean;
+      var
+        last: tnode;
+      begin
+        result:=false;
+        if not assigned(n) or
+           not(cs_opt_level2 in current_settings.optimizerswitches) or
+           (cs_opt_size in current_settings.optimizerswitches) then
+          exit;
+{$ifdef x86_64}
+        { exception scopes are address ranges with SEH and DWARF based
+          exception handling; the setjmp based one does not care }
+        if (target_info.system=system_x86_64_win64) or
+           (tf_use_psabieh in target_info.flags) then
+          exit;
+{$else x86_64}
+        exit;
+{$endif x86_64}
+        last:=n;
+        repeat
+          case last.nodetype of
+            blockn:
+              last:=tblocknode(last).left;
+            statementn:
+              begin
+                while assigned(tstatementnode(last).right) do
+                  last:=tstatementnode(last).right;
+                last:=tstatementnode(last).left;
+              end;
+            else
+              break;
+          end;
+        until not assigned(last);
+        if not assigned(last) or
+           (last.nodetype<>calln) or
+           not(cnf_call_never_returns in tcallnode(last).callnodeflags) then
+          exit;
+        result:=not foreachnodestatic(n,@cold_forbidden,nil);
+      end;
+
