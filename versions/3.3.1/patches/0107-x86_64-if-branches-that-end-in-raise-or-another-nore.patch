diff --git a/tests/test/opt/tcoldraise1.pp b/tests/test/opt/tcoldraise1.pp
new file mode 100644
index 00000000..9aecaff3
--- /dev/null
+++ b/tests/test/opt/tcoldraise1.pp
@@ -0,0 +1,149 @@
+{ %OPT=-O3 }
+{ if branches that end in raise are placed out of line (after the routine's
+  code): values live around them, values used in them, exceptions caught in
+  the same routine, finally blocks, loops }
+program tcoldraise1;
+
+{$mode objfpc}
+
+uses
+  sysutils;
+
+type
+  EMine = class(Exception)
+    v: int64;
+  end;
+
+var
+  errors: longint = 0;
+
+procedure check(got, expected: int64; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+function mine(v: int64): EMine;
+begin
+  result := EMine.Create('mine');
+  result.v := v;
+end;
+
+{ then branch raises, many values live across it }
+function sum(n: longint): int64;
+var
+  i: longint;
+  a, b, c, d: int64;
+begin
+  a := 1; b := 2; c := 3; d := 4;
+  for i := 1 to n do
+    begin
+      if i > 1000000 then
+        raise mine(a + b + c + d);
+      a := a + b; b := b xor i; c := c + a * 3; d := d - c + i;
+    end;
+  result := a + b * 3 + c * 5 + d * 7;
+end;
+
+function sumw(n: longint): int64;
+var
+  i: longint;
+  a, b, c, d: int64;
+begin
+  a := 1; b := 2; c := 3; d := 4;
+  i := 1;
+  while i <= n do
+    begin
+      a := a + b; b := b xor i; c := c + a * 3; d := d - c + i;
+      inc(i);
+    end;
+  result := a + b * 3 + c * 5 + d * 7;
+end;
+
+{ else branch raises, the exception carries values computed in the loop }
+function find(n, stop: longint): int64;
+var
+  i: longint;
+  acc: int64;
+begin
+  acc := 0;
+  result := -1;
+  try
+    for i := 1 to n do
+      begin
+        acc := acc + i * i;
+        if i <> stop then
+          inc(acc)
+        else
+          raise mine(acc * 10 + i);
+      end;
+    result := acc;
+  except
+    on e: EMine do
+      result := e.v;
+  end;
+end;
+
+{ nested: the inner if raises, the outer continues }
+function nested(a, b: longint): longint;
+begin
+  result := 0;
+  if a > 0 then
+    begin
+      if b < 0 then
+        raise mine(a);
+      result := a + b;
+    end
+  else
+    result := -a;
+end;
+
+{ finally runs when the out of line branch raises }
+function withfinally(a: longint; var log: longint): longint;
+begin
+  result := 0;
+  try
+    if a = 3 then
+      raise mine(a);
+    result := a * 2;
+  finally
+    log := log * 10 + a;
+  end;
+end;
+
+var
+  i, log: longint;
+  r: int64;
+begin
+  for i := 0 to 50 do
+    check(sum(i), sumw(i), 'sum');
+  check(find(10, 20), 395, 'find no raise');
+  check(find(10, 4), 33 * 10 + 4, 'find raise');
+  check(nested(3, 4), 7, 'nested');
+  check(nested(-3, 4), 3, 'nested else');
+  r := 0;
+  try
+    nested(5, -1);
+  except
+    on e: EMine do
+      r := e.v;
+  end;
+  check(r, 5, 'nested raise');
+  log := 0;
+  r := 0;
+  for i := 1 to 4 do
+    try
+      r := r + withfinally(i, log);
+    except
+      on e: EMine do
+        r := r + 100 * e.v;
+    end;
+  check(r, 2 + 4 + 300 + 8, 'finally result');
+  check(log, 1234, 'finally log');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
