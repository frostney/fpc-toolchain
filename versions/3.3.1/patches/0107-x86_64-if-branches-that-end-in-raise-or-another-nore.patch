+                          cg.add_reg_instruction(hp,ref^.base);
+                        if ref^.index<>NR_NO then
+                          cg.add_reg_instruction(hp,ref^.index);
+                      end;
+                    else
+                      ;
+                  end;
+            hp:=tai(hp.next);
+          end;
+        cg.executionweight:=oldweight;
+      end;
+{$endif x86_64}
