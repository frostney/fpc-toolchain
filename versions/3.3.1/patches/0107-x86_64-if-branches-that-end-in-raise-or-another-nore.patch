+{$ifdef x86_64}
+    procedure register_cold_code(list: TAsmList);
+      var
+        hp: tai;
+        i: longint;
+        oldweight: longint;
+      begin
+        oldweight:=cg.executionweight;
+        cg.executionweight:=0;
+        hp:=tai(list.first);
+        while assigned(hp) do
