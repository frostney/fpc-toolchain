diff --git a/tests/test/opt/tloopinv1.pp b/tests/test/opt/tloopinv1.pp
new file mode 100644
index 00000000..7653d5e3
--- /dev/null
+++ b/tests/test/opt/tloopinv1.pp
@@ -0,0 +1,85 @@
+{ %OPT=-O3 }
+{ loop invariant integer expressions (optloop.optimize_loop_invariants) }
+program tloopinv1;
+
+{$mode objfpc}
+
+var
+  errors: longint = 0;
+
+procedure check(ok: boolean; const what: string);
+begin
+  if not ok then
+    begin
+      writeln('failed: ', what);
+      inc(errors);
+    end;
+end;
+
+{ int64(i) as an index and in arithmetic, i a 16 bit counter }
+procedure accum(var a: array of int64; n: smallint);
+var
+  i, j: smallint;
+begin
+  for i := 0 to high(a) do
+    begin
+      a[i] := 0;
+      for j := 0 to n - 1 do
+        a[i] := a[i] + (i + j) * (i + 1);
+    end;
+end;
+
+{ k changes in the outer loop only; the inner loop may run zero times }
+function inner(n: longint): int64;
+var
+  k, i: longint;
+  b: array[0..15] of int64;
+begin
+  result := 0;
+  for i := 0 to 15 do
+    b[i] := i;
+  for k := 0 to n do
+    for i := 0 to k - 1 do
+      result := result + b[(k * 3 + 1) and 15] + i;
+end;
+
+{ x is written in the loop: (x + 1) must not be hoisted }
+function written(n: longint): int64;
+var
+  x, i: longint;
+begin
+  x := 1;
+  result := 0;
+  for i := 1 to n do
+    begin
+      result := result + (x + 1) * 2;
+      x := x * 2 mod 1000;
+    end;
+end;
+
+var
+  a: array[0..2] of int64;
+  r: int64;
+  i, k: longint;
+  x: longint;
+begin
+  accum(a, 4);
+  { a[i] = (i+1) * sum_j (i+j), j = 0..3 = (i+1) * (4*i + 6) }
+  check((a[0] = 6) and (a[1] = 20) and (a[2] = 42), 'accum');
+  r := 0;
+  for k := 0 to 5 do
+    for i := 0 to k - 1 do
+      r := r + ((k * 3 + 1) and 15) + i;
+  check(inner(5) = r, 'inner');
+  check(inner(-1) = 0, 'inner zero trip');
+  r := 0; x := 1;
+  for i := 1 to 10 do
+    begin
+      r := r + (x + 1) * 2;
+      x := x * 2 mod 1000;
+    end;
+  check(written(10) = r, 'written');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
