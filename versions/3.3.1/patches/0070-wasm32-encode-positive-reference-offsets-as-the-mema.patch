-                  list.Concat(taicpu.op_const(a_i32_const,ref.offset));
-                  incstack(list,1);
-                  list.Concat(taicpu.op_none(a_i32_add));
-                  decstack(list,1);
                 end;
               if dup then
                 begin
@@ -1366,16 +1348,19 @@ implementation
                       incstack(list,1);
                       list.Concat(taicpu.op_none(a_i32_sub));
                       decstack(list,1);
-                    end
-                  else if ref.offset>0 then
-                    begin
-                      list.Concat(taicpu.op_const(a_i32_const,ref.offset));
