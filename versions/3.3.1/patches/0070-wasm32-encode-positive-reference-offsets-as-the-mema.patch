diff --git a/compiler/wasm32/nwasmmem.pas b/compiler/wasm32/nwasmmem.pas
index 380e92c0..9f69d309 100644
--- a/compiler/wasm32/nwasmmem.pas
+++ b/compiler/wasm32/nwasmmem.pas
@@ -25,6 +25,8 @@ unit nwasmmem;
 interface
 
     uses
+      globtype,cgbase,
+      symtype,
       node,nmem,ncgmem;
 
     type
@@ -35,11 +37,20 @@ interface
         function pass_typecheck:tnode;override;
       end;
 
+      { twasmvecnode }
+
+      twasmvecnode = class(tcgvecnode)
+      protected
+        procedure update_reference_reg_mul(maybe_const_reg: tregister; regsize: tdef; l: aint); override;
+      end;
+
 implementation
 
     uses
       globals,
       verbose,
+      aasmdata,
+      cgutils,hlcgobj,
       symcpu;
 
     { twasmaddrnode }
@@ -58,6 +69,33 @@ implementation
         end;
     end;
 
+    { twasmvecnode }
+
+    procedure twasmvecnode.update_reference_reg_mul(maybe_const_reg: tregister; regsize: tdef; l: aint);
+      var
+        hreg: tregister;
+      begin
+        inherited;
+        { The generic code leaves the parts of the element address that do not
+          depend on the index in the reference's offset: the array's own
+          offset, minus the lower bound and plus a constant added to the
+          index ("a[i+5]") times the element size. thlcgwasm encodes a
+          positive offset as the memarg offset of the load or store, which
+          the engine adds without wrapping, while base+index alone can be
+          below the array (a negative lower bound, i+5 with i<0), i.e. below
+          address 0. Add such an offset now, so that the reference addresses
+          the element itself; offsets added later (fields, the parts of a
+          record copy) are then always relative to a valid address. }
+        if location.reference.offset>0 then
+          begin
+            hreg:=hlcg.getaddressregister(current_asmdata.CurrAsmList,get_address_type);
+            hlcg.a_loadaddr_ref_reg(current_asmdata.CurrAsmList,resultdef,get_address_type,location.reference,hreg);
+            reference_reset_base(location.reference,hreg,0,location.reference.temppos,location.reference.alignment,location.reference.volatility);
+          end;
+      end;
+
+
 begin
   caddrnode:=twasmaddrnode;
+  cvecnode:=twasmvecnode;
 end.
diff --git a/tests/test/cg/tarrlow1.pp b/tests/test/cg/tarrlow1.pp
new file mode 100644
index 00000000..607ee64b
--- /dev/null
+++ b/tests/test/cg/tarrlow1.pp
@@ -0,0 +1,28 @@
+program tarrlow1;
+
+{ arrays with a negative lower bound and constants added to the index: the
+  element address must not depend on base+index staying above address 0 }
+{$mode objfpc}
+type TR = record a, b: Int64; end;
+var
+  g: array[-1000000..10] of Integer;
+  gs: array[-3..3] of TR;
+  fails: Integer = 0;
+procedure chk(ok: Boolean; const w: string); begin if not ok then begin writeln('FAIL ', w); inc(fails); end; end;
+procedure t(i, j, m: Integer);
+var l: array[-50000..5] of Byte; r: TR; k: Integer; p: ^TR;
+begin
+  g[i] := 7; chk(g[-1000000] = 7, 'g low');
+  g[j + 999999] := 9; chk(g[-1] = 9, 'g i+c');
+  l[i div 20] := 5; chk(l[-50000] = 5, 'local low');
+  gs[m].a := 11; gs[m].b := 12; r := gs[m]; chk((r.a = 11) and (r.b = 12), 'rec copy');
+  p := @gs[-3]; inc(p, 6); p^.b := 77; chk(gs[3].b = 77, 'ptr');
+  for k := -3 to 3 do gs[k].a := k;
+  chk(gs[-3].a + gs[3].a = 0, 'loop');
+  chk(gs[m+3].b = 77, 'm+3');
+end;
+begin
+  t(-1000000, -1000000, 0);
+  if fails <> 0 then halt(1);
+  writeln('ok');
+end.
