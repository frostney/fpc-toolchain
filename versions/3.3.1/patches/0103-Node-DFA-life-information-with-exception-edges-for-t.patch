+{ the dfa tracks the value of the variable as a whole: a write is a
+  definition of all of it }
+function dfa_tracks_whole_value(vs: tabstractnormalvarsym): boolean;
+  var
+    i,fields: longint;
+    sym: tsym;
+    fielddef: tdef;
+  begin
+    result:=false;
+    if (vs.varoptions*[vo_is_funcret,vo_is_result,vo_is_self,vo_is_high_para,vo_is_parentfp])<>[] then
+      exit;
+    if (vs.typ=paravarsym) and
+       paramanager.push_addr_param(vs.varspez,vs.vardef,current_procinfo.procdef.proccalloption) then
+      exit;
+    if (vs.vardef.typ in [orddef,floatdef,pointerdef,enumdef,classrefdef]) or
+       is_implicit_pointer_object_type(vs.vardef) then
+      exit(true);
+    { a record with a single field of a scalar type that fills it: a write
+      of the field writes the whole record }
+    if (vs.vardef.typ=recorddef) and
+       not trecorddef(vs.vardef).isunion then
+      begin
+        fields:=0;
+        fielddef:=nil;
+        for i:=0 to trecorddef(vs.vardef).symtable.SymList.Count-1 do
+          begin
+            sym:=tsym(trecorddef(vs.vardef).symtable.SymList[i]);
+            if (sym.typ=fieldvarsym) and
+               not(sp_static in sym.symoptions) then
+              begin
+                inc(fields);
+                fielddef:=tfieldvarsym(sym).vardef;
+              end;
+          end;
+        result:=(fields=1) and
+          (fielddef.typ in [orddef,floatdef,pointerdef,enumdef]) and
+          (fielddef.size=vs.vardef.size);
+      end;
+  end;
+
+
+function find_dfaindex(var n: tnode; arg: pointer): foreachnoderesult;
+  var
+    info: pexcregvarinfo absolute arg;
+    i: longint;
+  begin
+    result:=fen_false;
+    if (n.nodetype=loadn) and
+       assigned(n.optinfo) and
+       (tloadnode(n).symtableentry.typ in [localvarsym,paravarsym]) then
+      begin
+        i:=info^.cands.IndexOf(tloadnode(n).symtableentry);
+        if (i>=0) and (info^.dfaindex[i]=-2) then
+          info^.dfaindex[i]:=n.optinfo^.index;
+      end;
+  end;
+
+
+{ the life information where an exception raised in the protected block of
+  the try node t continues, nil if there is none }
+function handler_life(t: tnode; out life: tdfaset): boolean;
+  var
+    r: tnode;
+  begin
+    result:=false;
+    life:=nil;
+    if not current_procinfo.excdfaavailable then
+      exit;
+    r:=tbinarynode(t).left;
+    if not assigned(r) or
+       not assigned(r.optinfo) or
+       not assigned(r.optinfo^.excsucc) or
+       not assigned(tnode(r.optinfo^.excsucc).optinfo) then
+      exit;
+    life:=tnode(r.optinfo^.excsucc).optinfo^.life;
+    result:=true;
+  end;
+
