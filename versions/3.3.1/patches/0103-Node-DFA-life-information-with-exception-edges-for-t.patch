diff --git a/tests/test/texcregvar3.pp b/tests/test/texcregvar3.pp
new file mode 100644
index 00000000..115435c4
--- /dev/null
+++ b/tests/test/texcregvar3.pp
@@ -0,0 +1,321 @@
+{ %OPT=-O3 }
+{ register variables in procedures with try..except/finally, decided with
+  node dfa life information with exception edges: a variable written in the
+  protected block is in a register only when it is dead where an exception
+  raised in the block continues. Every function returns what the program
+  computes without any register variables. }
+program texcregvar3;
+
+{$mode objfpc}
+
+uses
+  sysutils;
+
+type
+  TOne = record
+    v: longint;
+  end;
+  EOther = class(Exception);
+
+var
+  errors: longint = 0;
+  zero: longint = 0;
+
+procedure check(got, expected: int64; const what: string);
+begin
+  if got <> expected then
+    begin
+      writeln(what, ': got ', got, ', expected ', expected);
+      inc(errors);
+    end;
+end;
+
+procedure boom(i: longint);
+begin
+  if i >= 0 then
+    raise Exception.Create('boom');
+end;
+
+procedure boomother(i: longint);
+begin
+  if i >= 0 then
+    raise EOther.Create('other');
+end;
+
+{ the handler exits: the value read after the try statement comes from the
+  normal path only }
+function handlerexits(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  i := 0;
+  while i < n do
+    try
+      x := x + i;
+      inc(i);
+      if i = n + zero + 100 then
+        boom(0);
+    except
+      result := -1;
+      exit;
+    end;
+  result := x * 10 + i;
+end;
+
+{ the same, the exception is raised: the handler's value }
+function handlerexits2(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  i := 0;
+  while i < n do
+    try
+      x := x + i;
+      inc(i);
+      if i = 3 then
+        boom(0);
+    except
+      result := -1000 - i;
+      exit;
+    end;
+  result := x;
+end;
+
+{ the handler falls through to code that reads the value }
+function fallthrough(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  try
+    for i := 1 to n do
+      begin
+        x := x + i;
+        if i = 4 then
+          boom(0);
+      end;
+  except
+    inc(zero, 0);
+  end;
+  result := x;
+end;
+
+{ loop re-entered after a swallowed exception: the protected block reads
+  the value written before the exception }
+function reentry(n: longint): int64;
+var
+  acc, k: int64;
+  i: longint;
+begin
+  acc := 0;
+  k := 1;
+  for i := 1 to n do
+    try
+      acc := acc + k;
+      k := k + 1;
+      if i mod 2 = 0 then
+        boom(i);
+      k := k * 2;
+    except
+    end;
+  result := acc * 1000 + k;
+end;
+
+{ the handler writes the variable before it reads it: dead at the handler }
+function handlerwrites(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 5;
+  try
+    for i := 1 to n do
+      x := x * 2;
+    boom(0);
+  except
+    x := 7;
+    x := x + 1;
+  end;
+  result := x;
+end;
+
+{ only one of the on handlers reads it; another exception class is raised }
+function onchain(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  result := 0;
+  try
+    for i := 1 to n do
+      x := x + i * i;
+    boomother(0);
+  except
+    on E: EOther do
+      result := x;
+    on E: Exception do
+      result := -1;
+  end;
+end;
+
+{ no handler matches in the inner statement; the outer one reads it }
+function reraised(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  result := 0;
+  try
+    try
+      for i := 1 to n do
+        x := x + 3;
+      boom(0);
+    except
+      on E: EOther do
+        result := -1;
+    end;
+  except
+    result := x;
+  end;
+end;
+
+{ the finally block reads it }
+function infinally(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  result := 0;
+  try
+    try
+      for i := 1 to n do
+        x := x + i;
+      boom(0);
+    finally
+      result := x;
+    end;
+  except
+    result := result * 2;
+  end;
+end;
+
+{ exit and break through a finally block that reads it }
+function exitfinally(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  result := 0;
+  try
+    for i := 1 to n do
+      begin
+        x := x + i;
+        if i = 5 then
+          exit;
+      end;
+  finally
+    result := x;
+  end;
+  result := -1;
+end;
+
+function breakfinally(n: longint): int64;
+var
+  x, y: int64;
+  i: longint;
+begin
+  x := 0;
+  y := 0;
+  for i := 1 to n do
+    try
+      x := x + i;
+      if i = 6 then
+        break;
+    finally
+      y := y + x;
+    end;
+  result := y * 100 + x;
+end;
+
+{ a record with one field, read in the handler and after the try }
+function onefield(n: longint): int64;
+var
+  r: TOne;
+  i: longint;
+begin
+  r.v := 0;
+  try
+    for i := 1 to n do
+      begin
+        r.v := r.v + i;
+        if i = 5 then
+          boom(0);
+      end;
+  except
+    r.v := r.v * 10;
+  end;
+  result := r.v;
+end;
+
+{ ... and with a handler that exits }
+function onefieldexit(n: longint): int64;
+var
+  r: TOne;
+begin
+  r.v := 0;
+  while r.v < n do
+    try
+      r.v := r.v + 1;
+      if r.v = n + 50 + zero then
+        boom(0);
+    except
+      exit(-1);
+    end;
+  result := r.v;
+end;
+
+{ a hardware exception (integer division by zero) after the write }
+function divzero(n: longint): int64;
+var
+  x: int64;
+  i: longint;
+begin
+  x := 0;
+  try
+    for i := 1 to n do
+      x := x + i;
+    x := x + (n div zero);
+  except
+    on E: EDivByZero do
+      x := x + 1000;
+  end;
+  result := x;
+end;
+
+begin
+  check(handlerexits(10), 450 + 10, 'handlerexits');
+  check(handlerexits2(10), -1003, 'handlerexits2');
+  check(fallthrough(10), 10, 'fallthrough');
+  check(reentry(6), 63 * 1000 + 29, 'reentry');
+  check(handlerwrites(4), 8, 'handlerwrites');
+  check(onchain(4), 30, 'onchain');
+  check(reraised(4), 12, 'reraised');
+  check(infinally(4), 20, 'infinally');
+  check(exitfinally(10), 15, 'exitfinally');
+  check(breakfinally(10), 56 * 100 + 21, 'breakfinally');
+  check(onefield(10), 150, 'onefield');
+  check(onefieldexit(20), 20, 'onefieldexit');
+  check(divzero(10), 1055, 'divzero');
+  if errors <> 0 then
+    halt(1);
+  writeln('ok');
+end.
